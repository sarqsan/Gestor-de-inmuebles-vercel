# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IA_POLITICA_JSON: política de gobierno de uso de IA (permisos, costes en
# créditos y cuotas). Opcional: sin ella rige la política POR DEFECTO
# (todo permitido, coste 0, sin cuotas) con el consumo BLOQUEADO por
# aprobación comercial pendiente. Para activar el consumo se exige una
# política válida CON tarifas definidas; si el JSON no valida, todas las
# operaciones de IA responden 503 POLITICA_IA_INVALIDA.
# Ejemplo de estructura (valores reales pendientes de aprobación comercial):
# IA_POLITICA_JSON='{"permisos":{"PROPIETARIO":"*"},"costeCreditosPorOperacion":{"ESTIMAR_PRICING":1},"cuotas":{"operacionesPorDia":50,"operacionesPorMes":1000}}'
