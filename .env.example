# GEMINI_API_KEY: clave COMPARTIDA histórica del proveedor. Desde la FASE IA 9
# (Vía 2: clave propia de cada usuario) YA NO se usa para operaciones de usuario;
# sólo se informa en /api/health (geminiKeyConfigured) por compatibilidad.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IA_LLAVES_CLAVE_MAESTRA (FASE 9): clave maestra (32 bytes en base64) con la que
# el servidor cifra en reposo (AES-256-GCM) la clave del proveedor que cada
# usuario registra en «Configuración → Llave de IA». Genera una con:
#   npm run ia:llaves:clave-maestra
# y verifica la configurada con:  npm run ia:llaves:clave-maestra -- --verificar
# Sin la variable el subsistema queda NO_CONFIGURADO (nadie registra llaves y no
# se crea el cliente del proveedor). Si existe y no es válida, el servidor bloquea
# las operaciones de IA (503 LLAVES_CLAVE_MAESTRA_INVALIDA, fallo cerrado).
# NUNCA la commitees ni la compartas. Cambiarla invalida las llaves ya cifradas.
# IA_LLAVES_CLAVE_MAESTRA=

# IA_LLAVES_SIN_LLAVE (FASE 9): qué hace el núcleo cuando el usuario no tiene
# llave propia. RESPALDO (por defecto) = el endpoint responde con su respaldo
# heurístico, sin consumo; EXIGIR = 428 LLAVE_USUARIO_REQUERIDA remitiendo al
# alta guiada, sin gastar clave de idempotencia, cuota ni saldo.
# IA_LLAVES_SIN_LLAVE=RESPALDO

# IA_LLAVES_VERIFICACION (FASE 9): PROVEEDOR activa POST /api/ia/llave/verificar
# (llamada REAL models.list con la llave del usuario; sin tokens de generación).
# Por defecto DESACTIVADA (503 VERIFICACION_NO_DISPONIBLE): exige autorización
# expresa, como cualquier contacto con el proveedor real.
# IA_LLAVES_VERIFICACION=DESACTIVADA

# FASE A — AVISOS REALES (2026-10-16) =========================================
# EMAIL_PROVEEDOR: proveedor de correo REAL del canal EMAIL.
#   · SMTP   → usa SMTP_URL (Gmail u otro servidor). RECOMENDADO para empezar.
#   · RESEND / SENDGRID → API HTTP con su clave.
# Sin proveedor válido + EMAIL_FROM, el canal queda en MODO SEGURO: no contacta
# con nadie y NUNCA devuelve «enviado» (fallo controlado visible).
# `ENABLE_EMAIL=true` por sí solo ya NO simula envíos.
# EMAIL_PROVEEDOR=SMTP

# SMTP_URL (Gmail): la cuenta necesita VERIFICACIÓN EN DOS PASOS y una
# CONTRASEÑA DE APLICACIÓN de 16 caracteres (sin espacios al pegarla aquí).
# Codifica la @ del usuario como %40. La contraseña se puede revocar en
# https://myaccount.google.com/apppasswords y nunca se guarda en Firestore.
# Guía completa paso a paso: docs/FASE-A-PUESTA-EN-MARCHA-AVISOS.md
# SMTP_URL="smtps://despacho%40gmail.com:CLAVE_DE_APLICACION@smtp.gmail.com:465"
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM="Gestor de Inmuebles <despacho@gmail.com>"

# EMAIL_DESPACHO_NOMBRE / EMAIL_REPLY_TO: identidad que firma los avisos. El
# nombre aparece en el texto («Le escribimos desde …») y EMAIL_REPLY_TO es la
# dirección a la que RESPONDEN los avisos que no van dirigidos a un propietario
# (los del inquilino responden al propietario). OJO: no cambian el remitente —
# el correo sale siempre del buzón autenticado (Gmail exige que el «De» sea la
# cuenta o un alias suyo; enviar «desde» el buzón de un tercero exigiría su
# contraseña). Si no se definen, se deducen de EMAIL_FROM.
# EMAIL_DESPACHO_NOMBRE="Gestor de Inmuebles"
# EMAIL_REPLY_TO="despacho@gmail.com"

# CRON_SECRET: secreto que protege GET /api/cron/avisos (reloj diario de la
# regla del día 5 y reintentos). Vercel Cron lo envía como
# `Authorization: Bearer $CRON_SECRET`. Sin esta variable el endpoint responde
# 503 y NO ejecuta nada (fallo cerrado). Genera uno con:
#   openssl rand -hex 32
# CRON_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL="MY_APP_URL"

# IA_POLITICA_JSON: política de gobierno de uso de IA (FASE 7). TODO O NADA:
# permisos EXPLÍCITOS de los cuatro perfiles (sin comodines '*' ni herencias),
# tarifa declarada de las 12 operaciones del catálogo (sin tarifas implícitas)
# y cuotas FINITAS de día y mes (sin null/ilimitadas).
# Sin la variable rige la política POR DEFECTO, que DENIEGA todas las
# operaciones y mantiene el consumo BLOQUEADO (503
# APROBACION_COMERCIAL_PENDIENTE). Si el JSON no valida (comodines, perfiles o
# tarifas sin declarar, cuotas ilimitadas), todas las operaciones de IA
# responden 503 POLITICA_IA_INVALIDA.
# La plantilla aprobada y comentada está en docs/politica-ia.ejemplo.json y se
# verifica con:  npm run ia:verificar-politica
# IA_POLITICA_JSON='{"permisos":{"PROPIETARIO":["ESTIMAR_PRICING","ASISTENTE_INTERPRETAR"],"PROFESIONAL":["ANALIZAR_INSPECCION","ASISTENTE_INTERPRETAR"],"INQUILINO":["ASISTENTE_INCIDENCIAS_INQUILINO","ASISTENTE_INTERPRETAR"],"ADMINISTRADOR":["ANALIZAR_DOCUMENTO","GENERAR_CORREO_ASEGURADORA","ANALIZAR_RESPUESTA_ASEGURADORA","ASISTENTE_INTERPRETAR","ANALIZAR_CUESTIONARIO","REDACTAR_CLAUSULA","ANALIZAR_INSPECCION","PROPONER_MEJORAS","ESTIMAR_PRICING","GENERAR_KIT_PUBLICACION","ANALIZAR_INCIDENCIA","ASISTENTE_INCIDENCIAS_INQUILINO"]},"costeCreditosPorOperacion":{"ANALIZAR_DOCUMENTO":2,"GENERAR_CORREO_ASEGURADORA":1,"ANALIZAR_RESPUESTA_ASEGURADORA":1,"ASISTENTE_INTERPRETAR":1,"ANALIZAR_CUESTIONARIO":2,"REDACTAR_CLAUSULA":2,"ANALIZAR_INSPECCION":3,"PROPONER_MEJORAS":2,"ESTIMAR_PRICING":2,"GENERAR_KIT_PUBLICACION":2,"ANALIZAR_INCIDENCIA":2,"ASISTENTE_INCIDENCIAS_INQUILINO":2},"cuotas":{"operacionesPorDia":20,"operacionesPorMes":200}}'

# ===========================================================================
# P0.1 — CONFIGURACIÓN VERIFICABLE (2026-10-27)
# ===========================================================================
# Este fichero es DOCUMENTACIÓN. Todas las líneas de abajo están comentadas:
# copia a `.env` (o al panel del proveedor) y sustituye los marcadores. NUNCA
# versiones un valor real. Mapa completo: docs/CONFIGURACION-VERIFICABLE.md.
# Comprueba el estado con:  npm run doctor
# ===========================================================================

# ENABLE_EMAIL: interruptor histórico. Por sí solo NO habilita envíos reales;
# se exige además EMAIL_PROVEEDOR + credenciales + EMAIL_FROM válidos.
# ENABLE_EMAIL=false

# --- Identidad y credencial de servicio del BACKEND -------------------------
# FIREBASE_SERVICE_ACCOUNT: JSON completo de la cuenta de servicio (una línea).
# Sin credencial, el backend no crea cliente de Firestore/Storage y las rutas
# dependientes responden 503. NUNCA en el repositorio.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
# FIREBASE_SERVICE_ACCOUNT_B64=<JSON anterior codificado en base64; excluyente>
# FIREBASE_SERVICE_ACCOUNT_PATH=/ruta/local/o/en/CI/cuenta-servicio.json
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/credenciales-adc.json
#
# FIREBASE_PROJECT_ID y FIRESTORE_DATABASE_ID son CONFIRMATORIOS: no seleccionan
# el destino (lo fija firebase-applet-config.json). Si difieren, el backend
# responde FIREBASE_OVERRIDE_INCOMPATIBLE y no crea ningún cliente.
# FIREBASE_PROJECT_ID=gestor-inmuebles-produccion
# FIRESTORE_DATABASE_ID=ai-studio-gestordeinmueble-c6444afd-24ca-4983-b195-ceb2c5ebdc51
#
# AVISO: NO existe staging. El proyecto anterior ES PRODUCCIÓN. Para cualquier
# prueba con datos usa emuladores (demo-gestor-reglas), nunca estas credenciales.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GCLOUD_PROJECT=demo-gestor-reglas

# MASTER_ADMIN_EMAIL: override SOLO del SERVIDOR sobre el correo maestro.
# Si se cambia, las firestore.rules SIGUEN usando el literal de
# src/lib/masterAdmin.ts: hay que desplegar custom claims (decisión P-04).
# MASTER_ADMIN_EMAIL=

# SEGUIMIENTO_ADMIN_USUARIO_ID: usuario destino de los avisos internos del
# seguimiento de incidencias. Sin él se usa el destino por defecto.
# SEGUIMIENTO_ADMIN_USUARIO_ID=

# TZ: zona horaria del reloj de avisos (recomendado Europe/Madrid).
# TZ=Europe/Madrid

# --- Banderas del CLIENTE (VITE_*: PÚBLICAS, se compilan en el bundle) -------
# AMBAS desactivadas por defecto. Activar SOLO en demostraciones locales:
# VITE_SEEDS_ENABLED permite ESCRIBIR semillas en Firestore en el login admin;
# VITE_DEMO_DATA permite MOSTRAR datos de demostración antes del primer snapshot.
# VITE_SEEDS_ENABLED=false
# VITE_DEMO_DATA=false

# VITE_MODALIDAD_SISTEMA_FACTURACION (P1.5-pre): modalidad declarada del sistema
# de facturación. PÚBLICA (se compila en el bundle); NO es un secreto y NO
# habilita ningún envío. Valores: PREPARACION (por defecto, sin remisión a la
# AEAT), NO_VERIFACTU o VERIFACTU. VERIFACTU SOLO tras dictamen fiscal P1.4 y
# con transporte AEAT verificado; un valor desconocido cae en PREPARACION.
# VITE_MODALIDAD_SISTEMA_FACTURACION=PREPARACION
