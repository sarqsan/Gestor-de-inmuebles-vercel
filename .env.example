# GEMINI_API_KEY: clave COMPARTIDA histórica del proveedor. Desde la FASE IA 9
# (Vía 2: clave propia de cada usuario) YA NO se usa para operaciones de usuario;
# sólo se informa en /api/health (geminiKeyConfigured) por compatibilidad.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IA_LLAVES_CLAVE_MAESTRA (FASE 9): clave maestra (32 bytes en base64) con la que
# el servidor cifra en reposo (AES-256-GCM) la clave del proveedor que cada
# usuario registra en «Configuración → Llave de IA». Genera una con:
#   npm run ia:llaves:clave-maestra
# y verifica la configurada con:  npm run ia:llaves:clave-maestra -- --verificar
# Sin la variable el subsistema queda NO_CONFIGURADO (nadie registra llaves y no
# se crea el cliente del proveedor). Si existe y no es válida, el servidor bloquea
# las operaciones de IA (503 LLAVES_CLAVE_MAESTRA_INVALIDA, fallo cerrado).
# NUNCA la commitees ni la compartas. Cambiarla invalida las llaves ya cifradas.
# IA_LLAVES_CLAVE_MAESTRA=

# IA_LLAVES_SIN_LLAVE (FASE 9): qué hace el núcleo cuando el usuario no tiene
# llave propia. RESPALDO (por defecto) = el endpoint responde con su respaldo
# heurístico, sin consumo; EXIGIR = 428 LLAVE_USUARIO_REQUERIDA remitiendo al
# alta guiada, sin gastar clave de idempotencia, cuota ni saldo.
# IA_LLAVES_SIN_LLAVE=RESPALDO

# IA_LLAVES_VERIFICACION (FASE 9): PROVEEDOR activa POST /api/ia/llave/verificar
# (llamada REAL models.list con la llave del usuario; sin tokens de generación).
# Por defecto DESACTIVADA (503 VERIFICACION_NO_DISPONIBLE): exige autorización
# expresa, como cualquier contacto con el proveedor real.
# IA_LLAVES_VERIFICACION=DESACTIVADA

# FASE A — AVISOS REALES (2026-10-16) =========================================
# EMAIL_PROVEEDOR: proveedor de correo REAL del canal EMAIL. Valores: RESEND o
# SENDGRID. Sin proveedor + clave + EMAIL_FROM, el canal queda en MODO SEGURO:
# no contacta con nadie y NUNCA devuelve «enviado» (fallo controlado visible).
# `ENABLE_EMAIL=true` por sí solo ya NO simula envíos.
# EMAIL_PROVEEDOR=RESEND
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM="Gestor de Inmuebles <avisos@tudominio.es>"

# CRON_SECRET: secreto que protege GET /api/cron/avisos (reloj diario de la
# regla del día 5 y reintentos). Vercel Cron lo envía como
# `Authorization: Bearer $CRON_SECRET`. Sin esta variable el endpoint responde
# 503 y NO ejecuta nada (fallo cerrado). Genera uno con:
#   openssl rand -hex 32
# CRON_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IA_POLITICA_JSON: política de gobierno de uso de IA (FASE 7). TODO O NADA:
# permisos EXPLÍCITOS de los cuatro perfiles (sin comodines '*' ni herencias),
# tarifa declarada de las 12 operaciones del catálogo (sin tarifas implícitas)
# y cuotas FINITAS de día y mes (sin null/ilimitadas).
# Sin la variable rige la política POR DEFECTO, que DENIEGA todas las
# operaciones y mantiene el consumo BLOQUEADO (503
# APROBACION_COMERCIAL_PENDIENTE). Si el JSON no valida (comodines, perfiles o
# tarifas sin declarar, cuotas ilimitadas), todas las operaciones de IA
# responden 503 POLITICA_IA_INVALIDA.
# La plantilla aprobada y comentada está en docs/politica-ia.ejemplo.json y se
# verifica con:  npm run ia:verificar-politica
# IA_POLITICA_JSON='{"permisos":{"PROPIETARIO":["ESTIMAR_PRICING","ASISTENTE_INTERPRETAR"],"PROFESIONAL":["ANALIZAR_INSPECCION","ASISTENTE_INTERPRETAR"],"INQUILINO":["ASISTENTE_INCIDENCIAS_INQUILINO","ASISTENTE_INTERPRETAR"],"ADMINISTRADOR":["ANALIZAR_DOCUMENTO","GENERAR_CORREO_ASEGURADORA","ANALIZAR_RESPUESTA_ASEGURADORA","ASISTENTE_INTERPRETAR","ANALIZAR_CUESTIONARIO","REDACTAR_CLAUSULA","ANALIZAR_INSPECCION","PROPONER_MEJORAS","ESTIMAR_PRICING","GENERAR_KIT_PUBLICACION","ANALIZAR_INCIDENCIA","ASISTENTE_INCIDENCIAS_INQUILINO"]},"costeCreditosPorOperacion":{"ANALIZAR_DOCUMENTO":2,"GENERAR_CORREO_ASEGURADORA":1,"ANALIZAR_RESPUESTA_ASEGURADORA":1,"ASISTENTE_INTERPRETAR":1,"ANALIZAR_CUESTIONARIO":2,"REDACTAR_CLAUSULA":2,"ANALIZAR_INSPECCION":3,"PROPONER_MEJORAS":2,"ESTIMAR_PRICING":2,"GENERAR_KIT_PUBLICACION":2,"ANALIZAR_INCIDENCIA":2,"ASISTENTE_INCIDENCIAS_INQUILINO":2},"cuotas":{"operacionesPorDia":20,"operacionesPorMes":200}}'
