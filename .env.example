# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IA_POLITICA_JSON: política de gobierno de uso de IA (FASE 7). TODO O NADA:
# permisos EXPLÍCITOS de los cuatro perfiles (sin comodines '*' ni herencias),
# tarifa declarada de las 12 operaciones del catálogo (sin tarifas implícitas)
# y cuotas FINITAS de día y mes (sin null/ilimitadas).
# Sin la variable rige la política POR DEFECTO, que DENIEGA todas las
# operaciones y mantiene el consumo BLOQUEADO (503
# APROBACION_COMERCIAL_PENDIENTE). Si el JSON no valida (comodines, perfiles o
# tarifas sin declarar, cuotas ilimitadas), todas las operaciones de IA
# responden 503 POLITICA_IA_INVALIDA.
# La plantilla aprobada y comentada está en docs/politica-ia.ejemplo.json y se
# verifica con:  npm run ia:verificar-politica
# IA_POLITICA_JSON='{"permisos":{"PROPIETARIO":["ESTIMAR_PRICING","ASISTENTE_INTERPRETAR"],"PROFESIONAL":["ANALIZAR_INSPECCION","ASISTENTE_INTERPRETAR"],"INQUILINO":["ASISTENTE_INCIDENCIAS_INQUILINO","ASISTENTE_INTERPRETAR"],"ADMINISTRADOR":["ANALIZAR_DOCUMENTO","GENERAR_CORREO_ASEGURADORA","ANALIZAR_RESPUESTA_ASEGURADORA","ASISTENTE_INTERPRETAR","ANALIZAR_CUESTIONARIO","REDACTAR_CLAUSULA","ANALIZAR_INSPECCION","PROPONER_MEJORAS","ESTIMAR_PRICING","GENERAR_KIT_PUBLICACION","ANALIZAR_INCIDENCIA","ASISTENTE_INCIDENCIAS_INQUILINO"]},"costeCreditosPorOperacion":{"ANALIZAR_DOCUMENTO":2,"GENERAR_CORREO_ASEGURADORA":1,"ANALIZAR_RESPUESTA_ASEGURADORA":1,"ASISTENTE_INTERPRETAR":1,"ANALIZAR_CUESTIONARIO":2,"REDACTAR_CLAUSULA":2,"ANALIZAR_INSPECCION":3,"PROPONER_MEJORAS":2,"ESTIMAR_PRICING":2,"GENERAR_KIT_PUBLICACION":2,"ANALIZAR_INCIDENCIA":2,"ASISTENTE_INCIDENCIAS_INQUILINO":2},"cuotas":{"operacionesPorDia":20,"operacionesPorMes":200}}'
