+    throw new ErrorJustificanteCobro('FECHA_INVALIDA', 400);
+  }
+  if (!METODOS.includes(entrada.metodoPagoDeclarado)) {
+    throw new ErrorJustificanteCobro('PETICION_INVALIDA', 400);
