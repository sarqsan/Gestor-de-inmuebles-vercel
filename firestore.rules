rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION PREDICATES (ZERO-BYPASS PRODUCTION)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return request.auth != null && 
             'email' in request.auth.token && 
             request.auth.token.email == 'sarqsan2@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getInmueble(inmuebleId) {
      return get(/databases/$(database)/documents/inmuebles/$(inmuebleId)).data;
    }

    // Aislamiento Real del Propietario basado en las relaciones existentes en el modelo:
    // inmueble.propietarioId, inmueble.authUid, usuario.propietarioId, usuario.inmuebleIds
    function isOwnerOfInmueble(inmuebleId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        (inmuebleId != null && exists(/databases/$(database)/documents/inmuebles/$(inmuebleId)) && (
          getInmueble(inmuebleId).authUid == request.auth.uid ||
          getInmueble(inmuebleId).propietarioId == request.auth.uid ||
          (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.propietarioId == getInmueble(inmuebleId).propietarioId ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.propietarioId == getInmueble(inmuebleId).propietarioPrincipalId ||
            inmuebleId in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.inmuebleIds
          ))
        ))
      );
    }

    // =========================================================================
    // 0. PROPIETARIOS Y CUENTAS BANCARIAS
    // =========================================================================
    match /propietarios/{propietarioId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 1. INMUEBLES & DATOS FISCALES
    // Public listings are readable for candidate application links
    // =========================================================================
    match /inmuebles/{inmuebleId} {
      // Lectura puntual para enlaces públicos de solicitud/cuestionario; listado restringido a usuarios autenticados
      allow get: if isSignedIn() || (isValidId(inmuebleId) && resource.data.estado in ['disponible', 'alquilado']);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isMasterAdmin() || (isSignedIn() && (
        resource.data.propietarioId == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.propietarioId == resource.data.propietarioId)
      ));
    }

    // =========================================================================
    // 2. CANDIDATOS (Expedientes personales y circuito de selección)
    // Aislamiento estricto: Propietario A no puede leer ni modificar candidato de Propietario B
    // Trazabilidad inmutable: no se permite truncar ni vaciar el array historial
    // =========================================================================
    match /candidatos/{candidatoId} {
      allow get: if isMasterAdmin() || (isSignedIn() && (
        resource.data.propietarioId == request.auth.uid ||
        isOwnerOfInmueble(resource.data.inmuebleId)
      ));
      allow list: if isSignedIn();
      allow create: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(incoming().inmuebleId));
      allow update: if (isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId))) && (
        // Garantía de historial inmutable: el historial entrante debe conservar o aumentar las entradas
        (!('historial' in existing()) || !('historial' in incoming()) || incoming().historial.size() >= existing().historial.size())
      );
      allow delete: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId));
    }

    // =========================================================================
    // 3. SOLICITUDES DE ALQUILER (Públicas para captación inicial de solicitantes)
    // =========================================================================
    match /solicitudes/{solicitudId} {
      allow get: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(resource.data.inmuebleId));
      allow list: if isSignedIn();
      allow create: if incoming().keys().hasAll(['nombre', 'email', 'telefono', 'inmuebleId', 'estado']) &&
                       incoming().nombre is string &&
                       incoming().email is string;
      allow update, delete: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId));
    }

    // =========================================================================
    // 4. INVITACIONES DE VISITA (Lectura por token para confirmación de reserva)
    // =========================================================================
    match /invitaciones/{invitacionId} {
      // Lectura puntual para el enlace de invitación de visita
      allow get: if isSignedIn() || (isValidId(invitacionId) && resource.data.status in ['PENDIENTE', 'CONFIRMADA', 'COMPLETADA', 'CANCELADA']);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cuestionarioCompletado', 'slotId', 'fechaVisita'])
      );
      allow delete: if isSignedIn();
    }

    // =========================================================================
    // 5. TURNOS / SLOTS DE VISITA (Lectura pública de calendario, reserva atómica)
    // =========================================================================
    match /slots_visita/{slotId} {
      // Lectura de turnos para consulta y reserva atómica
      allow get: if isSignedIn() || (isValidId(slotId) && resource.data.estado in ['DISPONIBLE', 'RESERVADO']);
      allow list: if isSignedIn() || (resource.data.estado in ['DISPONIBLE', 'RESERVADO']);
      allow create, delete: if isSignedIn();
      allow update: if isSignedIn() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['estado', 'candidateId', 'candidateNombre', 'candidateTelefono', 'candidateEmail', 'invitacionId', 'bookedAt'])
      );
    }

    // =========================================================================
    // 6. SOLICITUDES DE DOCUMENTACIÓN
    // Protegidas bajo aislamiento de propietario. El flujo público para candidatos
    // se gestiona a través del backend/API con verificación estricta de token.
    // =========================================================================
    match /solicitudes_documentacion/{solicitudDocId} {
      allow get: if isMasterAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.propietarioId == request.auth.uid ||
        isOwnerOfInmueble(resource.data.inmuebleId)
      ));
      allow list: if isSignedIn();
      allow create: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(incoming().inmuebleId));
      allow update: if (isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId))) && (
        (!('historial' in existing()) || !('historial' in incoming()) || incoming().historial.size() >= existing().historial.size())
      );
      allow delete: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId));
    }

    // =========================================================================
    // 7. CONTRATOS DE FORMALIZACIÓN, LAU Y ENTREGA DE LLAVES
    // =========================================================================
    match /contratos_formalizacion/{contratoId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // =========================================================================
    // 8. CONFIGURACIÓN DE ASEGURADORAS (SEAG, Caser, etc.)
    // =========================================================================
    match /configuracion_aseguradoras/{aseguradoraId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // =========================================================================
    // 9. SOLICITUDES DE SEGURO DE IMPAGO Y EXPEDIENTES
    // Propietario A no puede consultar ni tramitar expedientes de Propietario B
    // =========================================================================
    match /solicitudes_seguro_impago/{solicitudSeguroId} {
      allow get: if isMasterAdmin() || (isSignedIn() && (
        resource.data.propietarioId == request.auth.uid ||
        isOwnerOfInmueble(resource.data.inmuebleId)
      ));
      allow list: if isSignedIn();
      allow create: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(incoming().inmuebleId));
      allow update: if (isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId))) && (
        (!('historial' in existing()) || !('historial' in incoming()) || incoming().historial.size() >= existing().historial.size())
      );
      allow delete: if isMasterAdmin() || (isSignedIn() && isOwnerOfInmueble(existing().inmuebleId));
    }

    // =========================================================================
    // 10. CONFIGURACIÓN DEL SISTEMA Y GMAIL INTEGRATION
    // =========================================================================
    match /system/{systemDocId} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // 11. USUARIOS Y CONTROL DE ACCESO (PROTECCIÓN ESTRICTA CONTRA ELEVACIÓN)
    // =========================================================================
    match /usuarios/{usuarioId} {
      allow get: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == usuarioId ||
        resource.data.authUid == request.auth.uid ||
        resource.data.tipoPerfil in ['PROFESIONAL', 'PROPIETARIO', 'ADMINISTRADOR']
      );
      allow list: if isSignedIn();
      allow create: if isMasterAdmin() || (
        isSignedIn() &&
        incoming().authUid == request.auth.uid &&
        incoming().tipoPerfil in ['PROPIETARIO', 'PROFESIONAL'] &&
        (!('SUPERADMIN' in incoming().roles))
      );
      allow update: if isMasterAdmin() || (
        isSignedIn() &&
        (existing().authUid == request.auth.uid || usuarioId == request.auth.uid) &&
        incoming().tipoPerfil == existing().tipoPerfil &&
        incoming().roles == existing().roles &&
        incoming().estado == existing().estado
      );
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 12. PROFESIONALES Y EMPRESAS DE MANTENIMIENTO
    // =========================================================================
    match /profesionales/{profesionalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 13. ENLACES DE REGISTRO E INVITACIONES CONFIGURABLES
    // =========================================================================
    match /enlaces_registro/{enlaceId} {
      allow get: if isSignedIn() || (isValidId(enlaceId) && resource.data.activo == true);
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // =========================================================================
    // 14. CATÁLOGO ADMINISTRABLE DE ESPECIALIDADES
    // =========================================================================
    match /especialidades/{especialidadId} {
      allow get: if isSignedIn() || isValidId(especialidadId);
      allow list: if isSignedIn() || (resource.data.activo == true || !('activo' in resource.data));
      allow write: if isSignedIn();
    }

    // =========================================================================
    // 15. REGISTROS DE AUDITORÍA (INMUTABLE - SÓLO INSERCIÓN)
    // =========================================================================
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() || (
        incoming().keys().hasAll(['id', 'action', 'timestamp']) &&
        incoming().action is string &&
        incoming().timestamp is string
      );
      allow update, delete: if false;
    }

    // =========================================================================
    // 16. BLOQUE 4: INCIDENCIAS, MANTENIMIENTO Y TRABAJOS PROFESIONALES
    // =========================================================================
    match /incidencias/{incidenciaId} {
      allow get: if isMasterAdmin() || (isSignedIn() && (
        resource.data.propietarioId == request.auth.uid ||
        isOwnerOfInmueble(resource.data.inmuebleId) ||
        (resource.data.trabajoProfesional != null && resource.data.trabajoProfesional.profesionalId == request.auth.uid)
      ));
      allow list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 17. BLOQUE 4: PÓLIZAS DE SEGURO
    // =========================================================================
    match /polizas_seguros/{polizaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 18. BLOQUE 4: SINIESTROS VINCULADOS A INCIDENCIAS
    // =========================================================================
    match /siniestros/{siniestroId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 19. BLOQUE 5: TRABAJOS PROFESIONALES
    // =========================================================================
    match /trabajos_profesionales/{trabajoId} {
      allow get: if isMasterAdmin() || (isSignedIn() && (
        resource.data.propietarioId == request.auth.uid ||
        isOwnerOfInmueble(resource.data.inmuebleId) ||
        resource.data.profesionalId == request.auth.uid
      ));
      allow list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 20. BLOQUE 5: PRESUPUESTOS DE PROFESIONALES
    // =========================================================================
    match /presupuestos_profesionales/{presupuestoId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 21. BLOQUE 5: VALORACIONES Y EVALUACIONES DE PROFESIONALES
    // =========================================================================
    match /valoraciones_profesionales/{valoracionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // GLOBAL DEFAULT DENY CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
