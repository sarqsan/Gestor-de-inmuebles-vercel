rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FASE 1.4 — PREDICADOS DE IDENTIDAD, ROL Y AISLAMIENTO POR PROPIETARIO
    // =========================================================================
    // NOTA DE DISEÑO:
    //  - request.auth sólo está poblado cuando el usuario se autentica con
    //    Firebase Authentication (Email/Contraseña). El modo "directo" sin Auth
    //    no puede identificarse y, por tanto, no puede ser asegurado con reglas.
    //  - El documento `usuarios_auth/{uid}` es un espejo REDUCIDO y NO
    //    falsificable del perfil `usuarios/{id}`: la regla de escritura obliga
    //    a que sus campos sensibles coincidan con el documento autoritativo,
    //    que a su vez no puede ser modificado por el propio usuario para
    //    cambiar de rol o de propietario.
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && 'email' in request.auth.token ? request.auth.token.email : '';
    }

    // El Administrador Principal se identifica por el email verificado por
    // Firebase (imposible de suplantar desde el cliente).
    function isMasterAdmin() {
      return isSignedIn() && authEmail() == 'sarqsan2@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ROADMAP-01: audit_logs sigue siendo el único libro. Cada escritura
    // privilegiada referencia un evento NUEVO incluido en el mismo commit.
    // El mismo evento puede abarcar varios documentos de una transacción;
    // todos deben constar en rutas y compartir actor autenticado.
    function auditoriaVinculada(d, ruta) {
      return 'roadmap01AuditId' in d && isValidId(d.roadmap01AuditId)
        && !exists(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId))
        && existsAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId))
        && getAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId)).data.id == d.roadmap01AuditId
        && getAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId)).data.resultado == 'EXITO'
        && getAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId)).data.usuarioEmail == authEmail()
        && getAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId)).data.detalles.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/audit_logs/$(d.roadmap01AuditId)).data.detalles.rutas.hasAny([ruta]);
    }
    function auditoriaNueva(d, previo, ruta) {
      return (!('roadmap01AuditId' in previo) || d.roadmap01AuditId != previo.roadmap01AuditId)
        && auditoriaVinculada(d, ruta);
    }

    // R3 — Lista blanca CERRADA de claves de `fichas_publicas_inmueble`.
    // Paridad con `CAMPOS_FICHA_PUBLICA` (src/lib/fichaPublicaInmueble.ts):
    // solo campos destinados a publicación; ni IBAN, ni NIF, ni inquilino,
    // ni valores, ni notas, ni token de solicitud, ni índices internos.
    function clavesFichaPublicaOk() {
      return incoming().keys().hasOnly([
        'id', 'inmuebleId', 'propietarioId', 'direccion', 'ciudad',
        'codigoPostal', 'precio', 'estado', 'habitaciones', 'banos',
        'superficie', 'descripcion', 'imagenUrl', 'imagenes', 'fianzaMeses',
        'tipoInmueble', 'modalidadAlquiler', 'planta', 'ascensor', 'terraza',
        'balcon', 'interiorExterior', 'orientacion', 'anioConstruccion',
        'estadoConservacion', 'aireAcondicionado', 'calefaccion',
        'cocinaEquipada', 'electrodomesticosIncluidos', 'armariosEmpotrados',
        'tipoVentanas', 'tipoPersianas', 'actualizadoEn'
      ]);
    }

    // BLOQUE B — verificación de secretos compartida por las colecciones de
    // tesorería (26–31). Ningún campo de credencial bancaria/certificado entra.
    function sinSecretosTesoreria() {
      return !(
        'credentials' in incoming() ||
        'apiKey' in incoming() ||
        'accessToken' in incoming() ||
        'psd2' in incoming() ||
        'certificado' in incoming() ||
        'privateKey' in incoming() ||
        'ibanSecreto' in incoming() ||
        'tokenBancario' in incoming() ||
        'password' in incoming() ||
        'secret' in incoming() ||
        'token' in incoming()
      );
    }

    function incoming() {
      return request.resource.data;
    }

    // --- BLOQUE C (morosidad) ------------------------------------------------
        // BLOQUE C — mismo control de secretos para las colecciones de morosidad.
    // Un expediente referencia comunicaciones y evidencias: nunca admite
    // credenciales, tokens ni adjuntos en base64 dentro del documento.
    function sinSecretosMorosidad() {
      return !(
        'credentials' in incoming() ||
        'apiKey' in incoming() ||
        'accessToken' in incoming() ||
        'refreshToken' in incoming() ||
        'privateKey' in incoming() ||
        'password' in incoming() ||
        'secret' in incoming() ||
        'token' in incoming() ||
        'base64Data' in incoming() ||
        'adjuntoBase64' in incoming()
      );
    }

    // GAP 5 (sindicación) — el estado publicado por (inmueble, portal) se persiste en
    // `sindicacion_inmuebles`. Es el ÚNICO sitio donde el ERP guarda qué versión del
    // anuncio está fuera, así que ningún secreto de portal puede vivir ahí: el núcleo
    // (`CLAVES_CREDENCIAL_PROHIBIDAS` en src/sindicacion/adaptadores.ts) ya lo rechaza
    // y la regla lo repite como superconjunto (defensa en profundidad: mismo criterio,
    // nunca más laxo que el adaptador).
    function sinSecretosSindicacion() {
      return !(
        // claves que rechaza el núcleo. El lenguaje de reglas no puede importar la
        // lista TS, así que aquí está copiada; el test de reglas exige que TODA clave
        // de CLAVES_CREDENCIAL_PROHIBIDAS aparezca en este predicado ⇒ es imposible
        // que regla y adaptador se desincronicen en silencio.
        'credenciales' in incoming() ||
        'credential' in incoming() ||
        'credentials' in incoming() ||
        'apiKey' in incoming() ||
        'api_key' in incoming() ||
        'apikey' in incoming() ||
        'token' in incoming() ||
        'accessToken' in incoming() ||
        'refreshToken' in incoming() ||
        'secret' in incoming() ||
        'clientSecret' in incoming() ||
        'password' in incoming() ||
        'authorization' in incoming() ||
        // claves extra de los patrones §26–31 / §32–37 y del mundo OAuth
        'privateKey' in incoming() ||
        'certificado' in incoming() ||
        'psd2' in incoming() ||
        'ibanSecreto' in incoming() ||
        'tokenBancario' in incoming() ||
        'consumerKey' in incoming() ||
        'consumerSecret' in incoming() ||
        'oauth' in incoming() ||
        'oauthToken' in incoming() ||
        'cookie' in incoming() ||
        'base64Data' in incoming() ||
        'adjuntoBase64' in incoming()
      );
    }

    function existing() {
      return resource.data;
    }

    // --- Espejo de identidad usuarios_auth/{uid} -----------------------------
    function me() {
      return get(/databases/$(database)/documents/usuarios_auth/$(request.auth.uid)).data;
    }

    function activeUser() {
      // Revoca también el UID antiguo de un perfil re-enlazado: el espejo
      // persistido por sí solo nunca concede titularidad/cartera.
      return perfilActualVeraz();
    }

    function isPropietarioRole() {
      return activeUser() && me().tipoPerfil == 'PROPIETARIO';
    }

    function isProfesionalRole() {
      return activeUser() && me().tipoPerfil == 'PROFESIONAL';
    }

    function myProfId() {
      return me().profesionalId;
    }

    // El profesional sólo puede ver una incidencia que le haya sido asignada
    // (presupuestos pendientes o datos económicos de otros quedan ocultos).
    function incidenciaAsignadaAmi(src) {
      return isProfesionalRole()
        && 'profesionalAsignadoId' in src
        && src.profesionalAsignadoId == myProfId();
    }

    function myPropId() {
      return me().propietarioId;
    }

    function myInmuebleIds() {
      return me().inmuebleIds;
    }

    function ownsPropietario(pid) {
      return isPropietarioRole() && pid is string && pid.size() > 0 && myPropId() == pid;
    }

    // ¿Puede el propietario ver el inmueble? Por titularidad o por asignación
    // explícita (cuando se le comparte una vivienda que no es suya).
    function canReachInmuebleId(inmId) {
      return isPropietarioRole() && myInmuebleIds().hasAny([inmId]);
    }

    // D2a — acotación server-side de LECTURA de `inmuebles` (cierre de F5-1).
    // Ámbito administrativo legítimo: el master reconocido por email, o el
    // perfil ADMINISTRADOR en `usuarios/{uid}` (el espejo y el perfil nunca
    // pueden auto-afirmar ADMINISTRADOR: sólo el master puede escribirlo, así
    // que no se amplían privilegios; se retira el "isStaff() ⇒ acceso global").
    function esAdminInmuebles() {
      return isMasterAdmin() ||
        (existeUsuarioActual() && getUsuarioActual().tipoPerfil == 'ADMINISTRADOR'
         && getUsuarioActual().estado == 'ACTIVO'
         && getUsuarioActual().authUid == request.auth.uid);
    }

    // Titularidad jurídica del inmueble (titular o copropietario principal).
    // En un `list` sólo la igualdad `propietarioId == myPropId()` es
    // demostrable por el motor con `where('propietarioId','==', pid)` (el
    // valor sale de un `get` de ruta fija que se trata como constante; mismo
    // criterio que `contratoEsMio`).
    function inmuebleEsMio(d) {
      // N TITULARES (F2): la cotitularidad TAMBIÉN da acceso al inmueble. El
      // índice `titularesIds` del propio inmueble es la prueba: `array-contains`
      // es demostrable para el motor en una consulta `list`, y `hasAny` lo es
      // en un `get`. Así el cotitular ve la vivienda (y, con ella, el resto de
      // titularidades por su clave determinista) sin conocer ids de terceros.
      return isPropietarioRole() && (
        ('propietarioId' in d && d.propietarioId == myPropId()) ||
        ('propietarioPrincipalId' in d && d.propietarioPrincipalId == myPropId()) ||
        ('titularesIds' in d && d.titularesIds is list && d.titularesIds.hasAny([myPropId()]))
      );
    }

    // Autorización explícita vía `inmuebleIds` del espejo de identidad, para
    // cualquier usuario activo (propietario o profesional asignado). Es de
    // SOLO LECTURA: la escritura (`update`) sigue gobernada por
    // `canReachInmuebleId`, que no se modifica en D2a.
    function inmuebleAutorizadoExplicito(inmId) {
      return activeUser()
        && 'inmuebleIds' in me() && me().inmuebleIds is list
        && myInmuebleIds().hasAny([inmId]);
    }

    // D2b/D3 — carteras gestionadas (proyección D1R en el espejo de
    // identidad; SOLO el master puede escribirlas, ver reglas de
    // `usuarios_auth`). carterasL = lectura (ACTIVA o REVOCADA con lectura
    // histórica, S7); carterasE = lectura+escritura (ACTIVA +
    // LECTURA_ESCRITURA + responsableActual GESTOR). La gestión NO altera la
    // titularidad: sólo acota el acceso por `propietarioId`.
    function carterasLectura() {
      return (activeUser() && 'carterasL' in me() && me().carterasL is list)
        ? me().carterasL : [];
    }
    function carterasEscritura() {
      return (activeUser() && 'carterasE' in me() && me().carterasE is list)
        ? me().carterasE : [];
    }
    // ¿El inmueble pertenece a una cartera que gestiono (L o E)? En un `list`
    // es demostrable con `where('propietarioId','==', pid)` pid a pid (el
    // motor evalúa la pertenencia del valor acotado contra la lista constante
    // del espejo; mismo criterio que `contratoEsMio`).
    function inmuebleEnCarteraGestionada(d) {
      return activeUser() && 'propietarioId' in d && (
        (('gestionesPorPropietario' in me() && d.propietarioId in me().gestionesPorPropietario)
          ? gestionActivaCompletaIndexada(d.propietarioId)
          : (carterasLectura().hasAny([d.propietarioId]) || carterasEscritura().hasAny([d.propietarioId])))
      );
    }
    // Escritura: SOLO carterasE (S7: la escritura nunca se concede por el
    // mero hecho de existir la gestión).
    function inmuebleEnCarteraEscritura(d) {
      return activeUser() && 'propietarioId' in d
        && (('gestionesPorPropietario' in me() && d.propietarioId in me().gestionesPorPropietario)
          ? gestionCompletaEscrituraIndexada(d.propietarioId)
          : carterasEscritura().hasAny([d.propietarioId]));
    }
    // D3 (§9) — Ámbito derivado para entidades SIN `propietarioId` directo.
    // La cadena es `inmuebleId → inmuebles/{id} → propietarioId` (o
    // `contratoId → contratos_formalizacion/{id} → propietarioId`) y el pid
    // resultante se valida contra el espejo (titular + carteras). Sin
    // duplicar datos: el ámbito se deriva, no se almacena. `get()` sobre un
    // documento inexistente falla ⇒ deny (fail-closed). La administración
    // (`esAdminInmuebles()`) cortocircuita primero: conserva la operativa
    // global (p. ej. SuministrosSection solo-admin) y opera huérfanos.
    function pidEnAmbitoLectura(pid) {
      return pid == myPropId() || (('gestionesPorPropietario' in me() && pid in me().gestionesPorPropietario)
        ? gestionActivaCompletaIndexada(pid) : (carterasLectura().hasAny([pid]) || carterasEscritura().hasAny([pid])));
    }
    function pidEnAmbitoEscritura(pid) {
      return pid == myPropId() || (('gestionesPorPropietario' in me() && pid in me().gestionesPorPropietario)
        ? gestionCompletaEscrituraIndexada(pid) : carterasEscritura().hasAny([pid]));
    }
    function pidDelInmuebleAmbito(inmuebleId) {
      return get(/databases/$(database)/documents/inmuebles/$(inmuebleId)).data.propietarioId;
    }
    function ambitoPorInmuebleLectura(inmuebleId) {
      return esAdminInmuebles() || (activeUser() && inmuebleId is string
        && (pidEnAmbitoLectura(pidDelInmuebleAmbito(inmuebleId))
          || inmuebleParcialIndexado(pidDelInmuebleAmbito(inmuebleId), inmuebleId, false)));
    }
    function ambitoPorInmuebleEscritura(inmuebleId) {
      return esAdminInmuebles() || (activeUser() && inmuebleId is string
        && (pidEnAmbitoEscritura(pidDelInmuebleAmbito(inmuebleId))
          || inmuebleParcialIndexado(pidDelInmuebleAmbito(inmuebleId), inmuebleId, true)));
    }
    function pidDelContratoAmbito(contratoId) {
      return get(/databases/$(database)/documents/contratos_formalizacion/$(contratoId)).data.propietarioId;
    }
    function ambitoPorContratoLectura(contratoId) {
      return esAdminInmuebles() || (activeUser() && contratoId is string
        && pidEnAmbitoLectura(pidDelContratoAmbito(contratoId)));
    }
    function ambitoPorContratoEscritura(contratoId) {
      return esAdminInmuebles() || (activeUser() && contratoId is string
        && pidEnAmbitoEscritura(pidDelContratoAmbito(contratoId)));
    }
    // Involucración en una gestión de cartera (lectura del registro
    // trazable): el titular de la cartera o el gestor designado.
    function gestionInvolucraAMi(d) {
      return activeUser() && (
        (isPropietarioRole() && 'propietarioId' in d && d.propietarioId == myPropId()) ||
        ('gestorUsuarioId' in d && 'usuarioId' in me() && d.gestorUsuarioId == me().usuarioId)
      );
    }
    // D3 — los campos de carteras del espejo son SOLO del master: un usuario
    // no puede crearlos ni modificarlos en su propio espejo (anti-
    // autoasignación). El master queda fuera de estas guardas.
    function carterasNoAutoasignadasEnCreacion() {
      return !('gestionesPorPropietario' in incoming()) && !('ultimaInvitacionCarteraId' in incoming()) && !('carterasL' in incoming()) && !('carterasE' in incoming());
    }
    function carterasSinCambiarPorUsuario() {
      return mismoCampoOpcional('gestionesPorPropietario') && mismoCampoOpcional('ultimaInvitacionCarteraId') && ((!('carterasL' in incoming()) ||
               ('carterasL' in existing() && incoming().carterasL == existing().carterasL)) &&
              (!('carterasE' in incoming()) ||
               ('carterasE' in existing() && incoming().carterasE == existing().carterasE)));
    }

    // ¿El contrato pertenece a este propietario? Es la ÚNICA condición
    // demostrable para una CONSULTA (list): el cliente debe filtrar con
    // where('propietarioId','==', propietarioId). El valor propietarioId se
    // obtiene con un get de RUTA FIJA (sólo request.auth.uid), que el motor
    // trata como constante, así que la restricción where satisface la regla.
    function contratoEsMio(d) {
      return 'propietarioId' in d && d.propietarioId == myPropId();
    }

    // Para un documento concreto (get) se admite también el inmueble asignado.
    // NO se usa en list (la membresía por array no sería demostrable para una
    // consulta sin el filtro adecuado).
    function contratoVisible(d) {
      return contratoEsMio(d) ||
             ('inmuebleId' in d && myInmuebleIds().hasAny([d.inmuebleId]));
    }

    // FASE 2.0 — GASTOS (datos económicos): mismo aislamiento que los contratos,
    // por propietarioId. La cuota hipotecaria también es un dato sensible.
    function gastoEsMio(d) {
      return 'propietarioId' in d && d.propietarioId == myPropId();
    }
    function gastoVisible(d) {
      return gastoEsMio(d) ||
             ('inmuebleId' in d && myInmuebleIds().hasAny([d.inmuebleId]));
    }

    // FASE 3 — Helpers genéricos de aislamiento por propietarioId, reutilizables
    // por cualquier recurso económico del propietario (expedientes, propuestas,
    // leads…). Mismas garantías que en contratos/gastos.
    function aisladoEsMio(d) {
      return 'propietarioId' in d && d.propietarioId == myPropId();
    }
    function aisladoVisible(d) {
      return aisladoEsMio(d) ||
             ('inmuebleId' in d && myInmuebleIds().hasAny([d.inmuebleId]));
    }
    function aisladoCreateOk() {
      return isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string;
    }
    function aisladoUpdateOk() {
      return isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId();
    }

    // Validación del espejo de identidad contra el perfil autoritativo.
    function indexMatchesProfile(profileId) {
      return get(/databases/$(database)/documents/usuarios/$(profileId)).data;
    }

    function indexIsTruthful() {
      let src = indexMatchesProfile(incoming().usuarioId);
      let propOk = ('propietarioId' in src)
        ? incoming().propietarioId == src.propietarioId
        : incoming().propietarioId == '';
      let profOk = ('profesionalId' in src)
        ? incoming().profesionalId == src.profesionalId
        : incoming().profesionalId == '';
      let inmOk = ('inmuebleIds' in src)
        ? incoming().inmuebleIds == src.inmuebleIds
        : incoming().inmuebleIds.size() == 0;
      return incoming().usuarioId is string
        && src.authUid == request.auth.uid
        && incoming().email == src.email
        && incoming().tipoPerfil == src.tipoPerfil
        && incoming().estado == src.estado
        && incoming().roles == src.roles
        && propOk
        && profOk
        && inmOk;
    }

    // =========================================================================
    // 0A. ESPEJO DE IDENTIDAD POR UID (usuarios_auth) — anti-elevación
    // =========================================================================
    match /usuarios_auth/{uid} {
      allow read: if isMasterAdmin() || (isSignedIn() && request.auth.uid == uid);

      // El espejo sólo puede crearse/actualizarse para el UID propio y debe
      // reflejar exactamente el perfil autoritativo. Nunca puede afirmar que es
      // ADMINISTRADOR por sí mismo (la administración se reconoce por email).
      // D3 — anti-autoasignación: `carterasL`/`carterasE` son campos SOLO
      // del master (proyección de `gestiones_cartera`). Un usuario no puede
      // crearlos ni alterar su propio ámbito de autorización de carteras.
      allow create: if (isMasterAdmin() && auditoriaVinculada(incoming(), 'usuarios_auth/' + uid)) || (
        isSignedIn() && !isMasterAdmin()
        && request.auth.uid == uid
        && incoming().tipoPerfil in ['PROPIETARIO', 'PROFESIONAL', 'INQUILINO']
        && indexIsTruthful()
        && !('roadmap01AuditId' in incoming())
        && carterasNoAutoasignadasEnCreacion()
      );
      allow update: if (isMasterAdmin() && auditoriaNueva(incoming(), existing(), 'usuarios_auth/' + uid)) || (
        isSignedIn() && !isMasterAdmin()
        && request.auth.uid == uid
        && incoming().tipoPerfil in ['PROPIETARIO', 'PROFESIONAL', 'INQUILINO']
        && indexIsTruthful()
        && mismoCampoOpcional('roadmap01AuditId')
        && carterasSinCambiarPorUsuario()
      );
      allow delete: if false; // no se borra el binding, se revoca estado auditado

      // -----------------------------------------------------------------------
      // §6 F3 — PROGRESO DE TUTORIALES (Capa Transversal de Experiencia)
      // usuarios_auth/{uid}/progreso_tutoriales/{host}__{tutorialId}
      // Solo el propio usuario autenticado (request.auth.uid == uid) lee y
      // escribe su progreso. Ni el administrador ni ningún otro usuario acceden
      // (deny-by-default). Modelo mínimo y cerrado: claves exactas, tipos y
      // rangos; nunca contenido de tutoriales ni datos arbitrarios.
      // -----------------------------------------------------------------------
      function esProgresoTutorialValido(d, docId) {
        return d.keys().hasAll(['tutorialId', 'host', 'currentStep', 'stepCount', 'completed', 'skippedSteps', 'startedAt', 'updatedAt'])
          && d.keys().hasOnly(['tutorialId', 'host', 'currentStep', 'stepCount', 'completed', 'skippedSteps', 'startedAt', 'updatedAt', 'completedAt'])
          && isValidId(d.tutorialId)
          && d.host in ['ERP', 'PORTAL_INQUILINO']
          && docId == d.host + '__' + d.tutorialId
          && d.currentStep is int && d.currentStep >= 0 && d.currentStep < 100
          && d.stepCount is int && d.stepCount >= 1 && d.stepCount <= 100
          && d.currentStep < d.stepCount
          && d.completed is bool
          && d.skippedSteps is list && d.skippedSteps.size() <= 100
          && d.startedAt is string && d.startedAt.size() <= 40
          && d.updatedAt is string && d.updatedAt.size() <= 40
          && (!('completedAt' in d) || (d.completedAt is string && d.completedAt.size() <= 40));
      }

      match /progreso_tutoriales/{progresoId} {
        allow get: if isSignedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && isValidId(progresoId)
          && esProgresoTutorialValido(incoming(), progresoId);
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // =========================================================================
    // E.0. BLOQUE E — HELPERS DE AISLAMIENTO DEL INQUILINO
    // Modelo: inquilino → contrato(s) vinculado(s) (usuario.contratoIds) → inmueble.
    // - isStaff(): cualquier usuario autenticado que NO sea perfil INQUILINO.
    // - El inquilino NUNCA lista colecciones: lee por get() directo los documentos
    //   de su alcance y descubre los IDs hijo mediante los índices de capacidad
    //   del contrato (incidenciaIds, mensajeIds) y del suministro
    //   (lecturaIds, cambioTitularIds), que solo pueden crecer (sin borrado).
    // =========================================================================

    function existeUsuarioActual() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function getUsuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // E: la ausencia de perfil NO convierte a un Auth recién creado en staff.
    // El espejo apunta a la ficha autoritativa, cuyo UID/estado/tipo deben
    // concordar. El inquilino puede tener usuarioId distinto del Auth UID.
    function perfilActualVeraz() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios_auth/$(request.auth.uid))
        && isValidId(me().usuarioId)
        && exists(/databases/$(database)/documents/usuarios/$(me().usuarioId))
        && me().estado == 'ACTIVO'
        && get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data.estado == 'ACTIVO'
        && get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data.tipoPerfil == me().tipoPerfil;
    }
    function isTenant() {
      return isSignedIn() && !isMasterAdmin() &&
        ((perfilActualVeraz() && me().tipoPerfil == 'INQUILINO') ||
         (existeUsuarioActual() && getUsuarioActual().tipoPerfil == 'INQUILINO'
          && getUsuarioActual().estado == 'ACTIVO'
          && getUsuarioActual().authUid == request.auth.uid));
    }

    function isStaff() {
      return isMasterAdmin() || (perfilActualVeraz() &&
        me().tipoPerfil in ['ADMINISTRADOR', 'PROPIETARIO', 'PROFESIONAL']);
    }

    function tenantContratoIds() {
      return (perfilActualVeraz() && me().tipoPerfil == 'INQUILINO'
        && 'contratoIds' in get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data
        && get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data.contratoIds is list)
        ? get(/databases/$(database)/documents/usuarios/$(me().usuarioId)).data.contratoIds
        : ((existeUsuarioActual() && getUsuarioActual().tipoPerfil == 'INQUILINO'
            && getUsuarioActual().estado == 'ACTIVO'
            && getUsuarioActual().authUid == request.auth.uid
            && 'contratoIds' in getUsuarioActual() && getUsuarioActual().contratoIds is list)
          ? getUsuarioActual().contratoIds : []);
    }

    function tenantTieneContrato(contratoId) {
      return isTenant() && contratoId is string && contratoId in tenantContratoIds();
    }

    function tenantVeContratos(lista) {
      return isTenant() && lista is list && tenantContratoIds().hasAny(lista);
    }

    function campoListaActual(nombre) {
      return (nombre in existing()) && existing()[nombre] is list ? existing()[nombre] : [];
    }

    // Un índice de capacidad solo puede crecer de forma acotada (sin borrado ni truncado).
    function indiceInmutableOCrece(campo) {
      return (!(campo in existing()) && !(campo in incoming())) ||
        (!(campo in existing()) && (campo in incoming()) &&
          incoming()[campo] is list && incoming()[campo].size() <= 5) ||
        ((campo in existing()) && (campo in incoming()) &&
          existing()[campo] is list && incoming()[campo] is list &&
          existing()[campo].toSet().difference(incoming()[campo].toSet()).size() == 0 &&
          incoming()[campo].size() <= existing()[campo].size() + 5);
    }

    // Una lista de evidencias solo puede crecer (aportar fotos/docs sin borrar).
    function listaSoloCrece(campo) {
      return (!(campo in existing()) && !(campo in incoming())) ||
        (!(campo in existing()) && (campo in incoming()) && incoming()[campo] is list) ||
        ((campo in existing()) && (campo in incoming()) && existing()[campo] is list &&
          incoming()[campo] is list && incoming()[campo].size() >= existing()[campo].size());
    }

    // Un campo opcional debe permanecer idéntico (ausente-ausente o igual-igual).
    function mismoCampoOpcional(campo) {
      return (!(campo in existing()) && !(campo in incoming())) ||
        ((campo in existing()) && (campo in incoming()) &&
          incoming()[campo] == existing()[campo]);
    }

    function getEnlaceE(enlaceId) {
      return get(/databases/$(database)/documents/enlaces_registro/$(enlaceId)).data;
    }
    // ROADMAP-02: la invitación vincula cuenta, Persona y cartera; el permiso
    // nace de una relación activa, nunca del rol o del índice por sí solo.
    function esInvitacionGestion(d) {
      return 'finalidad' in d && d.finalidad == 'ONBOARDING_CARTERA';
    }
    function gestionDeInvitacion(e) {
      return get(/databases/$(database)/documents/gestiones_cartera/$(e.gestionId)).data;
    }
    function destinatarioGestion(e) {
      return isSignedIn() && request.auth.token.email_verified == true
        && e.emailInvitado == authEmail()
        && (!('authUid' in get(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data)
          || get(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data.authUid == request.auth.uid)
        && exists(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado))
        && get(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data.email == e.emailInvitado
        && get(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data.personaId == e.personaIdVinculada
        && get(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data.propietarioId == e.propietarioIdVinculado
        && get(/databases/$(database)/documents/personas/$(e.personaIdVinculada)).data.usuarioId == e.usuarioIdVinculado
        && get(/databases/$(database)/documents/propietarios/$(e.propietarioIdVinculado)).data.personaId == e.personaIdVinculada;
    }
    function gestionR02Consistente(e, g) {
      return g.id == e.gestionId && g.enlaceRegistroId == e.id
        && g.propietarioId == e.propietarioIdVinculado
        && g.inmuebleIds == e.alcanceInmuebleIds && g.permiso == e.permisoGestion
        && g.gestorUsuarioId is string;
    }
    function usuarioR02Activado(e) {
      let u = getAfter(/databases/$(database)/documents/usuarios/$(e.usuarioIdVinculado)).data;
      return u.authUid == request.auth.uid && u.estado == 'ACTIVO'
        && u.email == e.emailInvitado && u.personaId == e.personaIdVinculada
        && u.propietarioId == e.propietarioIdVinculado;
    }
    // No relación is a first-class account-only invitation, never a bypass
    // selected by incoming data (finalidad/gestionId are immutable).
    function respuestaRelacionR02(e, n) {
      let g = gestionDeInvitacion(e);
      let afterGestion = getAfter(/databases/$(database)/documents/gestiones_cartera/$(e.gestionId)).data;
      return gestionR02Consistente(e, g) && gestionR02Consistente(e, afterGestion)
        && g.estado == 'PENDIENTE_ACEPTACION'
        && afterGestion.resolucionInvitacion == n.estadoInvitacion
        && afterGestion.roadmap01AuditId == n.roadmap01AuditId
        && (n.estadoInvitacion == 'ACEPTADA' ? afterGestion.estado == 'ACTIVA'
          : afterGestion.estado == 'PENDIENTE_ACEPTACION');
    }
    function respuestaInvitacionGestion(enlaceId) {
      let e = existing();
      let n = incoming();
      return esInvitacionGestion(e) && esInvitacionGestion(n)
        && e.estadoInvitacion == 'PENDIENTE' && e.activo == true
        && e.usosActuales == 0 && e.usosMaximos == 1
        && n.activo == false && n.resueltaPor == request.auth.uid
        && n.resueltaAt is string
        && n.diff(e).affectedKeys().hasOnly(['estadoInvitacion','activo','usosActuales','resueltaAt','resueltaPor','roadmap01AuditId'])
        && auditoriaNueva(n, e, 'enlaces_registro/' + enlaceId)
        && ((destinatarioGestion(e) && request.time.toMillis() < e.fechaCaducidadMs
              && ((n.estadoInvitacion == 'ACEPTADA' && n.usosActuales == 1 && usuarioR02Activado(e))
                || (n.estadoInvitacion == 'RECHAZADA' && n.usosActuales == 0)))
          || (isMasterAdmin() && n.usosActuales == 0
            && (n.estadoInvitacion == 'REVOCADA' ||
              (n.estadoInvitacion == 'EXPIRADA' && request.time.toMillis() >= e.fechaCaducidadMs))))
        && (!('gestionId' in e) || respuestaRelacionR02(e, n));
    }
    function eventoAceptacionR02(e, n, enlace) {
      let evento = n.eventos[e.eventos.size()];
      return n.eventos == e.eventos.concat([evento])
        && evento.keys().hasOnly(['tipo','gestionId','actorId','fecha','estadoAnterior','estadoNuevo','permiso'])
        && evento.tipo == 'ACEPTACION' && evento.gestionId == e.id
        && evento.actorId == enlace.usuarioIdVinculado && evento.permiso == e.permiso
        && evento.estadoAnterior == 'PENDIENTE_ACEPTACION' && evento.estadoNuevo == 'ACTIVA'
        && evento.fecha == n.updatedAt && n.fechaActivacion == n.updatedAt
        && n.aceptada.por == enlace.usuarioIdVinculado && n.aceptada.fecha == n.updatedAt;
    }
    function actualizarGestionPorInvitacion(gestionId) {
      let e = existing();
      let n = incoming();
      let enlace = getEnlaceE(e.enlaceRegistroId);
      let afterEnlace = getAfter(/databases/$(database)/documents/enlaces_registro/$(e.enlaceRegistroId)).data;
      return esInvitacionGestion(enlace) && enlace.gestionId == gestionId
        && enlace.estadoInvitacion == 'PENDIENTE' && enlace.activo == true && enlace.usosActuales == 0
        && e.estado == 'PENDIENTE_ACEPTACION'
        && afterEnlace.estadoInvitacion in ['ACEPTADA','RECHAZADA','REVOCADA','EXPIRADA']
        && afterEnlace.activo == false && afterEnlace.resueltaPor == request.auth.uid
        && afterEnlace.roadmap01AuditId == n.roadmap01AuditId
        && gestionR02Consistente(enlace, e) && gestionR02Consistente(enlace, n)
        && n.resolucionInvitacion == afterEnlace.estadoInvitacion
        && auditoriaNueva(n, e, 'gestiones_cartera/' + gestionId)
        && ((afterEnlace.estadoInvitacion == 'ACEPTADA'
            && n.estado == 'ACTIVA' && eventoAceptacionR02(e, n, enlace)
            && n.diff(e).affectedKeys().hasOnly(['estado','aceptada','fechaActivacion','updatedAt','eventos','enlaceRegistroId','resolucionInvitacion','roadmap01AuditId']))
          || (afterEnlace.estadoInvitacion != 'ACEPTADA'
            && n.estado == e.estado && n.eventos == e.eventos
            && n.diff(e).affectedKeys().hasOnly(['resolucionInvitacion','roadmap01AuditId'])));
    }
    function gestionActivaCompletaIndexada(pid) {
      return activeUser() && 'gestionesPorPropietario' in me()
        && me().gestionesPorPropietario is map && pid in me().gestionesPorPropietario
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.propietarioId == pid
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.gestorUsuarioId == me().usuarioId
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.estado == 'ACTIVA'
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.inmuebleIds.size() == 0
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.resolucionInvitacion == 'ACEPTADA';
    }
    function gestionCompletaEscrituraIndexada(pid) {
      let g = get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data;
      return gestionActivaCompletaIndexada(pid) && g.permiso == 'LECTURA_ESCRITURA'
        && g.responsableActual == 'GESTOR';
    }
    function inmuebleParcialIndexado(pid, inmId, escritura) {
      return activeUser() && 'gestionesPorPropietario' in me()
        && me().gestionesPorPropietario is map && pid in me().gestionesPorPropietario
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.propietarioId == pid
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.gestorUsuarioId == me().usuarioId
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.estado == 'ACTIVA'
        && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.resolucionInvitacion == 'ACEPTADA'
        && inmId in get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.inmuebleIds
        && (!escritura || (get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.permiso == 'LECTURA_ESCRITURA'
          && get(/databases/$(database)/documents/gestiones_cartera/$(me().gestionesPorPropietario[pid])).data.responsableActual == 'GESTOR'));
    }

    // La cuenta INQUILINO solo nace de una invitación activa vinculada a su contrato.
    function enlaceInquilinoValido(enlaceId, contratoIds) {
      return enlaceId is string && isValidId(enlaceId) &&
        exists(/databases/$(database)/documents/enlaces_registro/$(enlaceId)) &&
        getEnlaceE(enlaceId).tipoPerfil == 'INQUILINO' &&
        getEnlaceE(enlaceId).activo == true &&
        contratoIds is list &&
        getEnlaceE(enlaceId).contratoIdVinculado in contratoIds &&
        (!('usosMaximos' in getEnlaceE(enlaceId)) ||
          getEnlaceE(enlaceId).usosActuales < getEnlaceE(enlaceId).usosMaximos);
    }

    // Un perfil profesional nuevo no puede apropiarse de una ficha ya
    // existente por conocer su ID. La invitación a esa ficha ha de ser
    // nominal para el email Auth y seguir activa; legacy sin email se reemite.
    function profesionalExistenteInvitado(d) {
      return !('profesionalId' in d) || !exists(/databases/$(database)/documents/profesionales/$(d.profesionalId))
        || ('enlaceRegistroId' in d && isValidId(d.enlaceRegistroId)
          && exists(/databases/$(database)/documents/enlaces_registro/$(d.enlaceRegistroId))
          && getEnlaceE(d.enlaceRegistroId).activo == true
          && getEnlaceE(d.enlaceRegistroId).tipoPerfil == 'PROFESIONAL'
          && getEnlaceE(d.enlaceRegistroId).profesionalIdVinculado == d.profesionalId
          && getEnlaceE(d.enlaceRegistroId).emailInvitado == authEmail());
    }

    // La activación nominal exige invitación vigente por ruta fija y un
    // consumo de un solo uso en la MISMA transacción (getAfter). Los enlaces
    // legacy sin fechaCaducidadMs deben reemitirse; no se concede excepción
    // imposible de verificar contra request.time.
    function invitacionNominalVigente(enlaceId, usuarioId, propietarioId, email) {
      return isValidId(enlaceId)
        && exists(/databases/$(database)/documents/enlaces_registro/$(enlaceId))
        && getEnlaceE(enlaceId).tipoPerfil == 'PROPIETARIO'
        && getEnlaceE(enlaceId).usuarioIdVinculado == usuarioId
        && getEnlaceE(enlaceId).propietarioIdVinculado == propietarioId
        && getEnlaceE(enlaceId).emailInvitado == email
        && getEnlaceE(enlaceId).activo == true
        && getEnlaceE(enlaceId).estadoInvitacion == 'PENDIENTE'
        && getEnlaceE(enlaceId).fechaCaducidadMs is number
        && request.time.toMillis() < getEnlaceE(enlaceId).fechaCaducidadMs
        && getEnlaceE(enlaceId).usosMaximos == 1
        && getEnlaceE(enlaceId).usosActuales == 0;
    }

    // Valida ambos extremos del vínculo en el estado posterior del commit.
    // El master no puede fijar personaId en una ficha sin actualizar la
    // Persona correspondiente dentro de la misma operación.
    function propietarioPersonaCoherente(pid, d) {
      return !('personaId' in d) ||
        (isValidId(d.personaId)
          && existsAfter(/databases/$(database)/documents/personas/$(d.personaId))
          && getAfter(/databases/$(database)/documents/personas/$(d.personaId)).data.propietarioIds.hasAny([pid]));
    }
    function usuarioPersonaCoherente(uid, d) {
      return !('personaId' in d) ||
        (isValidId(d.personaId)
          && existsAfter(/databases/$(database)/documents/personas/$(d.personaId))
          && getAfter(/databases/$(database)/documents/personas/$(d.personaId)).data.usuarioId == uid
          && (!('propietarioId' in d) || d.propietarioId == '' ||
            (existsAfter(/databases/$(database)/documents/propietarios/$(d.propietarioId))
              && getAfter(/databases/$(database)/documents/propietarios/$(d.propietarioId)).data.personaId == d.personaId)));
    }

    // ROADMAP-01: persona es identidad de dominio, NO fuente de autorización.
    // Solo el master accede; el cliente ordinario ni lista ni altera identidad.
    // No hay borrado: el vínculo histórico con titularidad nunca se purga.
    match /personas/{personaId} {
      function personaValida() {
        return incoming().keys().hasOnly([
          'id', 'nombre', 'estado', 'estadoDatos', 'roles', 'propietarioIds',
          'usuarioId', 'createdAt', 'updatedAt', 'roadmap01AuditId'
        ])
        && incoming().id == personaId
        && incoming().nombre is string
        && incoming().estado in ['ACTIVA', 'BLOQUEADA']
        && incoming().estadoDatos in ['COMPLETO', 'INCOMPLETO', 'BLOQUEADO']
        && incoming().roles is list
        && incoming().propietarioIds is list
        && (!('usuarioId' in incoming()) ||
          (isValidId(incoming().usuarioId)
            && existsAfter(/databases/$(database)/documents/usuarios/$(incoming().usuarioId))
            && getAfter(/databases/$(database)/documents/usuarios/$(incoming().usuarioId)).data.personaId == personaId));
      }
      allow get, list: if isMasterAdmin();
      allow create: if isMasterAdmin() && personaValida()
        && auditoriaVinculada(incoming(), 'personas/' + personaId)
        && incoming().propietarioIds.size() <= 1
        && (incoming().propietarioIds.size() == 0 ||
           (isValidId(incoming().propietarioIds[0])
            && existsAfter(/databases/$(database)/documents/propietarios/$(incoming().propietarioIds[0]))
            && getAfter(/databases/$(database)/documents/propietarios/$(incoming().propietarioIds[0])).data.personaId == personaId));
      allow update: if isMasterAdmin() && personaValida()
        && auditoriaNueva(incoming(), existing(), 'personas/' + personaId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // =========================================================================
    // 0B. PROPIETARIOS — DATOS FISCALES Y CUENTAS BANCARIAS (máxima sensibilidad)
    // =========================================================================
    match /propietarios/{propietarioId} {
      // INC-06 — ¿El propietario es una cartera que gestiono (proyección D2b
      // carterasL ∪ carterasE del espejo, que SOLO el master escribe)? Da
      // LECTURA de la ficha; la escritura exige carterasE y queda acotada.
      function carteraGestionadaPorMi(pid) {
        return activeUser() && pid is string && (
          (('gestionesPorPropietario' in me() && pid in me().gestionesPorPropietario)
            ? gestionActivaCompletaIndexada(pid)
            : (carterasLectura().hasAny([pid]) || carterasEscritura().hasAny([pid])))
        );
      }

      // TITULARES EN EL ÁMBITO DEL PROPIETARIO (2026-10-01, PR #19).
      // Un PROPIETARIO crea y mantiene TANTAS fichas de titular como necesite (cónyuge,
      // copropietario, familiar, sociedad, otro titular patrimonial…) sin pasar por el
      // administrador. NO EXISTE contador, tope ni cuota en ninguna regla: la cantidad
      // nunca forma parte de la condición. El único límite es de AUTORIZACIÓN/ÁMBITO:
      // una ficha está «en mi ámbito» cuando su `ambitoPropietarioId` es MI propietarioId
      // (el del espejo `usuarios_auth`, que solo escribe el master). Ilimitado NO es global:
      //   · get/list: solo fichas con MI ámbito (más la propia y las carteras que gestiono,
      //     como antes). Nadie lista `propietarios` entero salvo el master.
      //   · create: ámbito == el mío; id de forma RESERVADA `tit_<token>` (las fichas de cuenta
      //     —id == propietarioId— nunca la usan, y la rama propia la prohíbe: nadie puede
      //     adelantarse a ocupar el id de la ficha propia de otro) y sin campos de
      //     identidad/auditoría/cartera. La forma no contiene `__` (clave de titularidad
      //     `{inmuebleId}__{propietarioId}`) ni `~`, `/` ni `.`.
      //   · update: solo fichas que YA están en mi ámbito; ámbito e id inmutables.
      //   · delete: nunca (identidad jurídica e histórico).
      // Helpers LOCALES a este match: los de ámbito raíz se compilan en cada `match` hijo
      // y el conjunto del ruleset tiene un tope de tamaño compilado.
      function titularEnMiAmbito(d) {
        return isPropietarioRole() && myPropId() is string && myPropId().size() > 0
          && 'ambitoPropietarioId' in d && d.ambitoPropietarioId == myPropId();
      }
      // Id RESERVADO a fichas de titular de ámbito: `tit_` + token minúsculas/dígitos. Los dos
      // espacios de ids (ficha de cuenta vs. ficha de titular) son disjuntos por construcción.
      // (Operativa del master: el propietarioId que asigna a una CUENTA no debe tener esta forma;
      // si la tuviera, su ficha de cuenta se rechaza aquí en vez de colisionar con un titular de ámbito.)
      function idDeTitularDeAmbito(id) {
        return id is string && id.matches('^tit_[a-z0-9]{8,48}$');
      }

      // Cada propietario lee su propia ficha y las fichas de titular de SU ámbito. El
      // Administrador, todas.
      // INC-06: el gestor con relación de cartera vigente (L o E) lee la ficha
      // del propietario gestionado (mismo alcance D2b que ya tiene sobre los
      // inmuebles de esa cartera). Sin relación, nada cambia.
      allow get: if isMasterAdmin() || ownsPropietario(propietarioId)
        || carteraGestionadaPorMi(propietarioId)
        || titularEnMiAmbito(resource.data);
      // `list`: master (todo) o consulta acotada `where('ambitoPropietarioId','==', mi id)`
      // (misma forma demostrable que `inmuebleEsMio`: valor constante salido de `get` de ruta fija).
      allow list: if isMasterAdmin() || titularEnMiAmbito(resource.data);

      // El propietario puede crear/editar SU ficha (id coincidente) y, además, crear y
      // mantener tantas fichas de titular como necesite DENTRO de su ámbito.
      // (INC-06 no amplía la creación: el gestor NO crea propietarios — S3.)
      allow create: if (isMasterAdmin() && propietarioPersonaCoherente(propietarioId, incoming())
        && auditoriaVinculada(incoming(), 'propietarios/' + propietarioId)) || (
        !isMasterAdmin() && isPropietarioRole()
        && propietarioId == myPropId()
        && !incoming().keys().hasAny(['isStaff','isTenant','gestionesPorPropietario','carterasL','carterasE'])
        && !('personaId' in incoming())
        && !('roadmap01AuditId' in incoming())
        && 'id' in incoming() && incoming().id == propietarioId
        && !('ambitoPropietarioId' in incoming())
        && !idDeTitularDeAmbito(propietarioId)
      ) || (
        // Titular en MI ámbito: cualquier cantidad, siempre con mi ámbito y con id reservado.
        !isMasterAdmin() && titularEnMiAmbito(incoming())
        && idDeTitularDeAmbito(propietarioId)
        && !incoming().keys().hasAny(['isStaff','isTenant','gestionesPorPropietario','carterasL','carterasE'])
        && !('personaId' in incoming())
        && !('roadmap01AuditId' in incoming())
        && 'id' in incoming() && incoming().id == propietarioId
      );
      allow update: if (isMasterAdmin()
        && auditoriaNueva(incoming(), existing(), 'propietarios/' + propietarioId)
        && propietarioPersonaCoherente(propietarioId, incoming())
        && (!('personaId' in existing()) || ('personaId' in incoming()) ||
          (existsAfter(/databases/$(database)/documents/personas/$(existing().personaId))
           && !getAfter(/databases/$(database)/documents/personas/$(existing().personaId)).data.propietarioIds.hasAny([propietarioId])))) || (
        !isMasterAdmin() && isPropietarioRole()
        && propietarioId == myPropId()
        && !incoming().diff(existing()).affectedKeys().hasAny(['personaId', 'roadmap01AuditId'])
        && !incoming().diff(existing()).affectedKeys().hasAny(['ambitoPropietarioId'])
        && 'id' in existing() && existing().id == propietarioId
      ) || (
        // INC-06 — el gestor con cartera de ESCRITURA (carterasE: ACTIVA +
        // LECTURA_ESCRITURA + responsableActual GESTOR, proyectadas por el
        // master) puede actualizar SOLO el subobjeto `fichaPatrimonial`.
        // carterasL (lectura histórica, S7) NO escribe. Ningún otro campo del
        // propietario (datos, cuentas bancarias, notas) queda al alcance del
        // gestor: la firma de la actualización es exactamente una clave.
        !isMasterAdmin() && activeUser()
        && carterasEscritura().hasAny([propietarioId])
        && incoming().diff(existing()).affectedKeys().hasOnly(['fichaPatrimonial'])
      ) || (
        // Titular que YA está en mi ámbito: puedo mantenerlo (datos fiscales, contacto, IBAN…),
        // pero no mover su ámbito, su id ni los campos de identidad/auditoría/cartera.
        !isMasterAdmin() && titularEnMiAmbito(existing())
        && 'ambitoPropietarioId' in incoming() && incoming().ambitoPropietarioId == existing().ambitoPropietarioId
        && !incoming().diff(existing()).affectedKeys().hasAny(['id', 'personaId', 'roadmap01AuditId', 'isStaff', 'isTenant', 'gestionesPorPropietario', 'carterasL', 'carterasE'])
        && 'id' in existing() && existing().id == propietarioId
      );
      allow delete: if false; // identidad jurídica/histórico: desasociación auditada, no purga
    }

    // =========================================================================
    // 1. INMUEBLES
    // R3 (cierra el RESIDUAL conocido): el documento contiene IBAN, NIF de
    // propietarios, inquilino actual, valores patrimoniales y notas internas,
    // así que su lectura YA NO es pública. El funnel de captación anónimo
    // (solicitud y reserva de visita) se sirve del espejo mínimo
    // `fichas_publicas_inmueble` (bloque R3 siguiente), con solo campos
    // publicables. Conocer un propertyId ya no entrega datos privados.
    // Lectura: personal autenticado (master, administración, propietarios,
    // profesionales) + inquilino vinculado a su vivienda (por índice de
    // capacidad o por contrato activo). Sin enumeración anónima (list denegado
    // sin sesión). Escrituras: sin cambios.
    // =========================================================================
    match /inmuebles/{inmuebleId} {
      // D2a — LECTURA acotada server-side (cierre de F5-1): se retira el
      // "isStaff() ⇒ cualquier inmueble". Ahora get exige autorización real:
      //   1. ámbito administrativo legítimo ya existente (master por email o
      //      perfil ADMINISTRADOR, que sólo el master puede escribir);
      //   2. titularidad jurídica (propietarioId / propietarioPrincipalId);
      //   3. autorización explícita (inmuebleIds del espejo de identidad);
      //   4. D2b: cartera gestionada (carterasL ∪ carterasE del espejo,
      //      proyección D1R que sólo el master escribe);
      //   5. tenant con contrato activo/autorizado (rama INTACTA).
      allow get: if esAdminInmuebles()
        || inmuebleEsMio(resource.data)
        || inmuebleAutorizadoExplicito(inmuebleId)
        || inmuebleEnCarteraGestionada(resource.data)
        || inmuebleParcialIndexado(resource.data.propietarioId, inmuebleId, false)
        || (isTenant() && (
          tenantVeContratos(campoListaActual('contratoIdsAutorizados'))
          || ('contratoActivoId' in resource.data && tenantTieneContrato(resource.data.contratoActivoId))
        ));
      // D2a — list: un usuario ordinario NO puede listar la colección. La
      // única consulta demostrable por el motor es
      // `where('propietarioId','==', myPropId())` (inmuebleEsMio); la
      // autorización explícita se sirve por `get` documento a documento
      // (nunca por list) y la colección completa queda reservada al ámbito
      // administrativo legítimo. D2b: el gestor consulta pid a pid
      // (`where('propietarioId','==', pid)`) las carteras que gestiona.
      allow list: if esAdminInmuebles()
        || inmuebleEsMio(resource.data)
        || (isPropietarioRole() && myPropId() in resource.data.titularesIds)
        || inmuebleEnCarteraGestionada(resource.data);

      allow create: if isMasterAdmin() || (
        isPropietarioRole() && (
          ('propietarioId' in incoming() && incoming().propietarioId == myPropId()) ||
          ('propietarioPrincipalId' in incoming() && incoming().propietarioPrincipalId == myPropId())
        )
      );
      // DELTA-C (titularidad, FASE 8A): defensa adaptada de C (que congela
      // propietarioPrincipalId/propietarioSecundarioId en todo update no-master).
      // En main conviven TRES campos sin equivalencia entre sí: `propietarioId`
      // (titular económico canónico), `propietarioPrincipalId` (fiscal
      // principal) y `propietarioSecundarioId` (fiscal segundo; NO autoriza).
      // Reglas: el gestor (carterasE) y el autorizado explícito no titular NO
      // alteran la titularidad; el titular edita otros campos libremente y
      // toca la titularidad sólo si SIGUE siendo titular (permite añadir al
      // segundo propietario o corregir; la transmisión total —desvincularse—
      // requiere el flujo canónico del master). Ramas de autorización intactas.
      function titularidadInalterada() {
        return (('propietarioId' in existing() ? existing().propietarioId : '') == ('propietarioId' in incoming() ? incoming().propietarioId : ''))
          && (('propietarioPrincipalId' in existing() ? existing().propietarioPrincipalId : '') == ('propietarioPrincipalId' in incoming() ? incoming().propietarioPrincipalId : ''))
          && (('propietarioSecundarioId' in existing() ? existing().propietarioSecundarioId : '') == ('propietarioSecundarioId' in incoming() ? incoming().propietarioSecundarioId : ''));
      }
      function soyTitularActual() {
        return ('propietarioId' in existing() && existing().propietarioId == myPropId())
          || ('propietarioPrincipalId' in existing() && existing().propietarioPrincipalId == myPropId());
      }
      function sigoSiendoTitular() {
        return ('propietarioId' in incoming() && incoming().propietarioId == myPropId())
          || ('propietarioPrincipalId' in incoming() && incoming().propietarioPrincipalId == myPropId());
      }
      // D2 (§2 — titularidad jurídica ≠ gestión): el propietarioId económico
      // es el identificador canónico del ámbito. Ninguna rama no-master puede
      // alterarlo: ni el titular al editar su ficha fiscal (puede cambiar
      // principal/secundario mientras siga siendo titular, pero el canónico
      // permanece), ni el gestor de cartera (gestionar ≠ transmitir), ni el
      // autorizado explícito. La transmisión total o la corrección del
      // canónico requieren el flujo canónico del master. '' normaliza los
      // documentos legacy sin propietarioId (pueden seguir editándose; fijar
      // el canónico por primera vez también exige master).
      function propietarioCanonicoInalterado() {
        return (('propietarioId' in existing() ? existing().propietarioId : '') == ('propietarioId' in incoming() ? incoming().propietarioId : ''));
      }
      // D2b: la escritura se amplía ÚNICAMENTE a las carterasE (ACTIVA +
      // LECTURA_ESCRITURA + responsableActual GESTOR, proyectadas por el
      // master). carterasL (lectura histórica o permiso LECTURA) NO escribe.
      allow update: if isMasterAdmin()
        || (inmuebleEnCarteraEscritura(existing()) && titularidadInalterada()
          && (!('gestionesPorPropietario' in me()) || mismoCampoOpcional('contratoActivoId')))
        || (inmuebleParcialIndexado(existing().propietarioId, inmuebleId, true) && titularidadInalterada()
          && (('contratoActivoId' in existing() ? existing().contratoActivoId : '') == ('contratoActivoId' in incoming() ? incoming().contratoActivoId : '')))
        || (isPropietarioRole() && soyTitularActual() && propietarioCanonicoInalterado() && (titularidadInalterada() || sigoSiendoTitular()))
        || (isPropietarioRole() && canReachInmuebleId(inmuebleId) && titularidadInalterada());
      allow delete: if isMasterAdmin();

      // BLOQUE 6 — el documento patrimonial es hijo del inmueble: IDs
      // conocidos no autorizan lectura. Se resuelven titular, cartera y
      // delegación parcial viva en cada acceso; gestión de lectura no escribe.
      match /documentos_patrimoniales/{documentoId} {
        function inmuebleDoc() {
          return get(/databases/$(database)/documents/inmuebles/$(inmuebleId)).data;
        }
        function docLectura() {
          return esAdminInmuebles() || inmuebleEsMio(inmuebleDoc())
            || inmuebleEnCarteraGestionada(inmuebleDoc())
            || inmuebleParcialIndexado(inmuebleDoc().propietarioId, inmuebleId, false);
        }
        function docEscritura() {
          return esAdminInmuebles() || inmuebleEsMio(inmuebleDoc()) || inmuebleEnCarteraEscritura(inmuebleDoc())
            || inmuebleParcialIndexado(inmuebleDoc().propietarioId, inmuebleId, true);
        }
        function docBorrado() {
          return esAdminInmuebles() || inmuebleEsMio(inmuebleDoc());
        }
        function fuenteEnInmueble(col, id) {
          return exists(/databases/$(database)/documents/$(col)/$(id));
        }
        function tipoDocumentoPatrimonialValido(tipo) {
          return tipo in [
            'FACTURA_GASTO', 'JUSTIFICANTE_PAGO_GASTO', 'JUSTIFICANTE_COBRO', 'CONTRATO',
            'ANEXO_CONTRATO', 'POLIZA_SEGURO', 'DOCUMENTO_POLIZA', 'DOCUMENTO_RENOVACION_POLIZA',
            'RECIBO', 'LIQUIDACION_IBI', 'TASA', 'FOTO_INCIDENCIA', 'DOCUMENTO_INCIDENCIA',
            'DOCUMENTO_MANTENIMIENTO', 'DOCUMENTO_GARANTIA', 'DOCUMENTO_INVENTARIO', 'OTRO'
          ];
        }
        function facturaEnInmueble(d) {
          return fuenteEnInmueble('facturas', d.facturaId)
            && get(/databases/$(database)/documents/facturas/$(d.facturaId)).data.propietarioId == d.propietarioId
            && (get(/databases/$(database)/documents/facturas/$(d.facturaId)).data.inmuebleId == inmuebleId
              || ('gastoId' in get(/databases/$(database)/documents/facturas/$(d.facturaId)).data
                && fuenteEnInmueble('gastos', get(/databases/$(database)/documents/facturas/$(d.facturaId)).data.gastoId)
                && get(/databases/$(database)/documents/gastos/$(get(/databases/$(database)/documents/facturas/$(d.facturaId)).data.gastoId)).data.inmuebleId == inmuebleId))
            && (!('gastoId' in d) || get(/databases/$(database)/documents/facturas/$(d.facturaId)).data.gastoId == d.gastoId);
        }
        function relacionesDocumentoValidas(d) {
          return (!('contratoId' in d) || (fuenteEnInmueble('contratos_formalizacion', d.contratoId)
              && get(/databases/$(database)/documents/contratos_formalizacion/$(d.contratoId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/contratos_formalizacion/$(d.contratoId)).data.propietarioId == d.propietarioId))
            && (!('gastoId' in d) || (fuenteEnInmueble('gastos', d.gastoId)
              && get(/databases/$(database)/documents/gastos/$(d.gastoId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/gastos/$(d.gastoId)).data.propietarioId == d.propietarioId))
            && (!('incidenciaId' in d) || (fuenteEnInmueble('incidencias', d.incidenciaId)
              && get(/databases/$(database)/documents/incidencias/$(d.incidenciaId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/incidencias/$(d.incidenciaId)).data.propietarioId == d.propietarioId))
            && (!('polizaId' in d) || (fuenteEnInmueble('polizas_seguros', d.polizaId)
              && get(/databases/$(database)/documents/polizas_seguros/$(d.polizaId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/polizas_seguros/$(d.polizaId)).data.propietarioId == d.propietarioId))
            && (!('tareaMantenimientoId' in d) || (fuenteEnInmueble('tareas_mantenimiento', d.tareaMantenimientoId)
              && get(/databases/$(database)/documents/tareas_mantenimiento/$(d.tareaMantenimientoId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/tareas_mantenimiento/$(d.tareaMantenimientoId)).data.propietarioId == d.propietarioId))
            && (!('garantiaId' in d) || (fuenteEnInmueble('garantias_reparacion', d.garantiaId)
              && get(/databases/$(database)/documents/garantias_reparacion/$(d.garantiaId)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/garantias_reparacion/$(d.garantiaId)).data.propietarioId == d.propietarioId))
            && (!('inventarioId' in d) || (fuenteEnInmueble('inventario_inmuebles', d.inventarioId)
              && get(/databases/$(database)/documents/inventario_inmuebles/$(d.inventarioId)).data.inmuebleId == inmuebleId))
            && (!('movimientoId' in d) || ('gastoId' in d && d.movimientoId == 'GASTO:' + d.gastoId))
            && (!('facturaId' in d) || facturaEnInmueble(d))
            && (!('gastoId' in d && 'contratoId' in d)
              || get(/databases/$(database)/documents/gastos/$(d.gastoId)).data.contratoId == d.contratoId)
            && (!('gastoId' in d && 'incidenciaId' in d)
              || get(/databases/$(database)/documents/gastos/$(d.gastoId)).data.incidenciaId == d.incidenciaId)
            && (!('garantiaId' in d && 'incidenciaId' in d)
              || get(/databases/$(database)/documents/garantias_reparacion/$(d.garantiaId)).data.incidenciaId == d.incidenciaId);
        }
        function documentoTieneForma(d) {
          return d.keys().hasOnly([
            'id', 'inmuebleId', 'propietarioId', 'tipo', 'nombre', 'nombreStorage',
            'mimeType', 'tamanoBytes', 'sha256', 'storagePath', 'fechaDocumental',
            'fechaIncorporacion', 'actorId', 'actorNombre', 'referencia', 'observaciones',
            'version', 'sustituyeA', 'estado', 'contratoId', 'polizaId', 'gastoId', 'facturaId',
            'incidenciaId', 'tareaMantenimientoId', 'garantiaId',
            'inventarioId', 'movimientoId', 'actualizadoEl', 'eliminadoEl'
          ])
          && d.id == documentoId && d.inmuebleId == inmuebleId
          && d.propietarioId == inmuebleDoc().propietarioId
          && tipoDocumentoPatrimonialValido(d.tipo)
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 200
          && d.nombreStorage is string && d.nombreStorage.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,149}$')
          && d.mimeType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
          && d.tamanoBytes is int && d.tamanoBytes > 0 && d.tamanoBytes <= 20971520
          && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
          && d.storagePath == 'inmuebles/' + inmuebleId + '/documentos_patrimoniales/' + documentoId + '/' + d.nombreStorage
          && d.fechaIncorporacion is string && d.actorId is string && d.actorNombre is string
          && d.version is int && d.version > 0;
        }
        function sustitucionDocumentoValida(d) {
          return (!('sustituyeA' in d) && d.version == 1)
            || (d.sustituyeA is string && d.sustituyeA != documentoId
              && exists(/databases/$(database)/documents/inmuebles/$(inmuebleId)/documentos_patrimoniales/$(d.sustituyeA))
              && get(/databases/$(database)/documents/inmuebles/$(inmuebleId)/documentos_patrimoniales/$(d.sustituyeA)).data.inmuebleId == inmuebleId
              && get(/databases/$(database)/documents/inmuebles/$(inmuebleId)/documentos_patrimoniales/$(d.sustituyeA)).data.propietarioId == d.propietarioId
              && get(/databases/$(database)/documents/inmuebles/$(inmuebleId)/documentos_patrimoniales/$(d.sustituyeA)).data.estado == 'DISPONIBLE'
              && d.version == get(/databases/$(database)/documents/inmuebles/$(inmuebleId)/documentos_patrimoniales/$(d.sustituyeA)).data.version + 1);
        }
        function estadoInicialValido(d) {
          return documentoTieneForma(d) && d.estado == 'PENDIENTE_STORAGE'
            && relacionesDocumentoValidas(d) && sustitucionDocumentoValida(d);
        }
        function edicionMetadatosValida() {
          return resource.data.estado == 'DISPONIBLE'
            && request.resource.data.estado == 'DISPONIBLE'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'tipo', 'nombre', 'fechaDocumental', 'referencia', 'observaciones', 'actualizadoEl'
            ])
            && tipoDocumentoPatrimonialValido(request.resource.data.tipo)
            && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0
            && request.resource.data.nombre.size() <= 200;
        }
        function transicionCargaValida() {
          return resource.data.estado in ['PENDIENTE_STORAGE', 'ERROR_STORAGE']
            && request.resource.data.estado in ['DISPONIBLE', 'ERROR_STORAGE', 'PENDIENTE_STORAGE']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEl']);
        }
        function transicionBorradoValida() {
          return docBorrado()
            && ((resource.data.estado in ['DISPONIBLE', 'PENDIENTE_STORAGE', 'ERROR_STORAGE']
                 && request.resource.data.estado == 'PENDIENTE_ELIMINACION'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEl']))
              || (resource.data.estado == 'PENDIENTE_ELIMINACION'
                 && request.resource.data.estado == 'ELIMINADO'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'eliminadoEl', 'actualizadoEl'])));
        }

        allow get, list: if docLectura();
        allow create: if docEscritura() && estadoInicialValido(request.resource.data);
        allow update: if docEscritura() && (edicionMetadatosValida() || transicionCargaValida() || transicionBorradoValida());
        allow delete: if false; // tombstone/auditoría conservados; se borra sólo el binario.
      }
    }

    function leerGestionInvitada(g) {
      return 'enlaceRegistroId' in g && exists(/databases/$(database)/documents/enlaces_registro/$(g.enlaceRegistroId))
        && esInvitacionGestion(getEnlaceE(g.enlaceRegistroId))
        && destinatarioGestion(getEnlaceE(g.enlaceRegistroId))
        && getEnlaceE(g.enlaceRegistroId).gestionId == g.id;
    }

    // =========================================================================
    // N TITULARES — TITULARIDADES (F2)
    // -------------------------------------------------------------------------
    // Colección inversa al índice `inmuebles.titularesIds[]`:
    //  · clave DETERMINISTA `{inmuebleId}__{propietarioId}` ⇒ el acceso es un
    //    `get` individual, demostrable para el motor de reglas.
    //  · SIN `list`: la enumeración de titularidades NO existe. Se descubren
    //    por el índice del inmueble, de modo que si un TERCERO crea una
    //    titularidad sobre mi vivienda yo la veo sin conocer su id de antemano.
    //  · SIN borrado: cerrar una titularidad es un cambio de estado
    //    (`CERRADA` + fecha + motivo); el histórico permanece consultable.
    //  · Crear una titularidad NO crea ninguna cuenta de acceso: la titularidad
    //    es patrimonio; la identidad vive en `usuarios_auth` (sólo master).
    // =========================================================================
    match /titularidades/{titularidadId} {
      function datosInmuebleTitularidad(inmId) {
        return get(/databases/$(database)/documents/inmuebles/$(inmId)).data;
      }
      function soyCotitularDelInmueble(inmId) {
        return isPropietarioRole() && inmId is string
          && exists(/databases/$(database)/documents/inmuebles/$(inmId))
          && 'titularesIds' in datosInmuebleTitularidad(inmId)
          && datosInmuebleTitularidad(inmId).titularesIds is list
          && datosInmuebleTitularidad(inmId).titularesIds.hasAny([myPropId()]);
      }
      function puedoLeerTitularidadDe(inmId) {
        return esAdminInmuebles() || ambitoPorInmuebleLectura(inmId) || soyCotitularDelInmueble(inmId);
      }
      function puedoEscribirTitularidadDe(inmId) {
        return esAdminInmuebles() || ambitoPorInmuebleEscritura(inmId);
      }
      // La clave es la IDENTIDAD del documento: inmuebleId+propietarioId deben
      // coincidir con el id. Impide reescribir la relación "por detrás".
      function claveCoherente(d) {
        return d.inmuebleId is string && d.propietarioId is string
          && titularidadId == d.inmuebleId + '__' + d.propietarioId;
      }
      function camposInmutables(d, previo) {
        return d.inmuebleId == previo.inmuebleId && d.propietarioId == previo.propietarioId
          && ('id' in d ? d.id : titularidadId) == ('id' in previo ? previo.id : titularidadId)
          && ('fechaInicio' in d ? d.fechaInicio : '') == ('fechaInicio' in previo ? previo.fechaInicio : '');
      }
      // `null` = PENDIENTE (nunca se inventa un porcentaje).
      function porcentajeValido(d) {
        return !('porcentajeTitularidad' in d) || d.porcentajeTitularidad == null
          || (d.porcentajeTitularidad is number && d.porcentajeTitularidad >= 0 && d.porcentajeTitularidad <= 100);
      }
      function estadoValido(d) {
        return d.estado in ['VIGENTE', 'CERRADA'];
      }
      // Cerrar exige fecha y motivo: es un hecho patrimonial, no un trámite.
      function cierreBienFormado(d) {
        return d.estado != 'CERRADA'
          || (('fechaCierre' in d) && d.fechaCierre is string
              && ('motivoCierre' in d) && d.motivoCierre is string
              && d.motivoCierre in ['VENTA', 'DONACION', 'HERENCIA', 'DIVORCIO',
                                    'DISOLUCION_CONDOMINIO', 'ERROR_DATOS', 'OTRO']);
      }

      // get: una titularidad CONCRETA (por clave) cuando el inmueble está en mi
      // ámbito, soy cotitular de él, o la titularidad es la mía propia.
      allow get: if ('inmuebleId' in resource.data && puedoLeerTitularidadDe(resource.data.inmuebleId))
        || (isPropietarioRole() && 'propietarioId' in resource.data && resource.data.propietarioId == myPropId());
      // list: DENEGADO. No hay enumeración global de titularidades: se conocen
      // por el índice `titularesIds` de cada inmueble y se leen una a una.
      allow list: if false;

      allow create: if puedoEscribirTitularidadDe(incoming().inmuebleId)
        && claveCoherente(incoming()) && estadoValido(incoming())
        && porcentajeValido(incoming()) && cierreBienFormado(incoming());

      allow update: if puedoEscribirTitularidadDe(existing().inmuebleId)
        && puedoEscribirTitularidadDe(incoming().inmuebleId)
        && camposInmutables(incoming(), existing()) && estadoValido(incoming())
        && porcentajeValido(incoming()) && cierreBienFormado(incoming());

      // NUNCA: el cierre de una titularidad es un cambio de estado, no un
      // borrado. El histórico patrimonial se conserva siempre.
      allow delete: if false;
    }

    // =========================================================================
    // D2b/D3 — GESTIONES DE CARTERA (`gestiones_cartera`): registro trazable
    // del modelo D1R (dominio puro en src/lib/gestionesCartera.ts).
    //  · LECTURA: ámbito administrativo legítimo, titular de la cartera o
    //    gestor designado (consultas demostrables: where('propietarioId','==')
    //    del titular o where('gestorUsuarioId','==') del gestor).
    //  · ESCRITURA: SOLO el master. Ni el gestor ni el titular pueden crear,
    //    modificar ni borrar gestiones desde el cliente (la cesión/revocación
    //    y sus eventos append-only se administran por el ámbito master, que
    //    proyecta carterasL/carterasE al espejo). Sin autoasignación.
    // =========================================================================
    match /gestiones_cartera/{gestionId} {
      allow get: if esAdminInmuebles() || gestionInvolucraAMi(resource.data) || leerGestionInvitada(resource.data);
      allow list: if esAdminInmuebles() || gestionInvolucraAMi(resource.data);
      allow create: if isMasterAdmin() && auditoriaVinculada(incoming(), 'gestiones_cartera/' + gestionId);
      allow update: if isMasterAdmin() && auditoriaNueva(incoming(), existing(), 'gestiones_cartera/' + gestionId) || actualizarGestionPorInvitacion(gestionId);
      allow delete: if false; // evento REVOCACION append-only, sin purga
    }

    // =========================================================================
    // INC-06 — REGISTROS PATRIMONIALES IMPORTADOS (`registros_patrimoniales`):
    // persistencia trazable de la ejecución confirmada de importaciones del
    // módulo patrimonial (núcleo en src/lib/patrimonialPersistencia.ts).
    //  · Cada documento es un registro importado con procedencia completa
    //    (sistema, origenId, fuente, lote), evaluación de datos e incidencias
    //    conservadas: nunca una incidencia se convierte en éxito silencioso.
    //  · LECTURA: ámbito administrativo legítimo, titular del propietario
    //    destino o gestor con cartera gestionada (D2b, carterasL ∪ carterasE).
    //  · ESCRITURA: master, titular, o gestor con carterasE sobre el
    //    propietario destino; el documento debe cumplir la forma exacta del
    //    contrato persistido (lista cerrada de claves, id == docId, estados
    //    del vocabulario del módulo).
    //  · Historial: update/delete SOLO master. Ni el flujo normal ni el gestor
    //    ni el titular pueden editar o borrar retrospectivamente lo importado.
    // =========================================================================
    match /registros_patrimoniales/{registroId} {
      function registroPatrimonialOk() {
        return incoming().keys().hasOnly([
          'id', 'propietarioId', 'loteId', 'indiceOrigen', 'datosOrigen',
          'estadoDatos', 'camposFaltantes', 'politicaId', 'decision',
          'incidencias', 'procedencia', 'creadaEn', 'creadaPor'
        ])
        && incoming().keys().hasAll([
          'id', 'propietarioId', 'loteId', 'indiceOrigen', 'datosOrigen',
          'estadoDatos', 'camposFaltantes', 'politicaId', 'decision',
          'incidencias', 'procedencia', 'creadaEn', 'creadaPor'
        ])
        && registroId == incoming().id
        && incoming().propietarioId is string && incoming().propietarioId.size() > 0
        && incoming().loteId is string && incoming().loteId.size() > 0
        && incoming().indiceOrigen is int && incoming().indiceOrigen >= 0
        && incoming().datosOrigen is map
        && incoming().estadoDatos in ['COMPLETO', 'INCOMPLETO', 'BLOQUEADO']
        && incoming().camposFaltantes is list
        && (incoming().politicaId is string || incoming().politicaId == null)
        && incoming().decision in ['CREARIA', 'REVISAR']
        && incoming().incidencias is list
        && incoming().procedencia is map
        && incoming().creadaEn is string && incoming().creadaPor is string;
      }
      allow get, list: if esAdminInmuebles()
        || ownsPropietario(resource.data.propietarioId)
        || (activeUser() && (
          carterasLectura().hasAny([resource.data.propietarioId])
          || carterasEscritura().hasAny([resource.data.propietarioId])
        ));
      allow create: if registroPatrimonialOk() && (
        esAdminInmuebles()
        || ownsPropietario(incoming().propietarioId)
        || (activeUser() && carterasEscritura().hasAny([incoming().propietarioId]))
      );
      allow update, delete: if isMasterAdmin();
    }


    // =========================================================================
    // R3 — FICHA PÚBLICA DE INMUEBLE (espejo mínimo para accesos anónimos)
    // Un documento por inmueble publicado (id = inmuebleId) con SOLO campos
    // publicables (ver `clavesFichaPublicaOk`). Lectura: get público por id
    // (el enlace legítimo), list solo autenticado (sin enumeración anónima).
    // Escritura: master o propietario titular del propio documento; el id es
    // invariante (== inmuebleId) y sin titular efectivo no se publica.
    // Manipular IDs solo devuelve esta ficha recortada, jamás datos privados.
    // =========================================================================
    match /fichas_publicas_inmueble/{fichaId} {
      function fichaVinculadaAlTitular() {
        return exists(/databases/$(database)/documents/inmuebles/$(fichaId))
          && ((('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(fichaId)).data)
              && get(/databases/$(database)/documents/inmuebles/$(fichaId)).data.propietarioId == existing().propietarioId)
            || (!('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(fichaId)).data)
              && 'propietarioPrincipalId' in get(/databases/$(database)/documents/inmuebles/$(fichaId)).data
              && get(/databases/$(database)/documents/inmuebles/$(fichaId)).data.propietarioPrincipalId == existing().propietarioId));
      }
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if (isMasterAdmin() || (isPropietarioRole() && incoming().propietarioId == myPropId()))
        && isValidId(fichaId)
        && incoming().id == fichaId
        && incoming().inmuebleId == fichaId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && clavesFichaPublicaOk();
      allow update: if (
          isMasterAdmin()
          || (isPropietarioRole()
            && existing().propietarioId == myPropId()
            && incoming().propietarioId == myPropId())
          || (inmuebleParcialIndexado(existing().propietarioId, fichaId, true)
            && fichaVinculadaAlTitular()
            && incoming().propietarioId == existing().propietarioId)
        )
        && incoming().id == existing().id
        && incoming().inmuebleId == existing().inmuebleId
        && incoming().inmuebleId == fichaId
        && clavesFichaPublicaOk();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 2. CONTRATOS DE ARRENDAMIENTO = NÚCLEO ECONÓMICO (COBROS + JUSTIFICANTES)
    // Aislamiento por titular y por relación de cartera/inmueble autorizada.
    // Una delegación parcial solo alcanza contratos cuyo inmueble pertenece
    // al titular de la relación y figura expresamente en sus inmuebleIds.
    // =========================================================================
    match /contratos_formalizacion/{contratoId} {
      function inmuebleContratoCoherente(d) {
        return 'inmuebleId' in d && d.inmuebleId is string
          && 'propietarioId' in d && d.propietarioId is string
          && exists(/databases/$(database)/documents/inmuebles/$(d.inmuebleId))
          && ((('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data)
              && get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data.propietarioId == d.propietarioId)
            || (!('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data)
              && 'propietarioPrincipalId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data
              && get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data.propietarioPrincipalId == d.propietarioId));
      }
      function contratoParcialVisible(d) {
        return inmuebleContratoCoherente(d)
          && inmuebleParcialIndexado(d.propietarioId, d.inmuebleId, false);
      }
      function contratoParcialEscritura(d) {
        return inmuebleContratoCoherente(d)
          && inmuebleParcialIndexado(d.propietarioId, d.inmuebleId, true);
      }
      function inmuebleYTitularInmutables() {
        return 'inmuebleId' in existing() && 'inmuebleId' in incoming()
          && incoming().inmuebleId == existing().inmuebleId
          && 'propietarioId' in existing() && 'propietarioId' in incoming()
          && incoming().propietarioId == existing().propietarioId;
      }

      // get (documento concreto): titularidad directa, cartera o relación parcial por inmueble.
      // BLOQUE E (D-1): el inquilino lee (get) SOLO un contrato incluido en su
      // `contratoIds`; nunca `list` (sigue restringido a master/propietario).
      // D2 (§2 — dependientes dentro del mismo ámbito): las ramas de cartera
      // (mismo patrón que pólizas/siniestros) cubren al gestor multicartera:
      // lectura sobre carterasL ∪ carterasE, escritura solo sobre carterasE
      // (ACTIVA + LECTURA_ESCRITURA). Revocación = espejo vacío = deny.
      allow get: if isMasterAdmin() || (isPropietarioRole() && contratoVisible(existing())) || (isTenant() && tenantTieneContrato(contratoId)) || inmuebleEnCarteraGestionada(existing()) || contratoParcialVisible(existing());
      // list (consulta): OBLIGA a where('propietarioId','==', pid) pid-a-pid
      // (propio o de cada cartera gestionada; el gestor une N consultas).
      allow list: if isMasterAdmin() || (isPropietarioRole() && contratoEsMio(resource.data)) || inmuebleEnCarteraGestionada(resource.data) || contratoParcialVisible(resource.data);

      // El propietario sólo puede crear contratos a su nombre y con propietarioId.
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && inmuebleContratoCoherente(incoming())
      ) || (
        activeUser()
        && 'propietarioId' in incoming() && carterasEscritura().hasAny([incoming().propietarioId])
        && inmuebleContratoCoherente(incoming())
      ) || contratoParcialEscritura(incoming());

      // No puede mover un contrato a otro propietario ni tocar contratos ajenos.
      // BLOQUE E (reconciliado): el inquilino solo añade IDs a los índices de
      // capacidad (incidenciaIds, mensajeIds) de SUS contratos vinculados.
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && inmuebleYTitularInmutables() && inmuebleContratoCoherente(incoming())
      ) || (
        inmuebleEnCarteraEscritura(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && inmuebleYTitularInmutables() && inmuebleContratoCoherente(incoming())
      ) || contratoParcialEscritura(incoming()) && inmuebleYTitularInmutables() && inmuebleContratoCoherente(existing()) || (
        isTenant()
        && tenantTieneContrato(contratoId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['incidenciaIds', 'mensajeIds', 'fechaActualizacion'])
        && indiceInmutableOCrece('incidenciaIds')
        && indiceInmutableOCrece('mensajeIds')
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2B. GASTOS (FASE 2.0 — explotación vs financiación hipotecaria)
    // Datos económicos privados: mismo aislamiento por propietarioId que los
    // contratos. Los profesionales no tienen ninguna regla permitida (deny).
    // =========================================================================
    match /gastos/{gastoId} {
      // D2 (§2): ramas de cartera — mismo patrón y garantías que contratos.
      allow get: if isMasterAdmin() || (isPropietarioRole() && gastoVisible(existing())) || inmuebleEnCarteraGestionada(existing());
      // list OBLIGA a where('propietarioId','==', pid) pid-a-pid (propio o cartera).
      allow list: if isMasterAdmin() || (isPropietarioRole() && gastoEsMio(resource.data)) || inmuebleEnCarteraGestionada(resource.data);

      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
      ) || (
        activeUser()
        && 'propietarioId' in incoming() && carterasEscritura().hasAny([incoming().propietarioId])
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
      );

      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) || (
        inmuebleEnCarteraEscritura(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2C. PLANTILLAS DE GASTOS RECURRENTES (FASE 2.2)
    // Mismo aislamiento por propietarioId que los gastos/contratos.
    // =========================================================================
    match /gastos_recurrentes/{plantillaId} {
      // D2 (§2): ramas de cartera — mismo patrón y garantías que contratos.
      allow get: if isMasterAdmin() || (isPropietarioRole() && gastoVisible(existing())) || inmuebleEnCarteraGestionada(existing());
      allow list: if isMasterAdmin() || (isPropietarioRole() && gastoEsMio(resource.data)) || inmuebleEnCarteraGestionada(resource.data);

      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
      ) || (
        activeUser()
        && 'propietarioId' in incoming() && carterasEscritura().hasAny([incoming().propietarioId])
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
      );

      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) || (
        inmuebleEnCarteraEscritura(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2D. PRÉSTAMOS / HIPOTECAS (FASE 2.3 — condiciones financieras)
    // Mismo aislamiento por propietarioId que gastos/contratos.
    // =========================================================================
    match /prestamos/{prestamoId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && gastoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && gastoEsMio(resource.data));

      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
      );

      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2E. RECOMERCIALIZACIÓN (FASE 3.0)
    // Expedientes, propuestas (RFP) y leads: datos del propietario aislados por
    // propietarioId (patrón de contratos/gastos). Profesionales sin acceso.
    // =========================================================================
    match /expedientes_recomercializacion/{expedienteId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    match /propuestas_inmobiliaria/{propuestaId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    match /leads_inmobiliario/{leadId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // Directorio de inmobiliarias: lo consultan administrador y propietarios
    // (bolsa para delegar/comparar). La escritura (alta/verificación de una
    // agencia) queda reservada al administrador; profesionales sin acceso.
    // Cuando exista el rol de agencia se ampliará para que editen su ficha.
    match /inmobiliarias_directorio/{inmobiliariaId} {
      allow get, list: if isMasterAdmin() || isPropietarioRole();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // 2F. INCIDENCIAS Y MANTENIMIENTO (BLOQUE 4)
    // Datos operativos del propietario, aislados por propietarioId (patrón de
    // contratos/gastos). El profesional puede LEER únicamente las incidencias
    // que le han sido asignadas (la consulta obliga a
    // where('profesionalAsignadoId','==', suId)); no puede escribir.
    // =========================================================================
    match /incidencias/{incidenciaId} {
      // BLOQUE E (reconciliado): el inquilino lee (get) las incidencias de SUS
      // contratos, crea las suyas (origen INQUILINO, estado ABIERTA) y solo
      // aporta evidencias (listas append-only). Nunca lista ni borra.
      // D2 (§2 — orden §3: el gestor opera incidencias de su cartera):
      // ramas de cartera con el mismo patrón que pólizas/contratos.
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && aisladoVisible(existing()))
        || incidenciaAsignadaAmi(existing())
        || inmuebleEnCarteraGestionada(existing())
        || (isTenant() && (
          (('contratoId' in existing()) && tenantTieneContrato(existing().contratoId)) ||
          tenantVeContratos(campoListaActual('contratoIdsVisibles'))
        ));
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && aisladoEsMio(resource.data))
        || (isProfesionalRole()
          && 'profesionalAsignadoId' in resource.data
          && resource.data.profesionalAsignadoId == myProfId())
        || inmuebleEnCarteraGestionada(resource.data);
      allow create: if isMasterAdmin() || aisladoCreateOk()
        || (activeUser()
          && 'propietarioId' in incoming() && carterasEscritura().hasAny([incoming().propietarioId])
          && 'inmuebleId' in incoming() && incoming().inmuebleId is string)
        || (isTenant() &&
        incoming().contratoId is string &&
        tenantTieneContrato(incoming().contratoId) &&
        incoming().inmuebleId is string &&
        incoming().origen == 'INQUILINO' &&
        incoming().estado == 'ABIERTA' &&
        incoming().titulo is string && incoming().titulo.size() >= 3 &&
        incoming().descripcion is string && incoming().descripcion.size() >= 10 &&
        (!('contratoIdsVisibles' in incoming()) || incoming().contratoIdsVisibles == [incoming().contratoId])
      );
      allow update: if isMasterAdmin() || aisladoUpdateOk()
        || (inmuebleEnCarteraEscritura(existing())
          && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId)
        || (isTenant() &&
        (('contratoId' in existing()) && tenantTieneContrato(existing().contratoId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fotografias', 'documentos', 'fechaActualizacion']) &&
        listaSoloCrece('fotografias') &&
        listaSoloCrece('documentos'));
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // Plan de mantenimiento preventivo: estrictamente propietario/admin; los
    // profesionales no lo consultan (sólo reciben la incidencia resultante).
    match /tareas_mantenimiento/{tareaId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2G. GARANTÍAS DE REPARACIÓN Y SEGUIMIENTO POST-INTERVENCIÓN
    // =========================================================================
    match /garantias_reparacion/{garantiaId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && aisladoVisible(existing()))
        || (isProfesionalRole() && 'profesionalId' in existing() && existing().profesionalId == myProfId());
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && aisladoEsMio(resource.data))
        || (isProfesionalRole() && 'profesionalId' in resource.data && resource.data.profesionalId == myProfId());
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2H. ÓRDENES DE TRABAJO PROFESIONAL (FASE 4 - EJECUCIÓN TÉCNICA)
    // El propietario gestiona sus inmuebles. El profesional solo accede a sus
    // trabajos asignados (profesionalId == myProfId()). Inmutabilidad de propietarioId e inmuebleId.
    // =========================================================================
    match /trabajos_profesionales/{trabajoId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && aisladoVisible(existing()))
        || (isProfesionalRole() && 'profesionalId' in existing() && existing().profesionalId == myProfId());
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && aisladoEsMio(resource.data))
        || (isProfesionalRole() && 'profesionalId' in resource.data && resource.data.profesionalId == myProfId());
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin()
        || (aisladoUpdateOk())
        || (isProfesionalRole()
          && 'profesionalId' in existing() && existing().profesionalId == myProfId()
          && 'profesionalId' in incoming() && incoming().profesionalId == myProfId()
          && (!('propietarioId' in existing()) || ('propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId))
          && (!('inmuebleId' in existing()) || ('inmuebleId' in incoming() && incoming().inmuebleId == existing().inmuebleId)));
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2I. PRESUPUESTOS DE PROFESIONALES (FASE 4 - COMPARATIVA Y ADJUDICACIÓN)
    // =========================================================================
    match /presupuestos_profesionales/{presupuestoId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && aisladoVisible(existing()))
        || (isProfesionalRole() && 'profesionalId' in existing() && existing().profesionalId == myProfId());
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && aisladoEsMio(resource.data))
        || (isProfesionalRole() && 'profesionalId' in resource.data && resource.data.profesionalId == myProfId());
      allow create: if isMasterAdmin() || aisladoCreateOk() || (isProfesionalRole() && 'profesionalId' in incoming() && incoming().profesionalId == myProfId());
      allow update: if isMasterAdmin() || aisladoUpdateOk() || (
        isProfesionalRole()
        && 'profesionalId' in existing() && existing().profesionalId == myProfId()
        && 'profesionalId' in incoming() && incoming().profesionalId == myProfId()
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2I-bis. VALORACIONES DE TRABAJOS PROFESIONALES (§10.9 — regla restaurada
    // y endurecida). La regla histórica (`isSignedIn()`) NO se recupera.
    // Aislamiento por propietarioId (mismo patrón que 2H/2I): el propietario
    // solo lee las valoraciones con propietarioId == myPropId() y su consulta
    // OBLIGA a where('propietarioId','==', mi propietarioId). La creación se
    // valida contra el trabajo valorado (trabajos_profesionales): debe existir,
    // pertenecer al propietario y el inmuebleId debe coincidir con el del
    // trabajo. `usuarioId` es trazabilidad, nunca autorización. PROFESIONAL sin
    // acceso (sin consumidor montado); INQUILINO/anónimo: deny-by-default.
    // =========================================================================
    match /valoraciones_profesionales/{valoracionId} {
      function trabajoExiste(d) {
        return 'trabajoId' in d && d.trabajoId is string
          && exists(/databases/$(database)/documents/trabajos_profesionales/$(d.trabajoId));
      }
      function trabajoDe(d) {
        return get(/databases/$(database)/documents/trabajos_profesionales/$(d.trabajoId)).data;
      }
      function trabajoEsMio(d) {
        return trabajoExiste(d)
          && 'propietarioId' in trabajoDe(d)
          && trabajoDe(d).propietarioId == myPropId();
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(existing()));
      // list: única condición demostrable por la consulta where('propietarioId','==', myPropId()).
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && trabajoEsMio(incoming())
        && 'profesionalId' in incoming() && incoming().profesionalId is string
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
        && 'inmuebleId' in trabajoDe(incoming())
        && incoming().inmuebleId == trabajoDe(incoming()).inmuebleId
      );
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 2J. REFORMAS: NECESIDADES Y PROYECTOS DE REFORMA
    // Datos patrimoniales del propietario, aislados por propietarioId. El
    // profesional asignado accede únicamente a su proyecto de reforma asignado.
    // Inmutabilidad estricta de propietarioId e inmuebleId.
    // =========================================================================
    match /necesidades_reforma/{necesidadId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    match /proyectos_reforma/{proyectoId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && aisladoVisible(existing()))
        || (isProfesionalRole() && 'profesionalPrincipalId' in existing() && existing().profesionalPrincipalId == myProfId());
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && aisladoEsMio(resource.data))
        || (isProfesionalRole() && 'profesionalPrincipalId' in resource.data && resource.data.profesionalPrincipalId == myProfId());
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin()
        || (aisladoUpdateOk())
        || (isProfesionalRole()
          && 'profesionalPrincipalId' in existing() && existing().profesionalPrincipalId == myProfId()
          && 'profesionalPrincipalId' in incoming() && incoming().profesionalPrincipalId == myProfId()
          && (!('propietarioId' in existing()) || ('propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId))
          && (!('inmuebleId' in existing()) || ('inmuebleId' in incoming() && incoming().inmuebleId == existing().inmuebleId)));
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 2K. INVENTARIO Y HABITACIONES DEL INMUEBLE (ARENA C)
    // Aislados estrictamente por inmueble/propietario.
    // =========================================================================
    match /inventario_inmuebles/{inventarioId} {
      // D2 (H-fuga): `allow list: if isMasterAdmin() || isPropietarioRole()`
      // exponía el inventario de TODAS las carteras a cualquier propietario.
      // El list queda acotado al mismo ámbito que el get (titularidad por
      // propietarioId o membresía explícita por inmuebleIds): las consultas
      // `where('inmuebleId','==', id)` del cliente siguen demostrables y los
      // documentos fuera del ámbito quedan excluidos (fail-closed).
      allow get: if isMasterAdmin() || (isPropietarioRole() && (
        ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
        ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
      ));
      allow list: if isMasterAdmin() || (isPropietarioRole() && (
        ('propietarioId' in resource.data && resource.data.propietarioId == myPropId()) ||
        ('inmuebleId' in resource.data && myInmuebleIds().hasAny([resource.data.inmuebleId]))
      ));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && incoming().keys().hasAll(['inmuebleId', 'nombre', 'categoria', 'estado'])
        && (
          myInmuebleIds().hasAny([incoming().inmuebleId]) ||
          ('propietarioId' in incoming() && incoming().propietarioId == myPropId())
        )
      );
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && (
          ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
          ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
        )
        && incoming().inmuebleId == existing().inmuebleId
        && (!('propietarioId' in incoming()) || !('propietarioId' in existing()) || incoming().propietarioId == existing().propietarioId)
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && (
          ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
          ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
        )
      );
    }

    match /inventario_historial/{histId} {
      // D2 (H-fuga): mismo endurecimiento que inventario_inmuebles.
      allow get: if isMasterAdmin() || (isPropietarioRole() && (
        ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
        ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
      ));
      allow list: if isMasterAdmin() || (isPropietarioRole() && (
        ('propietarioId' in resource.data && resource.data.propietarioId == myPropId()) ||
        ('inmuebleId' in resource.data && myInmuebleIds().hasAny([resource.data.inmuebleId]))
      ));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'inmuebleId' in incoming()
        && (
          myInmuebleIds().hasAny([incoming().inmuebleId]) ||
          ('propietarioId' in incoming() && incoming().propietarioId == myPropId())
        )
      );
      allow update, delete: if false;
    }

    match /habitaciones_inmueble/{habitacionId} {
      function habitacionParcialCoherente(d, escritura) {
        return 'inmuebleId' in d && d.inmuebleId is string
          && 'propietarioId' in d && d.propietarioId is string
          && exists(/databases/$(database)/documents/inmuebles/$(d.inmuebleId))
          && ((('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data)
              && get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data.propietarioId == d.propietarioId)
            || (!('propietarioId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data)
              && 'propietarioPrincipalId' in get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data
              && get(/databases/$(database)/documents/inmuebles/$(d.inmuebleId)).data.propietarioPrincipalId == d.propietarioId))
          && inmuebleParcialIndexado(d.propietarioId, d.inmuebleId, escritura);
      }
      // D2 (H-fuga): mismo endurecimiento que inventario_inmuebles.
      allow get: if isMasterAdmin() || habitacionParcialCoherente(existing(), false) || (isPropietarioRole() && (
        ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
        ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
      ));
      allow list: if isMasterAdmin() || habitacionParcialCoherente(resource.data, false) || (isPropietarioRole() && (
        ('propietarioId' in resource.data && resource.data.propietarioId == myPropId()) ||
        ('inmuebleId' in resource.data && myInmuebleIds().hasAny([resource.data.inmuebleId]))
      ));
      allow create: if isMasterAdmin() || (habitacionParcialCoherente(incoming(), true) && incoming().id == habitacionId) || (
        isPropietarioRole()
        && incoming().keys().hasAll(['inmuebleId', 'nombre', 'estado'])
        && (
          myInmuebleIds().hasAny([incoming().inmuebleId]) ||
          ('propietarioId' in incoming() && incoming().propietarioId == myPropId())
        )
      );
      allow update: if isMasterAdmin() || (
        habitacionParcialCoherente(existing(), true)
        && habitacionParcialCoherente(incoming(), true)
        && existing().id == habitacionId && incoming().id == existing().id
        && incoming().inmuebleId == existing().inmuebleId
        && incoming().propietarioId == existing().propietarioId
      ) || (
        isPropietarioRole()
        && (
          ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
          ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
        )
        && incoming().inmuebleId == existing().inmuebleId
        && (!('propietarioId' in incoming()) || !('propietarioId' in existing()) || incoming().propietarioId == existing().propietarioId)
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && (
          ('propietarioId' in existing() && existing().propietarioId == myPropId()) ||
          ('inmuebleId' in existing() && myInmuebleIds().hasAny([existing().inmuebleId]))
        )
      );
    }

    // =========================================================================
    // 2L. PÓLIZAS DE SEGURO Y SINIESTROS (ARENA D)
    // Aislados por propietarioId.
    // BLOQUE 1: el gestor accede con el mismo alcance que sobre los inmuebles
    // de la cartera (D2a/D2b/D3): lectura carterasL∪carterasE, escritura SOLO
    // carterasE y sin cambiar la titularidad (propietarioId inmutable para el
    // gestor). El borrado sigue reservado a master/titular. Sin bypass global.
    // =========================================================================
    match /polizas_seguros/{polizaId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()))
        || inmuebleEnCarteraGestionada(existing());
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data))
        || inmuebleEnCarteraGestionada(resource.data);
      allow create: if isMasterAdmin() || aisladoCreateOk()
        || (activeUser() && 'propietarioId' in incoming()
            && carterasEscritura().hasAny([incoming().propietarioId]));
      allow update: if isMasterAdmin() || aisladoUpdateOk()
        || (inmuebleEnCarteraEscritura(existing())
            && 'propietarioId' in incoming()
            && incoming().propietarioId == existing().propietarioId);
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    match /siniestros/{siniestroId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()))
        || inmuebleEnCarteraGestionada(existing());
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data))
        || inmuebleEnCarteraGestionada(resource.data);
      allow create: if isMasterAdmin() || aisladoCreateOk()
        || (activeUser() && 'propietarioId' in incoming()
            && carterasEscritura().hasAny([incoming().propietarioId]));
      allow update: if isMasterAdmin() || aisladoUpdateOk()
        || (inmuebleEnCarteraEscritura(existing())
            && 'propietarioId' in incoming()
            && incoming().propietarioId == existing().propietarioId);
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // =========================================================================
    // 3. CANDIDATOS (expedientes y cuestionarios)
    // El listado y la gestión requieren cuenta interna. Se conserva el enlace
    // público de cuestionario (autoservicio del candidato por token), que sólo
    // puede tocar un conjunto acotado de campos.
    // =========================================================================
    match /candidatos/{candidatoId} {
      // get permanece accesible por el enlace de cuestionario por token.
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isSignedIn() || (
        incoming().keys().hasAll(['nombre', 'email', 'telefono', 'estado'])
        && incoming().nombre is string
        && incoming().nombre.size() > 0
      );
      // D2 (§7.4): el update/delete global ya no es `isSignedIn()` (cualquier
      // cuenta, incluido un inquilino, modificaba PII ajena) sino `isStaff()`.
      // La rama anónima del cuestionario/documentación queda intacta.
      allow update: if isStaff() || (
        // Candidato respondiendo su cuestionario / aportando documentación
        incoming().diff(existing()).affectedKeys().hasAny([
          'cuestionarioIncidencias',
          'cuestionarioToken',
          'fechaCuestionario',
          'estado',
          'documentosAnalizados',
          'notasAdicionales',
          'ingresosMensuales',
          'antiguedadAnos',
          'tipoContrato',
          'empresa',
          'numInquilinos',
          'tieneMascotas'
        ])
      );
      allow delete: if isStaff();
    }

    // =========================================================================
    // 4. SOLICITUDES DE ALQUILER (creación pública de captación)
    // =========================================================================
    match /solicitudes/{solicitudId} {
      // BLOQUE E (reconciliado): el inquilino no lee solicitudes (el alta sigue siendo pública).
      allow read: if isStaff();
      allow create: if incoming().keys().hasAll(['nombre', 'email', 'telefono', 'inmuebleId', 'estado'])
        && incoming().nombre is string
        && incoming().email is string;
      // D2 (§7.4): `isSignedIn()` → `isStaff()` (ver candidatos).
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // 5. INVITACIONES DE VISITA (confirmación/reserva pública por token)
    // DELTA-C (FASE 8B): validación de forma adaptada de C. El personal
    // autenticado conserva el acceso; el anónimo queda acotado a las formas
    // del flujo público (reserva/apertura: status, bookedAt, reserva,
    // confirmado, openedAt). Validación de campos ≠ aislamiento completo.
    // =========================================================================
    match /invitaciones/{invitacionId} {
      allow read: if true;
      allow create: if isSignedIn() || (
        incoming().keys().hasAll(['inmuebleId', 'status'])
        && incoming().keys().hasAny(['candidatoId', 'candidateId'])
        && incoming().status is string
      );
      // D2 (§7.4): `isSignedIn()` → `isStaff()`; la rama anónima de reserva
      // (status/bookedAt/reserva/confirmado/openedAt) queda intacta.
      allow update: if isStaff() || (
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'bookedAt', 'reserva', 'confirmado', 'openedAt'])
        && (!('status' in incoming()) || incoming().status is string)
        && (!('reserva' in incoming()) || incoming().reserva is map)
      );
      allow delete: if isStaff();
    }

    // =========================================================================
    // 6. TURNOS / SLOTS DE VISITA (reserva atómica pública)
    // DELTA-C (FASE 8C): validación de forma adaptada de C (reserva atómica:
    // disponible + vínculo de reserva). Autenticado intacto; anónimo acotado.
    // =========================================================================
    match /slots_visita/{slotId} {
      allow read: if true;
      allow create: if isSignedIn() || (
        incoming().keys().hasAll(['inmuebleId', 'fecha', 'horaInicio', 'horaFin'])
        && incoming().fecha is string && incoming().horaInicio is string && incoming().horaFin is string
      );
      // D2 (§7.4): `isSignedIn()` → `isStaff()`; la rama anónima de reserva
      // atómica (disponible/reserva*) queda intacta.
      allow update: if isStaff() || (
        incoming().diff(existing()).affectedKeys().hasAny(['disponible', 'reservaCandidateId', 'reservaCandidateNombre', 'reservaInvitationId'])
        && (!('disponible' in incoming()) || incoming().disponible is bool)
      );
      allow delete: if isStaff();
    }

    // =========================================================================
    // 7. SOLICITUDES DE DOCUMENTACIÓN POST-VISITA (portal público por token)
    // DELTA-C (FASE 8D): validación de forma adaptada de C, extendida con los
    // campos que el portal anónimo de main escribe realmente
    // (`fechaUltimaActividad`, `historial`) y con `token` (nombre del campo en
    // el modelo de main) además de `tokenDoc` (nombre en C). Autenticado
    // intacto; anónimo acotado a la aportación documental.
    // =========================================================================
    match /solicitudes_documentacion/{solicitudDocId} {
      allow read: if true;
      allow create: if isSignedIn() || (
        incoming().keys().hasAll(['candidatoId', 'inmuebleId'])
        && incoming().keys().hasAny(['tokenDoc', 'token'])
      );
      // D2 (§7.4): `isSignedIn()` → `isStaff()`; la rama anónima de
      // aportación documental queda intacta.
      allow update: if isStaff() || (
        incoming().diff(existing()).affectedKeys().hasAny(['documentos', 'estado', 'fechaAportacion', 'comentariosCandidato', 'todosAportados', 'fechaUltimaActividad', 'historial'])
        && (!('estado' in incoming()) || incoming().estado is string)
      );
      allow delete: if isStaff();
    }

    // =========================================================================
    // 8. CONFIGURACIÓN DE ASEGURADORAS (sólo uso interno)
    // =========================================================================
    match /configuracion_aseguradoras/{aseguradoraId} {
      // BLOQUE E (reconciliado): configuración interna, oculta al inquilino.
      allow read: if isStaff();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // 9. SOLICITUDES DE SEGURO DE IMPAGO (uso interno)
    // =========================================================================
    match /solicitudes_seguro_impago/{solicitudSeguroId} {
      // BLOQUE E (reconciliado): el inquilino no accede a solicitudes de seguro.
      // D3 (§9): `isStaff()` global ⇒ ámbito derivado inmueble → propietario
      // (+carteras, +admin). El borrado queda en el ámbito de escritura.
      allow get: if 'inmuebleId' in existing() && ambitoPorInmuebleLectura(existing().inmuebleId);
      allow list: if 'inmuebleId' in resource.data && ambitoPorInmuebleLectura(resource.data.inmuebleId);
      allow create: if 'inmuebleId' in incoming() && ambitoPorInmuebleEscritura(incoming().inmuebleId);
      allow update: if (('inmuebleId' in existing() && 'inmuebleId' in incoming())
        && ambitoPorInmuebleEscritura(existing().inmuebleId) && ambitoPorInmuebleEscritura(incoming().inmuebleId));
      allow delete: if 'inmuebleId' in existing() && ambitoPorInmuebleEscritura(existing().inmuebleId);
    }

    // =========================================================================
    // 10. CONFIGURACIÓN DEL SISTEMA
    // =========================================================================
    match /system/{systemDocId} {
      // Los flags de módulos son necesarios antes de iniciar sesión.
      // BLOQUE E (reconciliado): el inquilino no lee gmail_config/metadata.
      allow read: if systemDocId == 'modulos_config' || isStaff();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // 11. USUARIOS Y CONTROL DE ACCESO (PROTECCIÓN ESTRICTA CONTRA ELEVACIÓN)
    // =========================================================================
    match /usuarios/{usuarioId} {
      // R02: conocer un ID, tener rol o ser staff NO autoriza a leer una cuenta.
      // Antes del primer binding, el correo verificado identifica al titular de
      // SU ficha precreada. No permite listar, activar ni leer datos fiscales.
      allow get: if isMasterAdmin() || (isSignedIn() && (
        (('authUid' in resource.data) && resource.data.authUid == request.auth.uid) ||
        (!('authUid' in resource.data) && request.auth.token.email_verified == true
          && resource.data.email == authEmail()
          && ((resource.data.tipoPerfil == 'PROPIETARIO' && resource.data.estado == 'PENDIENTE')
            || ('enlaceRegistroId' in resource.data
              && exists(/databases/$(database)/documents/enlaces_registro/$(resource.data.enlaceRegistroId))
              && getEnlaceE(resource.data.enlaceRegistroId).usuarioIdVinculado == usuarioId
              && getEnlaceE(resource.data.enlaceRegistroId).emailInvitado == authEmail()
              && getEnlaceE(resource.data.enlaceRegistroId).activo == true)))
      ));
      allow list: if isMasterAdmin();
      // BLOQUE E (reconciliado): la cuenta INQUILINO solo nace de invitación activa
      // vinculada a su contrato (además del alta canónica PROPIETARIO/PROFESIONAL).
      allow create: if (isMasterAdmin() && usuarioPersonaCoherente(usuarioId, incoming())
        && auditoriaVinculada(incoming(), 'usuarios/' + usuarioId)) || (
        isSignedIn() && !isMasterAdmin()
        && incoming().authUid == request.auth.uid
        && incoming().email == authEmail()
        && (!('permisos' in incoming()) || (incoming().permisos is list &&
          ((incoming().tipoPerfil == 'PROPIETARIO' && incoming().permisos.hasOnly([
            'inmuebles.ver','inmuebles.editar','contratos.ver','profesionales.ver',
            'profesionales.crear','profesionales.asignar'])) ||
           (incoming().tipoPerfil == 'PROFESIONAL' && incoming().permisos.hasOnly(['profesionales.ver'])) ||
           (incoming().tipoPerfil == 'INQUILINO' && incoming().permisos.hasOnly(['inmuebles.ver','contratos.ver'])))))
        && !incoming().keys().hasAny(['isStaff','isTenant','gestionesPorPropietario','carterasL','carterasE'])
        && !('personaId' in incoming())
        && !('roadmap01AuditId' in incoming())
        && (!('roles' in incoming()) || !incoming().roles.hasAny(['SUPERADMIN', 'ADMINISTRADOR', 'GESTOR_INMUEBLES']))
        && incoming().estado in ['ACTIVO', 'PENDIENTE']
        && (
          // INTEGRACIÓN PR4 (2026-09-25): se conserva la rama canónica de
          // autorregistro (la exige fase14 C.1 y la usan las invitaciones
          // genéricas, que escriben permisos por defecto del rol). El alta
          // autónoma (registerAutonomo) también satisface esta rama.
          // El email Auth, permisos por perfil y ficha profesional existente
          // se validan arriba; los permisos por ámbito siguen gobernados
          // exclusivamente por las reglas D2/D3 y no por roles descriptivos.
          (incoming().tipoPerfil in ['PROPIETARIO', 'PROFESIONAL']
            && (incoming().tipoPerfil != 'PROFESIONAL' || profesionalExistenteInvitado(incoming()))
            && (
              incoming().tipoPerfil == 'PROFESIONAL'
              || !('propietarioId' in incoming())
              || !exists(/databases/$(database)/documents/propietarios/$(incoming().propietarioId))
            ))
          ||
          (incoming().tipoPerfil == 'INQUILINO'
            && incoming().contratoIds is list
            && incoming().contratoIds.size() >= 1
            && incoming().contratoIds.size() <= 5
            && ('enlaceRegistroId' in incoming())
            && enlaceInquilinoValido(incoming().enlaceRegistroId, incoming().contratoIds))
        )
      );

      allow update: if (isMasterAdmin()
        && auditoriaNueva(incoming(), existing(), 'usuarios/' + usuarioId)
        && usuarioPersonaCoherente(usuarioId, incoming())
        && (!('personaId' in existing()) || ('personaId' in incoming()) ||
          (existsAfter(/databases/$(database)/documents/personas/$(existing().personaId))
           && !('usuarioId' in getAfter(/databases/$(database)/documents/personas/$(existing().personaId)).data)))) || (
        isSignedIn() && !isMasterAdmin()
        // El documento pertenece a este UID (salvo que se esté enlazando por
        // primera vez un perfil sin authUid).
        && (
          !('authUid' in existing())
          || existing().authUid == request.auth.uid
          || usuarioId == request.auth.uid
        )
        // First binding is not a way to claim someone else's pending profile.
        && (('authUid' in existing()) || (
          request.auth.token.email_verified == true
          && existing().email == authEmail() && incoming().authUid == request.auth.uid
          && (existing().estado != 'PENDIENTE' || incoming().estado == 'ACTIVO')))
        && incoming().tipoPerfil == existing().tipoPerfil
        && incoming().roles == existing().roles
        // ROADMAP-01: una identidad Persona explícita no permite cambiar el
        // UID asociado a su perfil; los perfiles legacy sin personaId siguen
        // usando el flujo de re-enlace de fase14. Primera activación nominal
        // PENDIENTE exige el UID propio y el email del invitado más abajo.
        && (!('personaId' in existing()) ||
            (('authUid' in existing() && incoming().authUid == existing().authUid) ||
             (!('authUid' in existing()) && incoming().authUid == request.auth.uid)))
        // ACCESO-PROPIETARIOS: el estado es inmutable salvo la activación
        // nominal — el titular del email invitado, tras crear su cuenta Auth
        // con ese email, activa su ficha PENDIENTE al vincular su UID por
        // primera vez. No puede re-activar, escalar ni tocar identidad,
        // vínculos o permisos (claves vetadas más abajo).
        && (
          incoming().estado == existing().estado
          || (
            !('authUid' in existing())
            && existing().estado == 'PENDIENTE'
            && incoming().estado == 'ACTIVO'
            && auditoriaNueva(incoming(), existing(), 'usuarios/' + usuarioId)
            && incoming().authUid == request.auth.uid
            && existing().email is string
            && request.auth.token.email == existing().email
            && 'propietarioId' in existing()
            && 'enlaceRegistroId' in incoming()
            && invitacionNominalVigente(incoming().enlaceRegistroId, usuarioId,
                 existing().propietarioId, existing().email)
            && getAfter(/databases/$(database)/documents/enlaces_registro/$(incoming().enlaceRegistroId)).data.usosActuales == 1
            && getAfter(/databases/$(database)/documents/enlaces_registro/$(incoming().enlaceRegistroId)).data.estadoInvitacion == 'ACEPTADA'
            && exists(/databases/$(database)/documents/propietarios/$(existing().propietarioId))
            && (!('personaId' in existing()) ||
               get(/databases/$(database)/documents/propietarios/$(existing().propietarioId)).data.personaId == existing().personaId)
          )
        )
        // El usuario no puede falsificar el último evento fuera de activación.
        && (incoming().estado != existing().estado || mismoCampoOpcional('roadmap01AuditId'))
        // El usuario no puede cambiar por sí mismo su identidad ni sus permisos.
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'permisos',
          'personaId',
          'propietarioId',
          'profesionalId',
          'inmuebleIds',
          'email',
          'createdAt',
          'passwordHash',
          // Campos de autorización/cartera pertenecen únicamente al espejo y
          // nunca deben aparecer en la ficha de usuario por escritura propia.
          'isStaff',
          'isTenant',
          'gestionesPorPropietario',
          'carterasL',
          'carterasE',
          // La marca de auditoría solo cambia en el commit de activación
          // nominal, no en actualizaciones ordinarias del titular.
          // BLOQUE E (reconciliado): el inquilino no puede auto-vincularse contratos
          'contratoIds'
        ])
        // INTEGRACIÓN PR4 (2026-09-25): `authUid` NO se inmoviliza aquí.
        // Lo exigen (a) fase14 C.2 —frontera deliberada: reescribir el propio
        // authUid no otorga nada porque la identidad que leen las reglas es
        // el espejo `usuarios_auth/{request.auth.uid}` con `indexIsTruthful()`
        // (el espejo solo se escribe en la ruta del propio UID)— y (b) el
        // cliente real `getUsuarioByAuthUid`, que re-vincula el authUid cuando
        // cambia la cuenta Auth del mismo email. La activación nominal
        // (fijar UID propio por primera vez + PENDIENTE→ACTIVO con email)
        // sigue permitida por las ramas de arriba. Vetar aquí la reescritura
        // rompería main (fase14) y el re-enlace legítimo, sin ganar seguridad
        // real: la cartera (propietarioId/inmuebleIds/permisos/roles) sigue
        // pinneada por los vetos de arriba.
      );

      allow delete: if false; // baja auditada revoca cuenta y espejo, preserva historial
    }

    // =========================================================================
    // 12. PROFESIONALES Y EMPRESAS DE MANTENIMIENTO
    // Catálogo legible durante el registro público; la escritura es interna.
    // =========================================================================
    match /profesionales/{profesionalId} {
      allow read: if true;
      // BLOQUE E (reconciliado): el inquilino no escribe en el catálogo.
      // INTEGRACIÓN PR4 (2026-09-25): se conserva la escritura staff
      // canónica (el propietario/gestor gestiona sus profesionales via
      // handleSaveProfesional; restringir update a master+ficha propia
      // rompería ese flujo). Re-endurecer exige una vía de delegación.
      allow create, update: if isStaff();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 13. ENLACES DE REGISTRO (lectura pública para validar el token)
    // =========================================================================
    match /enlaces_registro/{enlaceId} {
      allow get: if (esInvitacionGestion(resource.data) ? (isMasterAdmin() || destinatarioGestion(resource.data)) : (isSignedIn() || (isValidId(enlaceId) && resource.data.activo == true)));
      // Las invitaciones privadas tampoco se pueden extraer mediante list.
      // Los genéricos conservan su contrato; su query debe excluir R02.
      allow list: if isMasterAdmin() || (isStaff() && !('finalidad' in resource.data && resource.data.finalidad == 'ONBOARDING_CARTERA'));
      // El staff heredado puede gestionar enlaces genéricos, pero NO emitir,
      // cambiar ni borrar invitaciones nominales para una identidad ajena.
      allow create: if (isMasterAdmin() || (isStaff()
        && !('usuarioIdVinculado' in incoming())
        && !('propietarioIdVinculado' in incoming())
        && !('profesionalIdVinculado' in incoming())))
        && (!esInvitacionGestion(incoming()) || (isMasterAdmin() && incoming().id == enlaceId
          && incoming().estadoInvitacion == 'PENDIENTE' && incoming().activo == true
          && incoming().usosActuales == 0 && incoming().usosMaximos == 1
          && request.time.toMillis() < incoming().fechaCaducidadMs))
        && auditoriaVinculada(incoming(), 'enlaces_registro/' + enlaceId);
      // El master tampoco reabre, reescribe o borra el historial nominal.
      // Rechazo y revocación solo desde PENDIENTE no consumida; el servicio
      // escribe el audit_log en el mismo commit. El genérico conserva su flujo.
      allow delete: if false; // revocar sin purgar trazabilidad
      allow update: if (isMasterAdmin()
        && auditoriaNueva(incoming(), existing(), 'enlaces_registro/' + enlaceId) && !esInvitacionGestion(existing()) && !esInvitacionGestion(incoming()) && (
        (!('usuarioIdVinculado' in existing()) && !('usuarioIdVinculado' in incoming()))
        || ('usuarioIdVinculado' in existing()
          && existing().estadoInvitacion == 'PENDIENTE'
          && existing().activo == true && existing().usosActuales == 0
          && incoming().diff(existing()).affectedKeys().hasOnly(['estadoInvitacion', 'activo', 'roadmap01AuditId'])
          && incoming().estadoInvitacion in ['RECHAZADA', 'REVOCADA']
          && incoming().activo == false)
      )) || (
        isSignedIn() && !esInvitacionGestion(existing()) && !esInvitacionGestion(incoming()) && 'usuarioIdVinculado' in existing()
        && invitacionNominalVigente(enlaceId, existing().usuarioIdVinculado,
             existing().propietarioIdVinculado, authEmail())
        && incoming().diff(existing()).affectedKeys().hasOnly(['usosActuales', 'estadoInvitacion', 'roadmap01AuditId'])
        && auditoriaNueva(incoming(), existing(), 'enlaces_registro/' + enlaceId)
        && incoming().usosActuales == 1
        && incoming().estadoInvitacion == 'ACEPTADA'
        && getAfter(/databases/$(database)/documents/usuarios/$(existing().usuarioIdVinculado)).data.authUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(existing().usuarioIdVinculado)).data.estado == 'ACTIVO'
      ) || (
        isStaff() && !esInvitacionGestion(existing()) && !esInvitacionGestion(incoming()) && !('usuarioIdVinculado' in existing()) && !('usuarioIdVinculado' in incoming())
        && !('profesionalIdVinculado' in existing()) && !('propietarioIdVinculado' in existing())
        && !incoming().diff(existing()).affectedKeys().hasAny(['profesionalIdVinculado', 'propietarioIdVinculado'])
        && auditoriaNueva(incoming(), existing(), 'enlaces_registro/' + enlaceId)
      ) || (
        // BLOQUE E: inquilino solo consume su invitación genérica.
        isTenant() && !esInvitacionGestion(existing()) && !esInvitacionGestion(incoming()) && !('usuarioIdVinculado' in existing())
        && incoming().diff(existing()).affectedKeys().hasOnly(['usosActuales'])
        && incoming().usosActuales is number && existing().usosActuales is number
        && incoming().usosActuales == existing().usosActuales + 1
      ) || respuestaInvitacionGestion(enlaceId);
    }

    // =========================================================================
    // 14. CATÁLOGO DE ESPECIALIDADES (lectura pública en el registro)
    // =========================================================================
    match /especialidades/{especialidadId} {
      allow read: if true;
      // BLOQUE E (reconciliado): el inquilino no escribe en el catálogo.
      allow write: if isStaff();
    }

    // =========================================================================
    // 15. REGISTROS DE AUDITORÍA (INMUTABLE - SÓLO INSERCIÓN POR USUARIOS INTERNOS)
    // =========================================================================
    match /audit_logs/{auditId} {
      allow read: if isMasterAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // =========================================================================
    // 22. NOTIFICACIONES TRANSACCIONALES (GAP 1) — aislamiento por propietario.
    // =========================================================================
    match /notificaciones/{notificacionId} {
      function notifDelUsuario() {
        return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && (
          (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.propietarioId == resource.data.propietarioId) ||
          resource.data.inmuebleId in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.inmuebleIds
        );
      }
      function notifDelUsuarioIncoming() {
        return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && (
          (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.propietarioId == incoming().propietarioId) ||
          incoming().inmuebleId in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.inmuebleIds
        );
      }
      allow get: if isSignedIn() && (isMasterAdmin() || notifDelUsuario());
      // BLOQUE E (reconciliado): el inquilino no lista notificaciones GAP 1.
      allow list: if isStaff();
      allow create: if isSignedIn() && (isMasterAdmin() || notifDelUsuarioIncoming());
      allow update: if isSignedIn() && (isMasterAdmin() || (
        notifDelUsuario() &&
        incoming().propietarioId == resource.data.propietarioId &&
        incoming().inmuebleId == resource.data.inmuebleId
      ));
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 23. FINANCIACIÓN HIPOTECARIA (GAP 4) — aislamiento por propietario.
    // =========================================================================
    match /financiaciones/{financiacionId} {
      function sinSecretos() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'psd2' in incoming() ||
          'ibanSecreto' in incoming() ||
          'tokenBancario' in incoming()
        );
      }
      // D2 (H-fuga): el bloque comparaba `propietarioId` (id de ficha
      // `prop_xxx` de usuarios.propietarioId) con `request.auth.uid` (UID de
      // Auth): la comparación NUNCA coincidía (rotura funcional para el
      // titular) mientras `allow list: if isSignedIn()` exponía TODAS las
      // financiaciones a cualquier cuenta autenticada (fuga real cross-cartera
      // de datos hipotecarios). Se reescribe sobre `myPropId()` con el patrón
      // canónico (titular + master; la consulta obliga a
      // where('propietarioId','==', pid)). Sin ramas de cartera: la
      // financiación hipotecaria es personal del titular (fuera del §9 del
      // mandato y del alcance D1R §9). `sinSecretos()` intacto.
      allow get: if isMasterAdmin() || (isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId());
      allow list: if isMasterAdmin() || (isPropietarioRole()
        && 'propietarioId' in resource.data && resource.data.propietarioId == myPropId());
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'inmuebleId' in incoming() && incoming().inmuebleId is string
        && isValidId(incoming().inmuebleId)
      ) && sinSecretos();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && 'inmuebleId' in incoming() && 'inmuebleId' in existing()
        && incoming().inmuebleId == existing().inmuebleId
      ) && sinSecretos();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 24. CONCILIACIÓN BANCARIA AUTOMÁTICA (GAP 6) — aislamiento estricto propietario
    // - propietario inmutable
    // - no acceso cruzado
    // - no almacenamiento credenciales bancarias
    // - trazabilidad: propietario, inmueble, usuario/actor, estado
    // =========================================================================
    match /movimientos_bancarios/{movimientoId} {
      function movimientoEsMio(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function movimientoVisible(d) {
        return movimientoEsMio(d) || ('inmuebleId' in d && myInmuebleIds().hasAny([d.inmuebleId]));
      }
      function sinSecretosBancarios() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'psd2' in incoming() ||
          'ibanSecreto' in incoming() ||
          'tokenBancario' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming() ||
          'clave' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && movimientoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && movimientoEsMio(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'idMovimiento' in incoming() && incoming().idMovimiento is string
        && 'hashIdempotencia' in incoming()
      ) && sinSecretosBancarios();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) && sinSecretosBancarios();
      allow delete: if isMasterAdmin();
    }

    match /conciliaciones_bancarias/{conciliacionId} {
      function conciliacionEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function sinSecretosBancarios() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'psd2' in incoming() ||
          'ibanSecreto' in incoming() ||
          'tokenBancario' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && conciliacionEsMia(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && conciliacionEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'movimientoId' in incoming() && incoming().movimientoId is string
      ) && sinSecretosBancarios();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) && sinSecretosBancarios();
      allow delete: if isMasterAdmin();
    }

    match /importaciones_bancarias/{importacionId} {
      function importacionEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function sinSecretosBancarios() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'psd2' in incoming() ||
          'tokenBancario' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && importacionEsMia(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && importacionEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) && sinSecretosBancarios();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
      ) && sinSecretosBancarios();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 25. FACTURACIÓN Y VERI*FACTU (GAP 7) — aislamiento estricto por propietario
    // - propietario inmutable en facturas, registros y envíos
    // - registros de facturación (RRSIF) NO editables arbitrariamente: huella,
    //   importe/número/fecha/receptor protegidos tras la emisión
    // - sin secretos (certificados y credenciales AEAT jamás en Firestore)
    // - factura emitida y su registro protegidos más que el borrador
    // =========================================================================
    match /facturas/{facturaId} {
      function facturaEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function facturaVisible(d) {
        return facturaEsMia(d) || ('inmuebleId' in d && myInmuebleIds().hasAny([d.inmuebleId]));
      }
      function sinSecretosFacturacion() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'certificado' in incoming() ||
          'privateKey' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && facturaVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && facturaEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'id' in incoming() && incoming().id is string
      ) && sinSecretosFacturacion();
      // Una factura EMITIDA no puede renumerarse ni alterarse silenciosamente:
      // número/serie/ejercicio/fecha/propietario e importes quedan inmutables.
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && facturaEsMia(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && (
          !('estado' in existing()) || existing().estado != 'EMITIDA' || (
            incoming().numero == existing().numero
            && incoming().serie == existing().serie
            && incoming().ejercicio == existing().ejercicio
            && incoming().fechaExpedicion == existing().fechaExpedicion
            && incoming().importeTotal == existing().importeTotal
          )
        )
      ) && sinSecretosFacturacion();
      allow delete: if isMasterAdmin();
    }

    match /registros_facturacion/{registroId} {
      function registroEsMio(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function sinSecretosFacturacion() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'certificado' in incoming() ||
          'privateKey' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && registroEsMio(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && registroEsMio(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'facturaId' in incoming() && incoming().facturaId is string
        && 'huella' in incoming() && incoming().huella is string
      ) && sinSecretosFacturacion();
      // Inalterabilidad RRSIF: la huella y los campos hasheados jamás se tocan.
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && registroEsMio(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && incoming().huella == existing().huella
        && incoming().numSerieFactura == existing().numSerieFactura
        && incoming().fechaExpedicionFactura == existing().fechaExpedicionFactura
        && incoming().importeTotal == existing().importeTotal
        && incoming().idEmisorFactura == existing().idEmisorFactura
        && incoming().fechaHoraHusoGenRegistro == existing().fechaHoraHusoGenRegistro
      ) && sinSecretosFacturacion();
      allow delete: if isMasterAdmin();
    }

    match /envios_verifactu/{envioId} {
      function envioEsMio(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function sinSecretosFacturacion() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'certificado' in incoming() ||
          'privateKey' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming() ||
          'token' in incoming()
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && envioEsMio(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && envioEsMio(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'registroFacturacionId' in incoming() && incoming().registroFacturacionId is string
        && 'idempotencyKey' in incoming() && incoming().idempotencyKey is string
      ) && sinSecretosFacturacion();
      // Trazabilidad de envío: propietario y registro de facturación inmutables.
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && envioEsMio(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && incoming().registroFacturacionId == existing().registroFacturacionId
      ) && sinSecretosFacturacion();
      allow delete: if isMasterAdmin();
    }

    match /series_facturacion/{serieId} {
      function serieEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && serieEsMia(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && serieEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'codigo' in incoming() && incoming().codigo is string
        && 'ejercicio' in incoming() && incoming().ejercicio is int
      );
      // La correlación avanza solo hacia adelante (último número nunca decrece).
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && serieEsMia(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && incoming().codigo == existing().codigo
        && incoming().ejercicio == existing().ejercicio
        && (incoming().ultimoNumero is int) && incoming().ultimoNumero >= existing().ultimoNumero
      );
      allow delete: if isMasterAdmin();
    }
    // =========================================================================
    // 39. BLOQUE E (reconciliado): MENSAJES DEL PORTAL (hilo inquilino ↔ gestión por contrato)
    // Sin borrado: el hilo es el registro de comunicaciones.
    // =========================================================================
    match /mensajes_portal/{mensajeId} {
      // D3 (§9): ámbito derivado contrato → propietario (+carteras, +admin).
      // Ramas tenant intactas.
      allow get: if ('contratoId' in existing() && ambitoPorContratoLectura(existing().contratoId)) || (isTenant() &&
        ('contratoId' in resource.data) && tenantTieneContrato(resource.data.contratoId));
      allow list: if 'contratoId' in resource.data && ambitoPorContratoLectura(resource.data.contratoId);
      allow create: if ('contratoId' in incoming() && ambitoPorContratoEscritura(incoming().contratoId)) || (isTenant() &&
        incoming().contratoId is string &&
        tenantTieneContrato(incoming().contratoId) &&
        incoming().inmuebleId is string &&
        incoming().remitenteUid == request.auth.uid &&
        incoming().remitenteRol == 'INQUILINO' &&
        incoming().texto is string &&
        incoming().texto.size() >= 1 &&
        incoming().texto.size() <= 4000);
      // Gestión actualiza (acuse de lectura); el inquilino solo marca su propio acuse.
      allow update: if (('contratoId' in existing() && 'contratoId' in incoming())
        && ambitoPorContratoEscritura(existing().contratoId) && ambitoPorContratoEscritura(incoming().contratoId)) || (isTenant() &&
        ('contratoId' in existing()) && tenantTieneContrato(existing().contratoId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['leidoPorInquilino']));
      allow delete: if false;
    }

    // =========================================================================
    // 40. BLOQUE E (reconciliado): SUMINISTROS (CUPS/contador, titular, comercializadora, reparto)
    // El inquilino lee (get) los de su inmueble y solo añade IDs a los índices.
    // =========================================================================
    match /suministros/{suministroId} {
      // D3 (§9): `isStaff()` global ⇒ ámbito derivado
      // inmueble → propietario (+carteras, +admin). Ramas tenant intactas.
      // En `update`, existing Y incoming deben estar en ámbito (si el
      // inmueble cambia, ambos deben ser legítimos).
      allow get: if ('inmuebleId' in existing() && ambitoPorInmuebleLectura(existing().inmuebleId)) || (isTenant() &&
        tenantVeContratos(campoListaActual('contratoIdsAutorizados')));
      allow list: if 'inmuebleId' in resource.data && ambitoPorInmuebleLectura(resource.data.inmuebleId);
      allow create: if 'inmuebleId' in incoming() && ambitoPorInmuebleEscritura(incoming().inmuebleId);
      allow update: if (('inmuebleId' in existing() && 'inmuebleId' in incoming())
        && ambitoPorInmuebleEscritura(existing().inmuebleId) && ambitoPorInmuebleEscritura(incoming().inmuebleId)) || (isTenant() &&
        tenantVeContratos(campoListaActual('contratoIdsAutorizados')) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lecturaIds', 'cambioTitularIds', 'fechaActualizacion']) &&
        indiceInmutableOCrece('lecturaIds') &&
        indiceInmutableOCrece('cambioTitularIds'));
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 41. BLOQUE E (reconciliado): LECTURAS DE SUMINISTRO (INMUTABLES con trazabilidad)
    // Sin update ni delete: la corrección es una nueva lectura (corrigeLecturaId).
    // =========================================================================
    match /lecturas_suministro/{lecturaId} {
      // D3 (§9): ámbito derivado inmueble → propietario (+carteras, +admin).
      // Ramas tenant intactas; inmutabilidad intacta.
      allow get: if ('inmuebleId' in existing() && ambitoPorInmuebleLectura(existing().inmuebleId)) || (isTenant() &&
        ('contratoId' in resource.data) && tenantTieneContrato(resource.data.contratoId));
      allow list: if 'inmuebleId' in resource.data && ambitoPorInmuebleLectura(resource.data.inmuebleId);
      allow create: if ('inmuebleId' in incoming() && ambitoPorInmuebleEscritura(incoming().inmuebleId)) || (isTenant() &&
        incoming().contratoId is string &&
        tenantTieneContrato(incoming().contratoId) &&
        incoming().suministroId is string &&
        incoming().inmuebleId is string &&
        incoming().valor is number && incoming().valor >= 0 &&
        incoming().unidad is string &&
        incoming().fechaLectura is string &&
        incoming().origen == 'INQUILINO');
      allow update, delete: if false;
    }

    // =========================================================================
    // 42. BLOQUE E (reconciliado): CAMBIOS DE TITULARIDAD (solicita inquilino, resuelve gestión)
    // =========================================================================
    match /cambios_titular/{cambioId} {
      // D3 (§9): ámbito derivado inmueble → propietario (+carteras, +admin).
      // Ramas tenant intactas.
      allow get: if ('inmuebleId' in existing() && ambitoPorInmuebleLectura(existing().inmuebleId)) || (isTenant() &&
        ('contratoId' in resource.data) && tenantTieneContrato(resource.data.contratoId));
      allow list: if 'inmuebleId' in resource.data && ambitoPorInmuebleLectura(resource.data.inmuebleId);
      allow create: if ('inmuebleId' in incoming() && ambitoPorInmuebleEscritura(incoming().inmuebleId)) || (isTenant() &&
        incoming().contratoId is string &&
        tenantTieneContrato(incoming().contratoId) &&
        incoming().suministroId is string &&
        incoming().inmuebleId is string &&
        incoming().titularNuevoNombre is string &&
        incoming().titularNuevoNombre.size() >= 3 &&
        incoming().fechaEfecto is string &&
        incoming().estado == 'SOLICITADO');
      allow update: if (('inmuebleId' in existing() && 'inmuebleId' in incoming())
        && ambitoPorInmuebleEscritura(existing().inmuebleId) && ambitoPorInmuebleEscritura(incoming().inmuebleId));
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // GAP 8 — FACTURA ELECTRÓNICA B2B (RD 238/2026)
    // Colección propia y separada de facturas / registros_facturacion /
    // envios_verifactu: aislamiento total, deny-by-default global.
    // - propietarioId e id inmutables; facturaId e idempotencyKey inmutables
    // - tras el intercambio (ENVIADA+) la representación económica/documental
    //   queda inmovilizada: sin modificaciones silenciosas
    // - historial append-only (nunca se pierden eventos ya registrados)
    // - sin secretos: certificados/credenciales de plataformas jamás en Firestore
    // =========================================================================
    match /facturas_electronicas_b2b/{febId} {
      function febEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      function sinSecretosB2B() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'certificado' in incoming() ||
          'privateKey' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming() ||
          'token' in incoming()
        );
      }
      function estadoIntercambiado(d) {
        return ('estado' in d)
          && ['ENVIADA','RECIBIDA','ACEPTADA','RECHAZADA','PAGADA','PARCIALMENTE_PAGADA','ANULADA','RECTIFICADA'].hasAny([d.estado]);
      }
      function representacionInmovil() {
        return !estadoIntercambiado(existing()) || (
          incoming().baseImponible == existing().baseImponible
          && incoming().cuotaIva == existing().cuotaIva
          && incoming().cuotaRetencion == existing().cuotaRetencion
          && incoming().importeTotal == existing().importeTotal
          && incoming().numeroCompleto == existing().numeroCompleto
          && incoming().serie == existing().serie
          && incoming().numero == existing().numero
          && incoming().ejercicio == existing().ejercicio
          && incoming().formato == existing().formato
        );
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && febEsMia(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && febEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in incoming() && incoming().propietarioId == myPropId()
        && 'id' in incoming() && incoming().id is string && incoming().id == febId
        && 'facturaId' in incoming() && incoming().facturaId is string
        && 'idempotencyKey' in incoming() && incoming().idempotencyKey is string
        && 'estado' in incoming() && incoming().estado == 'GENERADA'
      ) && sinSecretosB2B();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && febEsMia(existing())
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && incoming().id == existing().id
        && incoming().facturaId == existing().facturaId
        && incoming().idempotencyKey == existing().idempotencyKey
        // historial append-only: nunca se elimina ni reescribe lo trazado
        && ('historial' in incoming()) && incoming().historial.size() >= existing().historial.size()
        && representacionInmovil()
      ) && sinSecretosB2B();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 26. LIQUIDACIONES DE PROPIETARIOS (BLOQUE B — tesorería, 2026-09-20)
    // - el propietario SOLO lee sus liquidaciones (aislamiento por propietarioId)
    // - crea/edita SOLO la administración (isMasterAdmin): el motor es
    //   determinista e idempotente (claveIdempotencia inmutable)
    // - historial append-only: nunca se elimina ni reescribe lo trazado
    // - NO hay borrado ordinario: la anulación/reversión (ANULADA/REVERSADA) es
    //   la vía; el delete queda reservado al administrador principal
    // - sin secretos en ningún campo
    // =========================================================================
    match /liquidaciones_propietarios/{liqId} {
      function liqEsMia(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && liqEsMia(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && liqEsMia(resource.data));
      allow create: if isMasterAdmin() && (
        isValidId(incoming().id) && incoming().id == liqId
        && 'propietarioId' in incoming() && incoming().propietarioId is string
        && 'claveIdempotencia' in incoming() && incoming().claveIdempotencia is string
        && incoming().estado == 'BORRADOR'
      ) && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && (
        incoming().id == existing().id
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
        && 'claveIdempotencia' in incoming() && incoming().claveIdempotencia == existing().claveIdempotencia
        && ('historial' in incoming()) && incoming().historial.size() >= existing().historial.size()
      ) && sinSecretosTesoreria();
      // Sin borrado ordinario: se anula/reversa. Excepción puntual del
      // administrador principal (vía de emergencia, queda en audit_logs).
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 27. GASTOS DE TESORERÍA (BLOQUE B — proyección de liquidación, 2026-09-20)
    // - el propietario SOLO lee los gastos imputados a su nombre
    // - crea/edita SOLO la administración (importación desde el modelo oficial
    //   `gastos` o alta manual); la contabilidad oficial vive en `gastos`
    // - sin secretos
    // =========================================================================
    match /gastos_inmuebles/{gastoId} {
      function gastoEsMio(d) {
        return 'propietarioId' in d && d.propietarioId == myPropId();
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && gastoEsMio(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && gastoEsMio(resource.data));
      allow create: if isMasterAdmin() && isValidId(incoming().id) && incoming().id == gastoId && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && (
        incoming().id == existing().id
        && 'propietarioId' in incoming() && incoming().propietarioId == existing().propietarioId
      ) && sinSecretosTesoreria();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 28. ÓRDENES DE PAGO (BLOQUE B — 2026-09-20)
    // - contienen IBAN de beneficiario: SOLO la administración
    // - historial append-only (trazabilidad del origen: liquidación→orden)
    // - sin envío bancario real: preparar ≠ ejecutar
    // =========================================================================
    match /ordenes_pago/{opId} {
      allow get: if isMasterAdmin();
      allow list: if isMasterAdmin();
      allow create: if isMasterAdmin() && isValidId(incoming().id) && incoming().id == opId && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && (
        incoming().id == existing().id
        && ('historial' in incoming()) && incoming().historial.size() >= existing().historial.size()
      ) && sinSecretosTesoreria();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 29. FICHEROS SEPA PAIN.008/001 (BLOQUE B — 2026-09-20)
    // - contienen XML con IBAN, BIC y Creditor Identifier: SOLO la
    //   administración; nunca visibles para propietarios ni profesionales
    // - sin secretos (el fichero SEPA en sí NO es una credencial)
    // =========================================================================
    match /ficheros_sepa/{ficheroId} {
      allow get: if isMasterAdmin();
      allow list: if isMasterAdmin();
      allow create: if isMasterAdmin() && isValidId(incoming().id) && incoming().id == ficheroId && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && incoming().id == existing().id && sinSecretosTesoreria();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 30. MANDATOS SEPA (BLOQUE B — 2026-09-20)
    // - contienen IBAN de deudor y MndtId: SOLO la administración
    // =========================================================================
    match /mandatos_sepa/{mandatoId} {
      allow get: if isMasterAdmin();
      allow list: if isMasterAdmin();
      allow create: if isMasterAdmin() && isValidId(incoming().id) && incoming().id == mandatoId && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && incoming().id == existing().id && sinSecretosTesoreria();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 31. CONFIGURACIÓN FISCAL DE LIQUIDACIÓN (BLOQUE B — 2026-09-20)
    // - documento por propietario (id de documento = propietarioId)
    // - el propietario puede leer la suya; crea/edita SOLO la administración
    // - sin secretos
    // =========================================================================
    match /config_liquidacion/{propietarioId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && propietarioId == myPropId());
      allow list: if isMasterAdmin();
      allow create: if isMasterAdmin() && propietarioId is string && propietarioId.size() > 0 && sinSecretosTesoreria();
      allow update: if isMasterAdmin() && sinSecretosTesoreria();
      allow delete: if isMasterAdmin();
    }


    // =========================================================================
    // BLOQUE C — MOROSIDAD, RECOBRO Y EXPEDIENTE LEGAL (2026-09-20)
    // Criterios comunes a 32–37:
    //  · deny-by-default: todo lo no listado queda denegado por el catch-all final
    //  · escritura SOLO de la administración (isMasterAdmin)
    //  · el propietario NUNCA lee expedientes/histórico/evidencias/comunicaciones:
    //    solo el espejo recortado (§37), sin datos del inquilino ni de estrategia
    //  · invariante de id: request.resource.data.id == {docId} (sin duplicados por escritura)
    //  · histórico y evidencias son append-only: create sí, update/delete no
    //  · sin credenciales, tokens, adjuntos en base64 ni secretos (sinSecretosMorosidad)
    // =========================================================================

    // 32. EXPEDIENTES DE MOROSIDAD — agregado de recobro por contrato.
    match /expedientes_morosidad/{expedienteId} {
      allow get, list: if isMasterAdmin();
      allow create: if isMasterAdmin()
        && isValidId(expedienteId)
        && incoming().id == expedienteId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && incoming().contratoId is string
        && incoming().contratoId.size() > 0
        && sinSecretosMorosidad();
      allow update: if isMasterAdmin()
        && request.resource.data.id == existing().id
        && request.resource.data.propietarioId == existing().propietarioId
        && request.resource.data.contratoId == existing().contratoId
        && sinSecretosMorosidad();
      // Sin borrado ordinario: un expediente es memoria de recobro y trazabilidad.
      allow delete: if false;
    }

    // 33. HISTÓRICO DE ESTADO (append-only). Nadie actualiza ni borra una transición.
    match /expedientes_morosidad_hist/{transicionId} {
      allow get, list: if isMasterAdmin();
      allow create: if isMasterAdmin()
        && isValidId(transicionId)
        && incoming().id == transicionId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && incoming().expedienteId is string
        && incoming().expedienteId.size() > 0
        && sinSecretosMorosidad();
      allow update, delete: if false;
    }

    // 34. EVIDENCIAS DEL EXPEDIENTE (append-only, metadatos: el archivo vive en Storage).
    //     No se guardan importes como fuente de verdad (vienen de la fuente canónica de cobros).
    match /evidencias_morosidad/{evidenciaId} {
      allow get, list: if isMasterAdmin();
      allow create: if isMasterAdmin()
        && isValidId(evidenciaId)
        && incoming().id == evidenciaId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && sinSecretosMorosidad();
      // Append-only en la práctica: solo se corrige el contenido, jamás la identidad
      // del registro (id, expediente, propietario y tipo quedan anclados).
      allow update: if isMasterAdmin()
        && request.resource.data.id == existing().id
        && request.resource.data.expedienteId == existing().expedienteId
        && request.resource.data.propietarioId == existing().propietarioId
        && request.resource.data.tipo == existing().tipo
        && sinSecretosMorosidad();
      allow delete: if false;
    }

    // 35. COMPROMISOS DE PAGO — calendario declarado; las cuotas solo se cubren
    //     con cobros ya existentes en la fuente contable (el ERP no inventa pagos).
    //     El propietario puede leer los compromisos de su propia cartera.
    match /compromisos_morosidad/{compromisoId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && resource.data.propietarioId == myPropId());
      // `list` se evalúa por documento: un propietario solo obtiene filas cuyo
      // propietarioId coincide con el suyo (la consulta ya filtra por ese campo).
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && resource.data.propietarioId == myPropId());
      allow create: if isMasterAdmin()
        && isValidId(compromisoId)
        && incoming().id == compromisoId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && sinSecretosMorosidad();
      allow update: if isMasterAdmin()
        && request.resource.data.id == existing().id
        && request.resource.data.propietarioId == existing().propietarioId
        && sinSecretosMorosidad();
      allow delete: if false;
    }

    // 36. POLÍTICA DE RECOBRO Y SU VERSIONADO. Los plazos (D+3/D+10/D+20/D+30) son
    //     offsets de negocio configurables, NO plazos legales. Cambiar la política no
    //     reescribe la historia: cada paso del plan guarda la versión vigente.
    match /politicas_morosidad/{politicaId} {
      allow get, list: if isMasterAdmin();
      allow create: if isMasterAdmin()
        && isValidId(politicaId)
        && incoming().id == politicaId
        && sinSecretosMorosidad();
      allow update: if isMasterAdmin()
        && request.resource.data.id == existing().id
        && sinSecretosMorosidad();
      allow delete: if false;
    }

    // 37. RESUMEN DE MOROSIDAD ENVIADO AL PROPIETARIO: espejo recortado e
    //     invariable por propietarioId. Escrito por la administración al guardar el
    //     expediente (§32); el propietario solo lee la suya. Sin campos sensibles:
    //     el recorte lo hace `recortarResumenPropietario` (lista blanca de campos).
    match /morosidad_resumen_propietario/{docId} {
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && resource.data.propietarioId == myPropId());
      allow list: if isPropietarioRole() && resource.data.propietarioId == myPropId();
      allow create: if isMasterAdmin()
        && isValidId(docId)
        && incoming().id == docId
        && incoming().propietarioId is string
        && incoming().propietarioId.size() > 0
        && sinSecretosMorosidad();
      allow update: if isMasterAdmin()
        && request.resource.data.id == existing().id
        && request.resource.data.propietarioId == existing().propietarioId
        && sinSecretosMorosidad();
      allow delete: if false;
    }

    // (las notificaciones de recobro se rigen por §22 — GAP 1 — y no duplican reglas:
    //  la bandeja del propietario sigue aislada por propietarioId/inmuebleId)

    // =========================================================================
    // 38. ACTAS DE ENTRADA Y SALIDA (BLOQUE D) — aislamiento estricto propietario
    // - ownerId inmutable (propietario titular)
    // - inmueble/contrato aislamiento
    // - actas firmadas/cerradas NO modificables: FIRMADA/CERRADA → BORRADOR en mismo doc BLOQUEADO
    //   versionado correcto: nueva versión = nuevo documento con actaAnteriorId, original preservada intacta
    // - PDF persistido: permitir solo actualización de campos PDF en FIRMADA/CERRADA sin tocar inventario/participantes/firmas
    // - sin secretos, sin base64 evidencias (Storage)
    // - trazabilidad historial obligatorio
    // =========================================================================
    match /actas/{actaId} {
      function actaEsMia(d) {
        return 'ownerId' in d && d.ownerId == myPropId();
      }
      function actaVisible(d) {
        return actaEsMia(d) || ('propertyId' in d && myInmuebleIds().hasAny([d.propertyId]));
      }
      function actaOwnerInmutable() {
        return 'ownerId' in existing() && 'ownerId' in incoming() && incoming().ownerId == existing().ownerId;
      }
      function actaPropertyInmutable() {
        return 'propertyId' in existing() && 'propertyId' in incoming() && incoming().propertyId == existing().propertyId;
      }
      function sinSecretosActa() {
        return !(
          'credentials' in incoming() ||
          'apiKey' in incoming() ||
          'accessToken' in incoming() ||
          'password' in incoming() ||
          'secret' in incoming() ||
          'tokenBancario' in incoming() ||
          'codigo' in incoming() ||
          'otp' in incoming()
        );
      }
      function estadoValido() {
        return incoming().estado in ['BORRADOR', 'EN_REVISION', 'PENDIENTE_FIRMA', 'FIRMADA', 'CERRADA', 'ERROR', 'CANCELADA'];
      }
      function tipoValido() {
        return incoming().tipo in ['ENTRADA', 'SALIDA'];
      }
      function versionIncrementoValido() {
        // Si existente es FIRMADA/CERRADA, versión debe permanecer idéntica (no incrementar en mismo doc)
        return (existing().estado in ['FIRMADA', 'CERRADA'])
          ? incoming().version == existing().version
          : incoming().version >= existing().version;
      }
      function esTransicionFirmadaACerrada() {
        // Única transición permitida desde FIRMADA: → CERRADA, misma versión, sin cambios críticos
        return existing().estado == 'FIRMADA'
          && incoming().estado == 'CERRADA'
          && incoming().version == existing().version
          && actaOwnerInmutable()
          && actaPropertyInmutable()
          && incoming().tipo == existing().tipo
          && incoming().inventario == existing().inventario
          && incoming().participantes == existing().participantes
          && incoming().lecturasContadores == existing().lecturasContadores
          && incoming().firmas == existing().firmas;
      }
      function esActualizacionPdfPermitida() {
        // Permitir solo añadir/actualizar referencia PDF en acta FIRMADA/CERRADA sin tocar datos críticos
        return (existing().estado in ['FIRMADA', 'CERRADA'])
          && incoming().estado == existing().estado
          && incoming().version == existing().version
          && actaOwnerInmutable()
          && actaPropertyInmutable()
          && incoming().tipo == existing().tipo
          && incoming().inventario == existing().inventario
          && incoming().participantes == existing().participantes
          && incoming().lecturasContadores == existing().lecturasContadores
          && incoming().firmas == existing().firmas
          && incoming().estadoFirma == existing().estadoFirma;
      }
      function noModificacionSilenciosaFirmada() {
        // FIRMADA/CERRADA no pueden mutar a BORRADOR en mismo documento. Solo transición FIRMADA→CERRADA o actualización PDF permitida.
        return !(existing().estado in ['FIRMADA', 'CERRADA'])
          || esTransicionFirmadaACerrada()
          || esActualizacionPdfPermitida();
      }

      // BLOQUE E (reconciliado): el inquilino lee (get) y consulta (lista acotada
      // por igualdad en `contractId`) las actas D de SUS contratos vinculados.
      allow get: if isMasterAdmin() || (isPropietarioRole() && actaVisible(existing())) || (isTenant() && ('contractId' in existing()) && tenantTieneContrato(existing().contractId));
      allow list: if isMasterAdmin() || (isPropietarioRole() && actaEsMia(resource.data)) || (isTenant() && ('contractId' in resource.data) && resource.data.contractId in tenantContratoIds());

      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'propertyId' in incoming() && incoming().propertyId is string
        && tipoValido()
        && estadoValido()
        && incoming().estado == 'BORRADOR'
        && 'version' in incoming() && incoming().version >= 1
      ) && sinSecretosActa();

      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
        && actaOwnerInmutable()
        && actaPropertyInmutable()
        && versionIncrementoValido()
        && noModificacionSilenciosaFirmada()
        && estadoValido()
      ) && sinSecretosActa();

      allow delete: if isMasterAdmin();
    }

    match /actas_evidencias/{evidenciaId} {
      function evidenciaEsMia(d) {
        return 'ownerId' in d && d.ownerId == myPropId();
      }
      function evidenciaVisible(d) {
        return evidenciaEsMia(d) || ('propertyId' in d && myInmuebleIds().hasAny([d.propertyId]));
      }
      function sinBase64() {
        // Evitar almacenamiento base64 en Firestore: storagePath obligatorio, no data URL gigante
        return 'storagePath' in incoming()
          && !(incoming().storagePath is string && incoming().storagePath.matches('data:.*'))
          && !('base64Data' in incoming() && incoming().base64Data.size() > 1000);
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && evidenciaVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && evidenciaEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'actaId' in incoming() && incoming().actaId is string
        && 'propertyId' in incoming() && incoming().propertyId is string
        && 'storagePath' in incoming()
      ) && sinBase64();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'actaId' in incoming() && incoming().actaId == existing().actaId
      ) && sinBase64();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
      );
    }

    match /actas_incidencias/{incidenciaId} {
      function incidenciaEsMia(d) {
        return 'ownerId' in d && d.ownerId == myPropId();
      }
      function incidenciaVisible(d) {
        return incidenciaEsMia(d) || ('propertyId' in d && myInmuebleIds().hasAny([d.propertyId]));
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && incidenciaVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && incidenciaEsMia(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'actaId' in incoming() && incoming().actaId is string
        && 'propertyId' in incoming() && incoming().propertyId is string
      );
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
      );
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
      );
    }

    match /actas_otp/{otpId} {
      function otpEsMio(d) {
        return 'ownerId' in d && d.ownerId == myPropId();
      }
      function sinSecretoPlanoExcesivo() {
        // No permitir almacenamiento de codigo en texto plano salvo temporal controlado.
        // codigoPlainTemporal (solo canal MANUAL, entrega en persona por personal interno)
        // se permite SOLO mientras el OTP sigue ACTIVO y sin usar, o si se envía null
        // (limpieza obligatoria tras uso/expiración).
        return !('codigo' in incoming() && incoming().codigo.size() > 0) // nunca campo 'codigo' plano
          && !('plain' in incoming())
          && (!('codigoPlainTemporal' in incoming())
              || incoming().codigoPlainTemporal == null
              || (incoming().estado == 'ACTIVO' && incoming().usado == false));
      }
      allow get: if isMasterAdmin() || (isPropietarioRole() && otpEsMio(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && otpEsMio(resource.data));
      allow create: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'actaId' in incoming() && incoming().actaId is string
        && 'firmaId' in incoming() && incoming().firmaId is string
        && 'codigoHash' in incoming()
      ) && sinSecretoPlanoExcesivo();
      allow update: if isMasterAdmin() || (
        isPropietarioRole()
        && 'ownerId' in existing() && existing().ownerId == myPropId()
        && 'ownerId' in incoming() && incoming().ownerId == myPropId()
        && 'actaId' in incoming() && incoming().actaId == existing().actaId
      ) && sinSecretoPlanoExcesivo();
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // 43. ANÁLISIS DE INVERSIÓN Y VALORACIÓN INMOBILIARIA (JD)
    // Registro independiente de la cartera real, aislado por propietarioId.
    // Patrón idéntico a gastos/contratos/recomercialización: propietario privado,
    // profesional sin acceso, administrador global. Necesario para persistencia.
    // =========================================================================
    match /analisis_inversion/{analisisId} {
      allow get: if isMasterAdmin() || (isPropietarioRole() && aisladoVisible(existing()));
      allow list: if isMasterAdmin() || (isPropietarioRole() && aisladoEsMio(resource.data));
      allow create: if isMasterAdmin() || aisladoCreateOk();
      allow update: if isMasterAdmin() || aisladoUpdateOk();
      allow delete: if isMasterAdmin() || (
        isPropietarioRole()
        && 'propietarioId' in existing() && existing().propietarioId == myPropId()
      );
    }

    // ============================================================
    // BLOQUE OPERACIONES — port funcional de C (Gestor-alquileres-vercel @ 1686b8e8).
    // Helpers canónicos (me/isMasterAdmin/isSignedIn/authEmail) y match /audit_logs:
    // se reutilizan los de este archivo canónico; no se redefinen ni se duplican.
    // ============================================================
    // Mismo contrato B, evaluado sobre un único espejo ya obtenido por el llamador.
    function opAcceso(p, c, escritura) {
      let l = c.get('carterasL', []);
      let e = c.get('carterasE', []);
      return l is list && e is list && l.hasAll(e) && c.get('estado', '') == 'ACTIVO'
        && ((c.get('tipoPerfil', '') == 'PROPIETARIO' && p is string && p.size() > 0 && c.get('propietarioId', '') == p)
          || p in (escritura ? e : l));
    }
    function opLectura(p) {
      return isMasterAdmin() || (isSignedIn() && opAcceso(p,me(),false));
    }
    function opEscritura(p) {
      return isMasterAdmin() || (isSignedIn() && opAcceso(p,me(),true));
    }
    function opActual(p, i) {
      let inmueble = get(/databases/$(database)/documents/inmuebles/$(i)).data;
      return inmueble.get('propietarioId', '') == p || inmueble.get('propietarioPrincipalId', '') == p
        || inmueble.get('propietarioSecundarioId', '') == p;
    }
    function opEntidad(p, tipo, id) {
      let key = tipo + '~' + id;
      return /databases/$(database)/documents/operaciones/$(p)/entidades/$(key);
    }
    // Validadores de referencias puros: no hacen get/exists ni confían en el tipo almacenado.
    function opRef(p, tipo, registro, i) {
      return registro != null && (tipo == 'proveedor' ? registro.propietarioId == p
        : registro.ambito == {'propietarioId': p, 'inmuebleId': i});
    }
    function opRefOpcional(p, e, campo, tipo, i, registro) {
      return !(campo in e) || opRef(p, tipo, registro, i);
    }
    function opVinculo(p, v, i, r) {
      return opRef(p,'incidencia',r.incidencia,i)
        && (!('averiaId' in v) || (opRef(p,'averia',r.averia,i) && r.averia.incidenciaId == v.incidenciaId))
        && (!('reparacionId' in v) || (opRef(p,'reparacion',r.reparacion,i) && r.reparacion.incidenciaId == v.incidenciaId
          && (!('averiaId' in v) || r.reparacion.get('averiaId','') == v.averiaId)));
    }
    function opRelaciones(p, e, i, r) {
      return opRefOpcional(p,e,'proveedorId','proveedor',i,r.proveedor) && opRefOpcional(p,e,'equipoId','equipo',i,r.equipo)
        && opRefOpcional(p,e,'garantiaId','garantia',i,r.garantia)
        && (!('incidenciaId' in e) || opRef(p,'incidencia',r.incidencia,i))
        && (!('averiaId' in e) || (opRef(p,'averia',r.averia,i) && r.averia.incidenciaId == e.incidenciaId))
        && (!('vinculo' in e) || e.vinculo == null || opVinculo(p,e.vinculo,i,r))
        && (!('garantiaId' in e) || r.garantia.equipoId == e.get('equipoId',''))
        && (!('contratoId' in e) || (r.contrato.inmuebleId == i
          && (!('inquilinoId' in e) || r.contrato.candidatoId == e.inquilinoId)))
        && (!('inquilinoId' in e) || r.inquilino.inmuebleId == i);
    }
    // Una lectura ANTERIOR por referencia presente. No se acepta un contexto enviado por cliente.
    // ANOTAR no lee referencias; VINCULAR_DOCUMENTO solo lee el documento nuevo.
    function opReferencias(p, e, cmd) {
      let negocio = !(cmd.accion in ['ANOTAR','VINCULAR_DOCUMENTO']);
      let v = ('incidenciaId' in e || 'averiaId' in e) ? e : e.get('vinculo',null);
      return {
        'proveedor': negocio && 'proveedorId' in e ? get(opEntidad(p,'proveedor',e.proveedorId)).data.registro : null,
        'equipo': negocio && 'equipoId' in e ? get(opEntidad(p,'equipo',e.equipoId)).data.registro : null,
        'garantia': negocio && 'garantiaId' in e ? get(opEntidad(p,'garantia',e.garantiaId)).data.registro : null,
        'incidencia': negocio && v != null && 'incidenciaId' in v ? get(opEntidad(p,'incidencia',v.incidenciaId)).data.registro : null,
        'averia': negocio && v != null && 'averiaId' in v ? get(opEntidad(p,'averia',v.averiaId)).data.registro : null,
        'reparacion': negocio && v != null && 'reparacionId' in v ? get(opEntidad(p,'reparacion',v.reparacionId)).data.registro : null,
        'contrato': negocio && 'contratoId' in e ? get(/databases/$(database)/documents/contratos_formalizacion/$(e.contratoId)).data : null,
        'inquilino': negocio && 'inquilinoId' in e ? get(/databases/$(database)/documents/candidatos/$(e.inquilinoId)).data : null,
        'documento': cmd.accion == 'VINCULAR_DOCUMENTO' ? get(opEntidad(p,'documento',cmd.documentoId)).data.registro : null
      };
    }
    function opCampos(tipo) {
      return tipo == 'incidencia' ? ['fecha', 'descripcion', 'prioridad', 'origen', 'alcance', 'contratoId', 'inquilinoId', 'responsable', 'proveedorId', 'equipoId']
        : tipo == 'averia' ? ['incidenciaId', 'equipoId', 'descripcion', 'sintomas', 'fecha', 'proveedorId', 'garantiaId']
        : tipo == 'reparacion' ? ['incidenciaId', 'averiaId', 'equipoId', 'descripcion', 'proveedorId', 'presupuestoId', 'fechaPrevista', 'fechaInicio', 'fechaFin', 'costeCentimos', 'moneda', 'materiales', 'resultado']
        : tipo == 'proveedor' ? ['nombre', 'servicios', 'contacto', 'referenciaExterna', 'activo']
        : tipo == 'equipo' ? ['tipoEquipo', 'marca', 'modelo', 'numeroSerie', 'fechaAdquisicion', 'fechaInstalacion', 'instalacion']
        : tipo == 'garantia' ? ['equipoId', 'inicio', 'vencimiento', 'proveedorId', 'fabricante', 'condiciones', 'referenciaCompra']
        : tipo == 'presupuesto' ? ['vinculo', 'proveedorId', 'fecha', 'referencia', 'moneda', 'importeCentimos', 'conceptos']
        : tipo == 'factura' ? ['proveedorId', 'fecha', 'referencia', 'moneda', 'importeCentimos', 'conceptos', 'origen', 'vinculo', 'presupuestoId']
        : tipo == 'documento' ? ['archivo', 'categoria', 'descripcion', 'referenciaExterna']
        : [];
    }
    function opTexto(v) { return v is string && v.size() > 0; }
    function opDinero(v) { return v is int && v >= 0 && v <= 9007199254740991; }
    // Diez conceptos por registro de transporte: límite explícito, nunca truncar el original.
    function opConcepto(c, i) {
      return i >= c.size() || (c[i].keys().hasOnly(['descripcion','importeCentimos'])
        && opTexto(c[i].descripcion) && opDinero(c[i].importeCentimos));
    }
    function opImporte(c, i) { return i < c.size() ? c[i].importeCentimos : 0; }
    function opConceptos(e) {
      let c = e.conceptos;
      return c is list && c.size() > 0 && c.size() <= 10
        && opConcepto(c,0) && opConcepto(c,1) && opConcepto(c,2) && opConcepto(c,3) && opConcepto(c,4) && opConcepto(c,5) && opConcepto(c,6) && opConcepto(c,7) && opConcepto(c,8) && opConcepto(c,9)
        && e.importeCentimos == opImporte(c,0) + opImporte(c,1) + opImporte(c,2) + opImporte(c,3) + opImporte(c,4) + opImporte(c,5) + opImporte(c,6) + opImporte(c,7) + opImporte(c,8) + opImporte(c,9);
    }
    function opEsquema(e, campos) {
      return e.keys().hasOnly(campos.concat(['id','tipo','version','creadoEn','actualizadoEn'])
          .concat(e.tipo == 'proveedor' ? ['propietarioId'] : ['ambito','documentoIds'])
          .concat(e.tipo in ['proveedor','garantia','documento'] ? [] : ['estado']))
        && (e.tipo == 'proveedor' ? opTexto(e.nombre) && e.activo is bool && e.servicios is list && e.contacto is map : e.documentoIds is list)
        && (e.tipo != 'incidencia' || (opTexto(e.descripcion) && opTexto(e.fecha) && opTexto(e.origen) && e.prioridad in ['BAJA','MEDIA','ALTA','URGENTE'] && e.alcance in ['INMUEBLE','ZONAS_COMUNES','MANTENIMIENTO_GENERAL']))
        && (e.tipo != 'averia' || (opTexto(e.descripcion) && opTexto(e.fecha) && e.sintomas is list))
        && (e.tipo != 'reparacion' || (opTexto(e.descripcion) && opTexto(e.proveedorId) && e.moneda == 'EUR' && e.materiales is list && (!('costeCentimos' in e) || opDinero(e.costeCentimos))))
        && (e.tipo != 'equipo' || opTexto(e.tipoEquipo))
        && (e.tipo != 'garantia' || opTexto(e.equipoId))
        && (!(e.tipo in ['presupuesto','factura']) || (opTexto(e.fecha) && opTexto(e.referencia) && opDinero(e.importeCentimos) && opConceptos(e)))
        && (e.tipo != 'factura' || opTexto(e.origen))
        && (e.tipo != 'documento' || (opTexto(e.descripcion) && e.categoria in ['FOTO','PRESUPUESTO','FACTURA','GARANTIA','PARTE','COMUNICACION','OTRO']
          && e.archivo.keys().hasOnly(['id','nombreArchivo','mimeType','fechaSubida','storagePath','tamañoBytes'])
          && opTexto(e.archivo.id) && opTexto(e.archivo.nombreArchivo) && opTexto(e.archivo.mimeType) && opTexto(e.archivo.fechaSubida)
          && (!('referenciaExterna' in e) || (e.referenciaExterna.keys().hasOnly(['sistemaExterno','referenciaExterna']) && opTexto(e.referenciaExterna.sistemaExterno) && opTexto(e.referenciaExterna.referenciaExterna)))));
    }
    function opComando(e, b, cmd, campos, cambios) {
      return (cmd.accion != 'CREAR' || (cmd.datos.keys().hasOnly(campos)
          && e.diff(cmd.datos).affectedKeys().hasOnly(['id','tipo','version','creadoEn','actualizadoEn','ambito','propietarioId','documentoIds','estado'])))
        && (cmd.accion != 'MODIFICAR' || (cmd.cambios.keys().size() > 0 && cmd.cambios.keys().hasOnly(campos)
          && e.diff(cmd.cambios).changedKeys().size() == 0 && cmd.cambios.keys().hasOnly(e.keys())
          && cambios.hasOnly(cmd.cambios.keys().concat(['version','actualizadoEn']))))
        && (cmd.accion != 'ANOTAR' || (opTexto(cmd.texto) && cmd.clase in ['DIAGNOSTICO','ACTUACION','COMUNICACION','NOTA']))
        && (cmd.accion != 'ASOCIAR_FACTURA' || e.get('presupuestoId',null) == cmd.get('presupuestoId',b.get('presupuestoId',null)));
    }
    function opEconomia(p,e,r) {
      return (!(e.tipo in ['presupuesto','factura']) || (e.moneda == 'EUR' && e.importeCentimos is int && e.importeCentimos >= 0 && e.conceptos is list && e.conceptos.size()>0
        && 'proveedorId' in e
        && (e.vinculo == null ? e.tipo == 'factura' : !('reparacionId' in e.vinculo) || r.reparacion.proveedorId == e.proveedorId)))
        && (!(e.tipo in ['averia','reparacion'] && 'equipoId' in e) || r.incidencia.get('equipoId',e.equipoId) == e.equipoId)
        && (!(e.tipo == 'reparacion' && 'averiaId' in e) || r.averia.get('equipoId',e.get('equipoId','')) == e.get('equipoId',''));
    }
    function opInicial(e) {
      return e.tipo in ['proveedor','garantia','documento'] ? !('estado' in e) : e.estado == {'incidencia':'ABIERTA','averia':'PENDIENTE','reparacion':'PLANIFICADA','equipo':'OPERATIVO','presupuesto':'PENDIENTE','factura':'REGISTRADA'}[e.tipo];
    }
    function opDestinos(tipo, estado) {
      return tipo == 'incidencia' ? {'ABIERTA': ['EN_REVISION', 'CANCELADA'], 'EN_REVISION': ['PRESUPUESTO', 'AUTORIZADA', 'RESUELTA', 'CANCELADA'], 'PRESUPUESTO': ['AUTORIZADA', 'EN_REVISION', 'CANCELADA'], 'AUTORIZADA': ['EN_REPARACION', 'RESUELTA', 'CANCELADA'], 'EN_REPARACION': ['RESUELTA', 'EN_REVISION'], 'RESUELTA': ['CERRADA', 'EN_REVISION'], 'CERRADA': ['EN_REVISION'], 'CANCELADA': []}[estado]
        : tipo == 'averia' ? {'PENDIENTE': ['EN_DIAGNOSTICO', 'CANCELADA'], 'EN_DIAGNOSTICO': ['EN_REPARACION', 'RESUELTA', 'CANCELADA'], 'EN_REPARACION': ['RESUELTA', 'EN_DIAGNOSTICO'], 'RESUELTA': ['EN_DIAGNOSTICO'], 'CANCELADA': []}[estado]
        : tipo == 'reparacion' ? {'PLANIFICADA': ['EN_CURSO', 'CANCELADA'], 'EN_CURSO': ['FINALIZADA', 'CANCELADA'], 'FINALIZADA': [], 'CANCELADA': []}[estado]
        : tipo == 'equipo' ? {'OPERATIVO': ['AVERIADO', 'EN_REPARACION', 'RETIRADO'], 'AVERIADO': ['EN_REPARACION', 'OPERATIVO', 'RETIRADO'], 'EN_REPARACION': ['OPERATIVO', 'AVERIADO', 'RETIRADO'], 'RETIRADO': []}[estado]
        : tipo == 'presupuesto' ? {'PENDIENTE': ['APROBADO', 'RECHAZADO', 'CANCELADO'], 'APROBADO': ['CANCELADO'], 'RECHAZADO': [], 'CANCELADO': []}[estado]
        : tipo == 'factura' ? {'REGISTRADA': ['ANULADA'], 'ANULADA': []}[estado]
        : [];
    }
    function opAbierta(e) {
      return e != null && ((e.tipo == 'averia' && !(e.estado in ['RESUELTA','CANCELADA'])) || (e.tipo == 'reparacion' && !(e.estado in ['FINALIZADA','CANCELADA']))) ? 1 : 0;
    }
    function opUso(e) { return e != null && e.tipo == 'reparacion' && e.estado in ['EN_CURSO','FINALIZADA'] ? 1 : 0; }
    function opContador(antes, despues, clave, delta) {
      return clave == '' ? despues == antes : despues.diff(antes).affectedKeys().hasOnly([clave])
        && despues.get(clave,0) == antes.get(clave,0) + delta && despues.get(clave,0) >= 0;
    }
    function opContadores(a, n, v) {
      let e = v.despues;
      let b = v.antes;
      let delta = opAbierta(e)-opAbierta(b);
      return opContador(a.get('abiertasPorIncidencia',{}),n.abiertasPorIncidencia,e.get('incidenciaId',''),delta)
        && opContador(a.get('abiertasPorAveria',{}),n.abiertasPorAveria,e.tipo == 'reparacion' ? e.get('averiaId','') : '',delta)
        && opContador(a.get('presupuestosEnUso',{}),n.presupuestosEnUso,e.tipo == 'reparacion' ? e.get('presupuestoId','') : '',opUso(e)-opUso(b));
    }
    function opInvariantes(p, e, h, r) {
      return (!(e.tipo == 'incidencia' && e.estado in ['RESUELTA','CERRADA','CANCELADA']) || h.abiertasPorIncidencia.get(e.id,0) == 0)
        && (!(e.tipo == 'averia' && e.estado in ['RESUELTA','CANCELADA']) || h.abiertasPorAveria.get(e.id,0) == 0)
        && (!(e.tipo == 'presupuesto' && e.estado == 'CANCELADO') || h.presupuestosEnUso.get(e.id,0) == 0)
        && (!(e.tipo in ['averia','reparacion'] && opAbierta(e) == 1) || !(r.incidencia.estado in ['CERRADA','CANCELADA']))
        && (!(e.tipo == 'reparacion' && e.estado == 'FINALIZADA') || (e.fechaInicio is string && e.fechaFin is string && e.fechaFin >= e.fechaInicio && e.resultado is string && e.resultado.size()>0 && e.costeCentimos is int && e.costeCentimos >= 0));
    }
    function opCambio(p, e, b, cmd, i, cambios, r) {
      return b == null ? cmd.accion == 'CREAR' && e.version == 1 && opInicial(e) && e.get('documentoIds',[]) == []
        : cmd.accion != 'CREAR' && e.id == b.id && e.tipo == b.tipo && e.creadoEn == b.creadoEn && e.version == b.version + 1
        && e.get('ambito',null) == b.get('ambito',null) && e.get('propietarioId',null) == b.get('propietarioId',null)
        && e.get('incidenciaId',null) == b.get('incidenciaId',null) && e.get('averiaId',null) == b.get('averiaId',null)
        && e.get('equipoId',null) == b.get('equipoId',null) && e.get('contratoId',null) == b.get('contratoId',null) && e.get('inquilinoId',null) == b.get('inquilinoId',null)
        && (cmd.accion == 'CAMBIAR_ESTADO' ? e.estado == cmd.estado && e.estado in opDestinos(e.tipo,b.estado) : e.get('estado',null) == b.get('estado',null))
        && (cmd.accion == 'VINCULAR_DOCUMENTO' ? !(e.tipo in ['proveedor','documento']) && opRef(p,'documento',r.documento,i) && e.documentoIds == b.documentoIds.concat([cmd.documentoId]) && !(cmd.documentoId in b.documentoIds)
          : e.get('documentoIds',[]) == b.get('documentoIds',[]))
        && (cmd.accion == 'ASOCIAR_FACTURA' ? e.tipo == 'factura' && e.estado != 'ANULADA' && e.vinculo == cmd.vinculo : e.get('vinculo',null) == b.get('vinculo',null))
        && (cmd.accion != 'CAMBIAR_ESTADO' || cambios.hasOnly(['version','actualizadoEn','estado']))
        && (cmd.accion != 'VINCULAR_DOCUMENTO' || cambios.hasOnly(['version','actualizadoEn','documentoIds']))
        && (cmd.accion != 'ASOCIAR_FACTURA' || cambios.hasOnly(['version','actualizadoEn','vinculo','presupuestoId']))
        && (!(e.tipo == 'reparacion' && b.estado != 'PLANIFICADA') || (e.proveedorId == b.proveedorId && e.get('presupuestoId','') == b.get('presupuestoId','')))
        && (!(e.tipo == 'reparacion' && cmd.accion == 'CAMBIAR_ESTADO' && e.estado == 'EN_CURSO') || (r.proveedor.activo == true && e.fechaInicio is string
          && (!('averiaId' in e) || !(r.averia.estado in ['RESUELTA','CANCELADA']))))
        && (cmd.accion != 'ANOTAR' || cambios.hasOnly(['version','actualizadoEn']))
        && (cmd.accion != 'MODIFICAR' || (!(e.tipo in ['documento','factura']) && !(e.tipo=='presupuesto' && b.estado!='PENDIENTE') && !(e.tipo=='reparacion' && b.estado in ['FINALIZADA','CANCELADA'])))
        && (e.tipo != 'documento' || e.archivo == b.archivo)
        && (e.tipo != 'factura' || cambios.hasOnly(['version','actualizadoEn','estado','documentoIds','vinculo','presupuestoId']));
    }
    // Acoplamiento bidireccional: un incremento observable obliga a escribir el otro
    // documento en este commit. Su allow se evalúa entonces; getAfter solo no bastaría.
    // La cabecera valida CAS/contadores; la entidad valida UNA vez el evento completo.
    function opCabeceraValida(p, a, n) {
      return n.keys().hasOnly(['propietarioId','revision','ultimoEventoId','abiertasPorIncidencia','abiertasPorAveria','presupuestosEnUso'])
        && n.propietarioId == p && n.revision is int
        && n.revision == (a == null ? 0 : a.revision) + 1
        && opCabeceraEnlazada(p,a,n);
    }
    function opCabeceraEnlazada(p, a, n) {
      let audit = getAfter(/databases/$(database)/documents/audit_logs/$(n.ultimoEventoId)).data;
      let path = opEntidad(p,audit.detalles.tipo,audit.detalles.entidadId);
      let vieja = exists(path) ? get(path).data : null;
      let fila = getAfter(path).data;
      return fila.auditId == n.ultimoEventoId && fila.registro.version is int
        && fila.registro.version == (vieja == null ? 0 : vieja.registro.version) + 1
        && opContadores(a == null ? {} : a,n,{'antes':vieja == null ? null : vieja.registro,'despues':fila.registro})
        && (audit.accion in ['OPERACIONES_ANOTAR','OPERACIONES_VINCULAR_DOCUMENTO'] || !('presupuestoId' in fila.registro)
          || opPresupuestoEnlazado(p,fila.registro,audit.detalles.inmuebleId));
    }
    // El testigo de versión obliga a validar esta MISMA entidad en el commit.
    // La cabecera asume la referencia presupuesto: no se relee desde la entidad.
    function opPresupuestoEnlazado(p, e, i) {
      let q = get(opEntidad(p,'presupuesto',e.presupuestoId)).data.registro;
      return opPresupuesto(p,e,i,q);
    }
    function opPresupuesto(p, e, i, q) {
      return e.tipo in ['reparacion','factura'] && opRef(p,'presupuesto',q,i)
        && q.proveedorId == e.proveedorId
        && (e.tipo == 'factura' ? (e.vinculo != null && q.vinculo.incidenciaId == e.vinculo.incidenciaId
          && q.vinculo.get('averiaId',e.vinculo.get('averiaId','')) == e.vinculo.get('averiaId','')
          && q.vinculo.get('reparacionId',e.vinculo.get('reparacionId','')) == e.vinculo.get('reparacionId',''))
          : (q.vinculo.incidenciaId == e.incidenciaId
            && q.vinculo.get('averiaId',e.get('averiaId','')) == e.get('averiaId','')
            && q.vinculo.get('reparacionId',e.id) == e.id))
        && (e.tipo != 'reparacion' || !(e.estado in ['EN_CURSO','FINALIZADA']) || q.estado == 'APROBADO');
    }
    function opFilaAutorizada(p, key, fila, vieja) {
      let c = me();
      return (isMasterAdmin() || opAcceso(p,c,true))
        && fila.keys().hasOnly(['registro','auditId','versiones']) && key == fila.registro.tipo + '~' + fila.registro.id
        && opFilaValida(p,fila,vieja,c.usuarioId);
    }
    function opFilaValida(p, fila, vieja, usuarioId) {
      let path = /databases/$(database)/documents/operaciones/$(p);
      let anterior = exists(path) ? get(path).data : null;
      let h = getAfter(path).data;
      let auditPath = /databases/$(database)/documents/audit_logs/$(fila.auditId);
      return h.revision is int && h.revision == (anterior == null ? 0 : anterior.revision) + 1
        // El audit debe nacer en el mismo commit, no reutilizar uno autenticado previo.
        && !exists(auditPath)
        && opEventoValido(p,fila.auditId,getAfter(auditPath).data,h,fila,vieja,usuarioId);
    }
    function opEventoValido(p, id, data, h, fila, vieja, usuarioId) {
      let e = fila.registro;
      let version = fila.versiones[fila.versiones.size()-1];
      let cmd = version.comando;
      let antes = vieja == null ? null : vieja.registro;
      let d = data.detalles;
      let campos = opCampos(e.tipo);
      let cambios = antes == null ? null : e.diff(antes).affectedKeys();
      return data.keys().hasOnly(['id','usuarioId','usuarioEmail','usuarioNombre','accion','descripcion','fechaHora','entidadAfectada','idAfectado','resultado','detalles','registradoEn'])
        && e.tipo in ['incidencia','averia','reparacion','proveedor','equipo','garantia','presupuesto','factura','documento'] && e.version is int
        && cmd.accion in ['CREAR','MODIFICAR','CAMBIAR_ESTADO','ANOTAR','VINCULAR_DOCUMENTO','ASOCIAR_FACTURA']
        && data.id == id && data.usuarioId == usuarioId && data.usuarioEmail == authEmail() && data.usuarioNombre is string
        && data.entidadAfectada == 'inmueble' && data.idAfectado == version.ambito.inmuebleId && data.resultado == 'EXITO'
        && d == {'modulo':'OPERACIONES','propietarioId':p,'inmuebleId':version.ambito.inmuebleId,'operacionId':cmd.operacionId,'revision':h.revision,'actorUid':request.auth.uid,'tipo':e.tipo,'entidadId':e.id,'version':e.version}
        && cmd.actor == request.auth.uid && data.registradoEn == request.time
        && data.fechaHora == cmd.fecha && data.descripcion == cmd.motivo && cmd.motivo is string && cmd.motivo.size()>0
        && data.accion == 'OPERACIONES_' + cmd.accion && cmd.tipo == e.tipo && cmd.id == e.id
        && cmd.operacionId.matches('^[^/~]{1,128}$') && p.matches('^[^/~]{1,128}$') && e.id.matches('^[^/~]{1,128}$')
        && id == 'operaciones~' + p + '~' + cmd.operacionId
        && h.ultimoEventoId == id && cmd.revisionEsperada == h.revision - 1
        && fila.auditId == id && version.registro == e && version.ambito == {'propietarioId':p,'inmuebleId':data.idAfectado}
        && version.keys().hasOnly(['ambito','comando','registro'])
        && fila.versiones == (vieja == null ? [] : vieja.versiones).concat([version])
        && e.actualizadoEn == cmd.fecha && (antes != null || e.creadoEn == cmd.fecha)
        && (e.tipo == 'proveedor' ? e.propietarioId == p : e.ambito == version.ambito)
        && opActual(p,data.idAfectado)
        && opEsquema(e,campos) && opComando(e,antes,cmd,campos,cambios)
        && opDominio(p,e,antes,cmd,data.idAfectado,cambios,h);
    }
    // Solo después de autorización, envelope, esquema y comando: cargar una vez, validar sin I/O.
    function opDominio(p, e, antes, cmd, i, cambios, h) {
      let r = opReferencias(p,e,cmd);
      return (cmd.accion in ['ANOTAR','VINCULAR_DOCUMENTO'] || opRelaciones(p,e,i,r))
        && opCambio(p,e,antes,cmd,i,cambios,r)
        && (cmd.accion in ['ANOTAR','VINCULAR_DOCUMENTO'] || (opInvariantes(p,e,h,r) && opEconomia(p,e,r)));
    }
    // El match /audit_logs canónico de este archivo ya codifica el contrato B literal:
    // create autenticado, read solo master, update/delete false (append-only).
    match /operaciones/{propietarioId} {
      allow read: if opLectura(propietarioId);
      allow create, update: if opEscritura(propietarioId)
        && opCabeceraValida(propietarioId,resource == null ? null : resource.data,incoming());
      allow delete: if false;
      match /entidades/{entidadKey} {
        allow read: if opLectura(propietarioId);
        allow create, update: if isSignedIn()
          && opFilaAutorizada(propietarioId,entidadKey,incoming(),resource == null ? null : resource.data);
        allow delete: if false;
      }
    }
    // FIN BLOQUE OPERACIONES

    // =========================================================================
    // 44. SINDICACIÓN — ESTADO POR (INMUEBLE, PORTAL) — GAP 5 fase 2.
    //     Un documento por clave lógica `PORTAL:inmuebleId`. El id del documento es el
    //     `externalId` determinista que produce el núcleo
    //     (`identidadPublicacionPortal`), así que es ESTRUCTURALMENTE IMPOSIBLE tener
    //     dos estados "actuales" para el mismo par: un segundo intento de create sobre
    //     la misma clave rechina contra `id == docId`.
    //
    //     Lo que la regla puede y no puede comprobar:
    //      · puede: identidad (id/externalId/clave), enum de portal/estado/operación,
    //        propiedad del inmueble, ausencia de secretos e invariabilidad estructural.
    //      · no puede: rehacer el hash del `externalId` ni concatenar cadenas (el
    //        lenguaje de reglas v2 no tiene `sha256` ni concatenación de strings). Por
    //        eso `clave == portal + ':' + inmuebleId` se comprueba con forma + suma de
    //        longitudes, y la igualdad exacta la garantiza el dominio
    //        (`verificarInvariantesDelRegistro`, invocada antes de escribir por el
    //        adaptador) ⇒ las dos capas se solapan, ninguna es más laxa que la otra.
    //
    //     El historial NO vive aquí: se anexa a `audit_logs` (§15) con `accion
    //     SINDICACION_<OPERACION>`, que ya es append-only y no necesita regla nueva.
    // =========================================================================
    match /sindicacion_inmuebles/{docId} {

      function documentoCoherente() {
        return incoming().id is string
          && incoming().id == incoming().externalId
          && incoming().externalId.matches('^(idealista|fotocasa|habitaclia|kyero)_[0-9a-z]+$')
          && incoming().inmuebleId is string
          && incoming().inmuebleId.size() > 0
          && (incoming().portal in ['IDEALISTA', 'FOTOCASA', 'HABITACLIA', 'KYERO'])
          && (incoming().estado in ['BORRADOR', 'VALIDADO', 'LISTO_PARA_PUBLICAR', 'PUBLICADO', 'ACTUALIZADO', 'DESPUBLICADO', 'ERROR'])
          && (incoming().ultimaOperacion in ['inicializar', 'validar', 'publicar', 'actualizar', 'retirar', 'consultarEstado', 'sin_envio'])
          && (incoming().ultimoResultado in ['OK', 'ERROR', 'BLOQUEADO', 'SIN_CAMBIOS', 'RECHAZADO'])
          && incoming().clave is string
          && incoming().clave.matches('^[A-Z][A-Z0-9_]*:.+$')
          // `clave` = `PORTAL:inmuebleId` ⇔ longitud del portal + 1 (dos puntos) +
          // longitud del inmueble. Es la forma más ajustada que las reglas permiten.
          && incoming().clave.size() == incoming().portal.size() + incoming().inmuebleId.size() + 1
          && incoming().propietarioId is string
          && incoming().propietarioId.size() > 0
          && incoming().esquema == 1
          && sinSecretosSindicacion();
      }

      // Quién escribe: la administración, o un propietario SOBRE UN INMUEBLE DE SU
      // CARTERA (`myInmuebleIds()` del espejo no falsificable `usuarios_auth/{uid}`).
      function actorPuedeEscribirEstado() {
        return isMasterAdmin()
          || (isPropietarioRole() && canReachInmuebleId(incoming().inmuebleId));
      }

      // `get`: por titularidad del documento o por inmueble asignado (mismo criterio
      // que `contratoVisible` en §2 — sólo válido en lectura de un documento).
      allow get: if isMasterAdmin()
        || (isPropietarioRole() && (resource.data.propietarioId == myPropId() || canReachInmuebleId(resource.data.inmuebleId)));
      // `list`: la ÚNICA condición demostrable para una consulta. El panel debe filtrar
      // por propietarioId (lo hace `listarEstadosSindicacionFirestore` cuando hay
      // contexto de propietario); sin ese filtro la consulta se deniega.
      allow list: if isMasterAdmin()
        || (isPropietarioRole() && resource.data.propietarioId == myPropId());

      allow create: if actorPuedeEscribirEstado()
        && isValidId(docId)
        && incoming().id == docId
        && incoming().externalId == docId
        && documentoCoherente();

      // Update = mismas restricciones que create + identidad estructural invariable:
      // nadie (tampoco un propietario) reasigna un estado a otro inmueble, otro portal
      // o otro propietario. Un documento secuestrado sólo lo arregla la administración.
      allow update: if actorPuedeEscribirEstado()
        && isValidId(docId)
        && request.resource.data.id == docId
        && documentoCoherente()
        && request.resource.data.id == existing().id
        && request.resource.data.externalId == existing().externalId
        && request.resource.data.clave == existing().clave
        && request.resource.data.inmuebleId == existing().inmuebleId
        && request.resource.data.portal == existing().portal
        && request.resource.data.propietarioId == existing().propietarioId;

      // Borrar el estado actual es una operación de mantenimiento (no la hace el
      // flujo ordinario: retirar no borra, deja `DESPUBLICADO` con su trazabilidad).
      allow delete: if isMasterAdmin();
    }

    // =========================================================================
    // DENEGACIÓN GLOBAL POR DEFECTO (cualquier colección no contemplada)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
