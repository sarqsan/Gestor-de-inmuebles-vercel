{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "test:bloque-b": "tsx scripts/test-bloque-b.ts",
    "test:bloque-c": "tsx scripts/test-bloque-c.ts",
    "test:bloque-e": "tsx scripts/test-bloque-e.ts",
    "test:bloque-5": "tsx scripts/test-bloque-5.ts",
    "test:bloque-7": "tsx scripts/test-bloque-7.ts",
    "test:bloque-8": "vitest run tests/bloque-8-migracion-historica.test.ts tests/migracion-dry-run-b4.test.ts tests/autorizacion-migracion-o7.test.ts tests/import-export-canonico.test.ts",
    "test:bloque-9": "vitest run src/experiencia/experiencia.test.ts src/experiencia/asistente.test.ts src/experiencia/consultasERP.test.ts src/experiencia/proveedorGemini.test.ts src/experiencia/limites.test.ts src/experiencia/progreso.test.ts src/experiencia/targets.test.ts src/components/experiencia/experiencia.ui.test.tsx src/components/experiencia/experiencia.f2.ui.test.tsx src/components/experiencia/experiencia.f3.ui.test.tsx src/components/experiencia/experiencia.f4.ui.test.tsx src/components/sections/centro-ayuda.b9.ui.test.tsx",
    "test:operaciones": "node --import tsx --test \"src/features/operaciones/tests/*.test.mjs\"",
    "test:patrimonial": "node --import tsx --test \"src/features/patrimonial/tests/*.test.mjs\"",
    "test:integracion": "npm run test:operaciones && npm run test:patrimonial",
    "test:emulador:operaciones": "node --import tsx --test src/features/operaciones/tests/emulator/operaciones.emulator.mjs",
    "auditoria:repositorio": "tsx scripts/guardia-a04-repositorio.mts",
    "auditoria:reglas:matriz": "tsx scripts/diagnostico-b12-list.mts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
