    "viejo": "\n    match /actas_otp/{otpId} {\n      function otpEsMio(d) {\n        return 'ownerId' in d && d.ownerId == myPropId();\n      }\n      function sinSecretoPlanoExcesivo() {\n        // No permitir almacenamiento de codigo en texto plano salvo temporal controlado.\n        // codigoPlainTemporal (solo canal MANUAL, entrega en persona por personal interno)\n        // se permite SOLO mientras el OTP sigue ACTIVO y sin usar, o si se envía null\n        // (limpieza obligatoria tras uso/expiración).\n        return !('codigo' in incoming() && incoming().codigo.size() > 0) // nunca campo 'codigo' plano\n          && !('plain' in incoming())\n          && (!('codigoPlainTemporal' in incoming())\n              || incoming().codigoPlainTemporal == null\n              || (incoming().estado == 'ACTIVO' && incoming().usado == false));\n      }\n      allow get: if isMasterAdmin() || (isPropietarioRole() && otpEsMio(existing()));\n      allow list: if isMasterAdmin() || (isPropietarioRole() && otpEsMio(resource.data));\n      allow create: if isMasterAdmin() || (\n        isPropietarioRole()\n        && 'ownerId' in incoming() && incoming().ownerId == myPropId()\n        && 'actaId' in incoming() && incoming().actaId is string\n        && 'firmaId' in incoming() && incoming().firmaId is string\n        && 'codigoHash' in incoming()\n      ) && sinSecretoPlanoExcesivo();\n      allow update: if isMasterAdmin() || (\n        isPropietarioRole()\n        && 'ownerId' in existing() && existing().ownerId == myPropId()\n        && 'ownerId' in incoming() && incoming().ownerId == myPropId()\n        && 'actaId' in incoming() && incoming().actaId == existing().actaId\n      ) && sinSecretoPlanoExcesivo();\n      allow delete: if isMasterAdmin();\n    }\n\n",
    "nuevo": "\n    match /actas_otp/{otpId} {\n      // H-07 — El OTP es material del SERVIDOR, no del navegador.\n      // ===========================================================\n      // Antes el cliente creaba el documento (con su hash), lo leía para mostrar\n      // el estado, lo actualizaba al fallar y podía fijar `estado`/`usado`. Con\n      // eso la \"validación\" era una decisión del propio interesado.\n      // Ahora: generación, entrega, intentos y consumo ocurren en las rutas\n      // /api/actas/otp/* con credencial de servicio (no pasan por reglas). El\n      // navegador NO crea, NO modifica, NO borra y NO puede listar hashes; sólo\n      // el master conserva lectura de diagnóstico.\n      allow get, list: if isMasterAdmin();\n      allow create, update, delete: if false;\n    }\n\n"
