rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // FASE 1.4 — SEGURIDAD DE FICHEROS
    // C-Security (2026-09-22, reformulado sobre la canónica; ver
    // docs/AUDITORIA-SEGURIDAD-STORAGE-DOCUMENTOS-2026-09-22.md):
    //   · `read` de los árboles internos separado en `get` (cuenta interna) y
    //     `list` (sólo administración): sin `list` no se pueden ENUMERAR los
    //     objetos de otro propietario. El cliente nunca usa listAll()/list().
    //   · `hasSafeObjectName()` en toda subida cuyo cliente sanea el nombre
    //     (`replace(/[^a-zA-Z0-9._-]/g, '_')`): último segmento acotado, sin
    //     segmentos vacíos ni `.`/`..`, longitud total <= 1024.
    //   · `update` (en Storage = SÓLO metadatos; una re-subida al mismo nombre
    //     se evalúa como `create`) cerrado en las rutas cuyo nombre es único
    //     por subida; conservado donde el flujo re-sube el mismo nombre
    //     (actas_pdfs) y en los bloques validados R3/E.
    // D3 (ORDEN 4 §7) — RESUELTOS R-1/R-2 sin custom claims (ver helpers
    // "D3 — ÁMBITO POR ESPEJO"): todo path con propietario (directo o
    // derivable) se valida contra `usuarios_auth/{uid}` + administración.
    // `internalUser()` solo queda en `inmuebles/.../list` (objetos públicos).
    // RESIDUALES (no resueltos aquí, decisión pendiente):
    //   · R-3 `isPdfOrImage()` acepta `application/octet-stream` (clientes
    //     que suben blobs sin tipo).
    //   · R-4 las downloadURL con token son enlaces de capacidad ajenos a las
    //     reglas.
    //   · R-5 `presupuestos/`, `trabajos/` y `profesionales/{id}/documentos/`
    //     existen en el cliente pero NO tienen bloque: caen en la denegación
    //     por defecto y el cliente degrada a data-URL (sin cambio: afectaría al
    //     módulo Operaciones).
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador principal por email verificado por Firebase.
    function isMasterAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'sarqsan2@gmail.com';
    }

    function internalUser() {
      return isMasterAdmin() || isSignedIn();
    }

    // =========================================================================
    // D3 — ÁMBITO POR ESPEJO (cierre R-1/R-2 SIN custom claims).
    // No existen custom claims en este sistema (sin firebase-admin ni backend
    // que firme `setCustomUserClaims`, y la fuente de verdad de gestión es
    // `gestiones_cartera`, no el token). Las reglas de Storage SÍ pueden leer
    // Firestore (`firestore.get`, ya usado en E.0), luego el ámbito se
    // resuelve contra el MISMO espejo canónico que Firestore
    // (`usuarios_auth/{uid}`, ruta fija = uid): titularidad (`propietarioId`)
    // + carteras (`carterasL`/`carterasE`, solo las escribe el master).
    // Revocación: el espejo se evalúa EN CADA petición — un acceso revocado
    // deniega de inmediato, sin ventana de token obsoleto (§12).
    // Administración (master o perfil ADMINISTRADOR en la ficha
    // autoritativa — el espejo nunca afirma ADMINISTRADOR) conserva la
    // operativa global, igual que `esAdminInmuebles()` en Firestore.
    // `get()` sobre un documento inexistente falla ⇒ deny (fail-closed).
    // =========================================================================
    function espejoExiste() {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/usuarios_auth/$(request.auth.uid));
    }
    function espejo() {
      return firestore.get(/databases/(default)/documents/usuarios_auth/$(request.auth.uid)).data;
    }
    function espejoActivo() {
      return espejoExiste() && espejo().estado == 'ACTIVO';
    }
    function adminStorage() {
      return isMasterAdmin() || (isSignedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.tipoPerfil == 'ADMINISTRADOR');
    }
    // Pertenencia a cartera como predicado (sin ternario: el subconjunto que
    // cubren los intérpretes de tests es `return`-puro; semántica idéntica).
    function enCarteraL(pid) {
      return espejoActivo() && !('gestionesPorPropietario' in espejo() && pid in espejo().gestionesPorPropietario) && 'carterasL' in espejo() && espejo().carterasL is list && pid in espejo().carterasL;
    }
    function enCarteraE(pid) {
      return espejoActivo() && !('gestionesPorPropietario' in espejo() && pid in espejo().gestionesPorPropietario) && 'carterasE' in espejo() && espejo().carterasE is list && pid in espejo().carterasE;
    }
    function pidMio(pid) {
      return espejoActivo() && 'propietarioId' in espejo() && espejo().propietarioId == pid;
    }
    // Lectura: titular, cartera L/E, administración.
    function ambitoPidLectura(pid) {
      return adminStorage() || pidMio(pid) || enCarteraL(pid) || enCarteraE(pid);
    }
    // Escritura: titular, cartera E, administración (L no escribe).
    function ambitoPidEscritura(pid) {
      return adminStorage() || pidMio(pid) || enCarteraE(pid);
    }
    // Borrado: titular y administración (el gestor no borra — coherencia D2).
    function ambitoPidBorrado(pid) {
      return adminStorage() || pidMio(pid);
    }
    function pidDeInmueble(inmuebleId) {
      return firestore.get(/databases/(default)/documents/inmuebles/$(inmuebleId)).data.propietarioId;
    }
    // Derivación inmueble → propietario. `adminStorage()` cortocircuita
    // primero: el admin opera también huérfanos (inmueble borrado); para el
    // resto, un eslabón roto falla ⇒ deny.
    // ROADMAP-03: delegación parcial = SOLO inmuebles listados en la relación
    // viva indexada (activa, aceptada, gestor = usuario del espejo). Nunca
    // se amplía al resto de la cartera del titular.
    function gestionIdx(pid) {
      return firestore.get(/databases/(default)/documents/gestiones_cartera/$(espejo().gestionesPorPropietario[pid])).data;
    }
    function parcialVigente(pid, inmuebleId, escritura) {
      return espejoActivo() && 'gestionesPorPropietario' in espejo()
        && pid in espejo().gestionesPorPropietario
        && gestionIdx(pid).propietarioId == pid
        && gestionIdx(pid).gestorUsuarioId == espejo().usuarioId
        && gestionIdx(pid).estado == 'ACTIVA'
        && gestionIdx(pid).resolucionInvitacion == 'ACEPTADA'
        // [] conserva el contrato de delegación de cartera completa; una
        // lista no vacía solo habilita inmuebles enumerados explícitamente.
        && (gestionIdx(pid).inmuebleIds.size() == 0 || inmuebleId in gestionIdx(pid).inmuebleIds)
        && (!escritura || (gestionIdx(pid).permiso == 'LECTURA_ESCRITURA' && gestionIdx(pid).responsableActual == 'GESTOR'));
    }
    function ambitoInmuebleLectura(inmuebleId) {
      return adminStorage() || (espejoActivo() && (ambitoPidLectura(pidDeInmueble(inmuebleId))
        || parcialVigente(pidDeInmueble(inmuebleId), inmuebleId, false)));
    }
    function ambitoInmuebleEscritura(inmuebleId) {
      return adminStorage() || (espejoActivo() && (ambitoPidEscritura(pidDeInmueble(inmuebleId))
        || parcialVigente(pidDeInmueble(inmuebleId), inmuebleId, true)));
    }
    function ambitoInmuebleBorrado(inmuebleId) {
      return adminStorage() || (espejoActivo() && ambitoPidBorrado(pidDeInmueble(inmuebleId)));
    }
    function pidDeIncidencia(incidenciaId) {
      return firestore.get(/databases/(default)/documents/incidencias/$(incidenciaId)).data.propietarioId;
    }
    function ambitoIncidenciaLectura(incidenciaId) {
      return adminStorage() || (espejoActivo() && ambitoPidLectura(pidDeIncidencia(incidenciaId)));
    }
    function ambitoIncidenciaEscritura(incidenciaId) {
      return adminStorage() || (espejoActivo() && ambitoPidEscritura(pidDeIncidencia(incidenciaId)));
    }
    function ambitoIncidenciaBorrado(incidenciaId) {
      return adminStorage() || (espejoActivo() && ambitoPidBorrado(pidDeIncidencia(incidenciaId)));
    }
    // Profesional asignado a la incidencia (coherente con Firestore: lee y
    // aporta evidencias de SU incidencia; no borra).
    function profesionalAsignadoA(incidenciaId) {
      return espejoActivo()
        && 'profesionalId' in espejo() && espejo().profesionalId != ''
        && 'profesionalAsignadoId' in firestore.get(/databases/(default)/documents/incidencias/$(incidenciaId)).data
        && firestore.get(/databases/(default)/documents/incidencias/$(incidenciaId)).data.profesionalAsignadoId == espejo().profesionalId;
    }
    function pidDeContrato(contratoId) {
      return firestore.get(/databases/(default)/documents/contratos_formalizacion/$(contratoId)).data.propietarioId;
    }
    function ambitoContratoLectura(contratoId) {
      return adminStorage() || (espejoActivo() && ambitoPidLectura(pidDeContrato(contratoId)));
    }
    function ambitoContratoEscritura(contratoId) {
      return adminStorage() || (espejoActivo() && ambitoPidEscritura(pidDeContrato(contratoId)));
    }
    function ambitoContratoBorrado(contratoId) {
      return adminStorage() || (espejoActivo() && ambitoPidBorrado(pidDeContrato(contratoId)));
    }
    function inmuebleDeSuministroAmbito(suministroId) {
      return firestore.get(/databases/(default)/documents/suministros/$(suministroId)).data.inmuebleId;
    }
    function ambitoSuministroLectura(suministroId) {
      return adminStorage() || (espejoActivo() && ambitoInmuebleLectura(inmuebleDeSuministroAmbito(suministroId)));
    }
    function ambitoSuministroEscritura(suministroId) {
      return adminStorage() || (espejoActivo() && ambitoInmuebleEscritura(inmuebleDeSuministroAmbito(suministroId)));
    }
    function ambitoSuministroBorrado(suministroId) {
      return adminStorage() || (espejoActivo() && ambitoInmuebleBorrado(inmuebleDeSuministroAmbito(suministroId)));
    }
    function candidatoDeSolicitudDoc(solicitudDocId) {
      return firestore.get(/databases/(default)/documents/solicitudes_documentacion/$(solicitudDocId)).data.candidatoId;
    }
    function inmuebleDeCandidato(candidatoId) {
      return firestore.get(/databases/(default)/documents/candidatos/$(candidatoId)).data.inmuebleId;
    }
    function ambitoSolicitudDoc(solicitudDocId) {
      return adminStorage() || (espejoActivo()
        && ambitoInmuebleLectura(inmuebleDeCandidato(candidatoDeSolicitudDoc(solicitudDocId))));
    }

    // =========================================================================
    // E.0. BLOQUE E — HELPERS DE AISLAMIENTO DEL INQUILINO (vía Firestore)
    // =========================================================================
    function existeUsuarioActual() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function isTenant() {
      return isSignedIn() && !isMasterAdmin() && existeUsuarioActual() &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.tipoPerfil == 'INQUILINO';
    }

    function tenantContratoIds() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.contratoIds;
    }

    function tenantVeContrato(contratoId) {
      return isTenant() && contratoId is string && contratoId in tenantContratoIds();
    }

    function existeIncidencia(incidenciaId) {
      return firestore.exists(/databases/(default)/documents/incidencias/$(incidenciaId));
    }

    function contratoDeIncidencia(incidenciaId) {
      return firestore.get(/databases/(default)/documents/incidencias/$(incidenciaId)).data.contratoId;
    }

    function existeSuministro(suministroId) {
      return firestore.exists(/databases/(default)/documents/suministros/$(suministroId));
    }

    function inmuebleDeSuministro(suministroId) {
      return firestore.get(/databases/(default)/documents/suministros/$(suministroId)).data.inmuebleId;
    }

    function existeInmueble(inmuebleId) {
      return firestore.exists(/databases/(default)/documents/inmuebles/$(inmuebleId));
    }

    function contratoActivoDeInmueble(inmuebleId) {
      return firestore.get(/databases/(default)/documents/inmuebles/$(inmuebleId)).data.contratoActivoId;
    }

    // El inquilino sube fotos de lectura si su contrato es el activo del inmueble.
    function tenantEnSuministroPorInmueble(suministroId) {
      return isTenant() && existeSuministro(suministroId) &&
        existeInmueble(inmuebleDeSuministro(suministroId)) &&
        tenantVeContrato(contratoActivoDeInmueble(inmuebleDeSuministro(suministroId)));
    }

    function existeLectura(lecturaId) {
      return firestore.exists(/databases/(default)/documents/lecturas_suministro/$(lecturaId));
    }

    function contratoDeLectura(lecturaId) {
      return firestore.get(/databases/(default)/documents/lecturas_suministro/$(lecturaId)).data.contratoId;
    }

    function esEvidenciaValida() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/(jpeg|jpg|png|webp)');
    }

    function isPdfOrImage() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/octet-stream')
        || request.resource.contentType.matches('image/.*');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Forma segura del NOMBRE DE OBJETO subido. `request.resource.name` es la
    // ruta completa (p. ej. `gastos_facturas/P1/G1/1700_factura.pdf`), por lo
    // que se valida: longitud total, ausencia de segmentos vacíos (`//`) y de
    // segmentos `.`/`..` (trayectos), y que el ÚLTIMO segmento (el fichero)
    // empiece por alfanumérico, use sólo `[A-Za-z0-9._-]`, no termine en `.`
    // y mida <= 255 caracteres. No se exige extensión: el tipo lo gobierna
    // `contentType` (isImage / isPdfOrImage / esEvidenciaValida), no el nombre.
    // Todos los clientes del repositorio sanean el nombre con
    // `replace(/[^a-zA-Z0-9._-]/g, '_')`, así que ninguna subida legítima cambia.
    function hasSafeObjectName() {
      return request.resource.name.size() <= 1024
        && !request.resource.name.matches('.*//.*')
        && !request.resource.name.matches('.*/[.]{1,2}/.*')
        && request.resource.name.matches('.*/([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,253}[A-Za-z0-9_-])');
    }

    // -------------------------------------------------------------------------
    // JUSTIFICANTES DE COBRO (datos económicos)
    // Ruta por propietario: cobros_justificantes/{propietarioId}/{cobroId}/{archivo}
    // Exige cuenta interna. Las URL de descarga con token que genera el SDK
    // funcionan como enlace de capacidad para el destinatario (quien lo recibe
    // puede abrirlo aunque no tenga sesión).
    // D3 (§7): RESUELTO sin custom claims — el segmento propietarioId se
    // valida contra el espejo vía `firestore.get` (ver helpers D3).
    // -------------------------------------------------------------------------
    match /cobros_justificantes/{propietarioId}/{cobroPeriodoId}/{fileName} {
      // D3 (§7): el segmento propietarioId se valida contra el espejo —
      // titular, cartera (L lee, E escribe) y administración. Conocer el
      // path ya no concede acceso transversal.
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage()
        && hasSafeObjectName();
      // Nombre único por subida (`Date.now()_…`): sin caso de uso de metadatos.
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // Ruta heredada anterior (sin carpeta de propietario): sólo lectura interna;
    // ya no se permiten nuevas subidas a este esquema.
    // D3 (§7): sin segmento de ámbito demostrable ⇒ fail-closed estricto
    // (master + administración). Migración histórica pendiente: mover los
    // objetos a la ruta con propietarioId.
    match /cobros_justificantes/{cobroPeriodoId}/{fileName} {
      allow get: if adminStorage();
      allow list: if isMasterAdmin();
      allow create, update: if false;
      allow delete: if adminStorage();
    }

    // -------------------------------------------------------------------------
    // FACTURAS / JUSTIFICANTES DE GASTOS (FASE 2.2 — datos económicos)
    // Ruta por propietario: gastos_facturas/{propietarioId}/{gastoId}/{archivo}
    // Cuenta interna; PDF o imagen; máximo 12 MB. Mismo ámbito por espejo
    // que los justificantes de cobro (D3 §7).
    // -------------------------------------------------------------------------
    match /gastos_facturas/{propietarioId}/{gastoId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // -------------------------------------------------------------------------
    // DOCUMENTOS APORTADOS POR LOS CANDIDATOS (portal público por token)
    // La SUBIDA (create) la realiza el candidato sin iniciar sesión (funnel de
    // captación). Antes el comodín `{allFiles=**}` admitía la subida anónima a
    // CUALQUIER profundidad y con cualquier nombre. Ahora:
    //   · el árbol completo (`{allFiles=**}`) conserva `get`/`delete` internos
    //     (ningún objeto ya existente deja de ser legible/borrable) pero NO
    //     admite `create`/`update`;
    //   · la subida anónima sólo se concede en la ruta plana
    //     `documentos_solicitados/{sol}/{fichero}` (la única que construye el
    //     cliente: `{itemId}_{ts}_{nombre}`), con nombre seguro, PDF/imagen y
    //     < 15 MB. El candidato no recibe URL de lectura; `list` sólo admin.
    // -------------------------------------------------------------------------
    match /documentos_solicitados/{solicitudDocId}/{allFiles=**} {
      // D3 (§7): solicitud → candidato → inmueble → propietario. La subida
      // anónima del plano queda intacta (funnel deliberado, §11).
      allow get: if ambitoSolicitudDoc(solicitudDocId);
      allow list: if isMasterAdmin();
      allow create, update: if false;
      allow delete: if ambitoSolicitudDoc(solicitudDocId);
    }

    match /documentos_solicitados/{solicitudDocId}/{fileName} {
      allow get: if ambitoSolicitudDoc(solicitudDocId);
      allow list: if isMasterAdmin();
      allow create: if request.resource.size < 15 * 1024 * 1024
        && isPdfOrImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoSolicitudDoc(solicitudDocId);
    }

    // -------------------------------------------------------------------------
    // IMÁGENES DE INMUEBLES (catálogo / listado público)
    // Lectura pública (los listados son públicos); escritura interna.
    // R3: el nivel público es SOLO el primer segmento (foto de catálogo
    // `inmuebles/{id}/{fichero}`); la subruta `inventario/` (evidencia
    // operativa interna: contenidos/estado del inmueble) es solo interna.
    // -------------------------------------------------------------------------
    match /inmuebles/{inmuebleId}/{fileName} {
      // Público SÓLO el `get` del objeto (lo que proyecta la ficha R3); el
      // listado de la carpeta del inmueble exige cuenta interna.
      // D3 (§7): la ESCRITURA (subir/borrar fotos conociendo el ID) queda
      // acotada al ámbito del inmueble. El `get: true` es público
      // deliberado (R3) y NO se toca (§11).
      allow get: if true;
      allow list: if internalUser();
      allow create: if ambitoInmuebleEscritura(inmuebleId)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      // Nombre único por subida (`{imageId}_…` con id aleatorio).
      allow update: if false;
      allow delete: if ambitoInmuebleBorrado(inmuebleId);
    }

    // R3 — ADJUNTOS DE INVENTARIO (documentación interna de trabajo).
    // Antes cubiertos por el comodín público; ahora lectura/escritura
    // interna. Las downloadURL con token ya emitidas siguen funcionando
    // como enlaces de capacidad para su tenedor legítimo.
    match /inmuebles/{inmuebleId}/inventario/{allFiles=**} {
      // D3 (§7): evidencia operativa interna — ámbito del inmueble.
      allow read: if ambitoInmuebleLectura(inmuebleId);
      allow create: if ambitoInmuebleEscritura(inmuebleId)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      allow update: if ambitoInmuebleEscritura(inmuebleId);
      allow delete: if ambitoInmuebleBorrado(inmuebleId);
    }

    // -------------------------------------------------------------------------
    // FOTOGRAFÍAS DE INSPECCIÓN DE RECOMERCIALIZACIÓN (FASE 3.2)
    // Ruta PRIVADA por propietario y expediente:
    //   recomercializacion_fotos/{propietarioId}/{expedienteId}/{archivo}
    // Son documentos internos de trabajo (estado aparente / desperfectos previos
    // a la nueva comercialización), por lo que NO son públicas como las del
    // catálogo. Sólo ámbito por espejo (D3 §7); imágenes; máximo 15 MB por archivo.
    // -------------------------------------------------------------------------
    match /recomercializacion_fotos/{propietarioId}/{expedienteId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // -------------------------------------------------------------------------
    // FOTOGRAFÍAS DE INCIDENCIAS (BLOQUE 4)
    // Ruta PRIVADA por propietario e incidencia:
    //   incidencias_fotos/{propietarioId}/{incidenciaId}/{archivo}
    // Documentos internos de trabajo (desperfectos/reparaciones); no públicos.
    // Sólo cuentas internas; imágenes; máximo 15 MB por archivo.
    // -------------------------------------------------------------------------
    match /incidencias_fotos/{propietarioId}/{incidenciaId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // -------------------------------------------------------------------------
    // DOCUMENTOS Y FOTOGRAFÍAS DE REFORMAS (CIRCUITO DE REFORMAS)
    // Rutas PRIVADAS por propietario y proyecto:
    //   reformas_documentos/{propietarioId}/{proyectoId}/{archivo}
    //   reformas_fotos/{propietarioId}/{proyectoId}/{archivo}
    // Documentación contractual, planos, presupuestos y certificados técnicos.
    // -------------------------------------------------------------------------
    match /reformas_documentos/{propietarioId}/{proyectoId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    match /reformas_fotos/{propietarioId}/{proyectoId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 20 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // ------------------------------------------------------------------------
    // FOTOGRAFÍAS Y PDFS DE ACTAS DE ENTRADA/SALIDA (BLOQUE D)
    // Ruta PRIVADA por propietario y acta:
    //   actas_fotos/{propietarioId}/{actaId}/{archivo}
    //   actas_pdfs/{propietarioId}/{actaId}/{archivo}
    // Documentos internos de trabajo (estado vivienda, inventario, firma).
    // Sólo cuentas internas; imágenes y PDFs; máximo 15-20 MB por archivo.
    // NO base64 en Firestore, referencia persistente Storage.
    // ------------------------------------------------------------------------
    match /actas_fotos/{propietarioId}/{actaId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 15 * 1024 * 1024
        && isImage()
        && hasSafeObjectName();
      allow update: if false;
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    match /actas_pdfs/{propietarioId}/{actaId}/{fileName} {
      // D3 (§7): ámbito por espejo (ver cobros_justificantes).
      allow get: if ambitoPidLectura(propietarioId);
      allow list: if isMasterAdmin();
      allow create: if ambitoPidEscritura(propietarioId)
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage()
        && hasSafeObjectName();
      // `handleGenerarPdf` re-sube el MISMO nombre
      // (`Acta_{tipo}_{fecha}_v{version}_{id8}.pdf`) al regenerar una versión:
      // se conserva `update` (acotado al ámbito de escritura) para no romper
      // ese flujo legítimo.
      allow update: if ambitoPidEscritura(propietarioId);
      allow delete: if ambitoPidBorrado(propietarioId);
    }

    // -------------------------------------------------------------------------
    // DENEGACIÓN POR DEFECTO PARA CUALQUIER OTRA RUTA
    // -------------------------------------------------------------------------

    // =========================================================================
    // E.1. BLOQUE E — EVIDENCIAS DE INCIDENCIAS (fotos/documentos del expediente)
    // El inquilino solo accede a las de incidencias de sus contratos.
    // Subida: PDF/imágenes, máx. 10 MB. Solo el personal borra.
    // =========================================================================
    match /incidencias/{incidenciaId}/{file=**} {
      // D3 (§7): el personal genérico (`!isTenant()`) se sustituye por el
      // ámbito de la incidencia (titular/cartera/admin) + profesional
      // asignado (lee y aporta; no borra). Rama tenant intacta.
      allow read: if ambitoIncidenciaLectura(incidenciaId) || profesionalAsignadoA(incidenciaId) ||
        (existeIncidencia(incidenciaId) && tenantVeContrato(contratoDeIncidencia(incidenciaId)));
      allow create, update: if esEvidenciaValida() && hasSafeObjectName() && (ambitoIncidenciaEscritura(incidenciaId)
        || profesionalAsignadoA(incidenciaId)
        || (existeIncidencia(incidenciaId) && tenantVeContrato(contratoDeIncidencia(incidenciaId))));
      allow delete: if ambitoIncidenciaBorrado(incidenciaId);
    }

    // =========================================================================
    // E.2. BLOQUE E — FOTOS DE LECTURAS DE CONTADOR
    // Ruta: suministros/{suministroId}/lecturas/{lecturaId}/{fichero}
    // La lectura se crea primero en Firestore (inmutable); la foto la referencia.
    // =========================================================================
    match /suministros/{suministroId}/lecturas/{lecturaId}/{file=**} {
      // D3 (§7): ámbito suministro → inmueble → propietario (+carteras,
      // +admin). Ramas tenant intactas.
      allow read: if ambitoSuministroLectura(suministroId) ||
        (existeLectura(lecturaId) && tenantVeContrato(contratoDeLectura(lecturaId)));
      // Subida ANTES de crear la lectura (inmutable): alcance vía contrato activo del inmueble.
      allow create, update: if esEvidenciaValida() && hasSafeObjectName() && (ambitoSuministroEscritura(suministroId) ||
        tenantEnSuministroPorInmueble(suministroId));
      allow delete: if ambitoSuministroBorrado(suministroId);
    }

    // =========================================================================
    // E.3. BLOQUE E — DOCUMENTOS DEL CONTRATO (PDF LAU, actas, anexos)
    // El inquilino solo lee los de sus contratos; solo el personal publica.
    // =========================================================================
    match /contratos/{contratoId}/{file=**} {
      // D3 (§7): ámbito contrato → propietario (+carteras, +admin). El
      // inquilino solo lee los de sus contratos; solo el ámbito publica.
      allow read: if ambitoContratoLectura(contratoId) || tenantVeContrato(contratoId);
      allow create, update: if ambitoContratoEscritura(contratoId);
      allow delete: if ambitoContratoBorrado(contratoId);
    }

    // =========================================================================
    // E.4. BLOQUE E — RECIBOS Y JUSTIFICANTES DE COBRO
    // Ruta: recibos/{contratoId}/{claveCobro}/{fichero}
    // =========================================================================
    match /recibos/{contratoId}/{claveCobro}/{file=**} {
      // D3 (§7): mismo ámbito que E.3 (contrato → propietario).
      allow read: if ambitoContratoLectura(contratoId) || tenantVeContrato(contratoId);
      allow create, update: if ambitoContratoEscritura(contratoId);
      allow delete: if ambitoContratoBorrado(contratoId);
    }

    // =========================================================================
    // R2 — EVIDENCIAS DE MOROSIDAD (adjuntos del expediente, BLOQUE C)
    // Ruta PRIVADA por propietario y expediente:
    //   morosidad_evidencias/{propietarioId}/{expedienteId}/{archivo}
    // Autorización espejo de Firestore §34 (`evidencias_morosidad`): SOLO la
    // administración maestra opera; el propietario/inquilino nunca leen
    // evidencias (el propietario solo ve el espejo recortado §37). Sin
    // segmentos validados contra Firestore: innecesario, el master ve todo.
    // Creación con `esEvidenciaValida()` (PDF/JPEG/PNG/WEBP, < 10 MB).
    // Append-only: sin update ni delete (igual que el metadato en §34).
    // Los metadatos (storagePath, nombre, MIME, tamaño) viven en Firestore;
    // el binario jamás viaja en base64 ni en localStorage.
    // =========================================================================
    match /morosidad_evidencias/{propietarioId}/{expedienteId}/{fileName} {
      allow read: if isMasterAdmin();
      allow create: if isMasterAdmin() && esEvidenciaValida();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
