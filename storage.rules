rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // AG-03.2 (2026-10-20) — CUSTODIA DOCUMENTAL AUTORIZADA EN EL SERVIDOR
    // =========================================================================
    // Por qué estas reglas NO consultan Firestore:
    //   La aplicación opera ÚNICAMENTE sobre una base Firestore CON NOMBRE
    //   (`firestoreDatabaseId` de firebase-applet-config.json). Las reglas de
    //   Cloud Storage sólo pueden leer la base `(default)` del proyecto
    //   (documentación «Storage Security Rules › Enhance with Cloud Firestore»),
    //   que NO forma parte de la arquitectura: cualquier `firestore.get/exists`
    //   aquí se evaluaría contra una base vacía y denegaría a toda cuenta que no
    //   fuese la maestra. Por eso este fichero no contiene NINGUNA referencia a
    //   `/databases/…` ni a correos de administración.
    //
    // Dónde se autoriza ahora cada operación (misma matriz D3, por ruta):
    //   server/documentos/autorizacionDocumental.ts  — destinos, ámbitos
    //     (titular, carteras L/E, parcial vigente, inquilino, profesional,
    //     administración por ficha, master por identidad verificada) y estados
    //     P3/P5 de los metadatos, leídos en la base CON NOMBRE en cada petición.
    //   server/documentos/servicioDocumentos.ts      — subida (sesión reanudable
    //     con nombre, tipo y metadatos fijados por el servidor; confirmación con
    //     tamaño/tipo reales; retirada del objeto si no respeta el destino),
    //     acceso (URL con token, rotado en P3/P5) y borrado.
    //   server/documentos/rutasDocumentos.ts         — /api/documentos/*.
    // El navegador NO usa el SDK de Storage: envía los bytes directamente a la
    // sesión reanudable que abrió el servidor y lee por la URL con token que
    // éste emite tras autorizar. La cuenta de servicio del servidor no está
    // sujeta a estas reglas; por eso TODO lo que no sea la foto pública del
    // catálogo queda denegado para cualquier credencial de usuario, anónima o no.
    //
    // Historial (conservado en docs/, no aquí): FASE 1.4, C-Security 2026-09-22,
    // D3 ORDEN 4 §7, R3 catálogo público, bloques E (contratos/recibos),
    // P3/P5 (documentos patrimoniales/profesionales), ORDEN 1 (AG-04).
    // =========================================================================

    // -------------------------------------------------------------------------
    // IMÁGENES DE INMUEBLES (catálogo / listado público)
    // R3: el nivel público es SOLO el `get` del primer segmento
    // (`inmuebles/{id}/{fichero}`, lo que proyecta la ficha pública). La
    // subida/borrado de fotos y las subrutas `inventario/` y
    // `documentos_patrimoniales/` se autorizan en el servidor.
    // -------------------------------------------------------------------------
    match /inmuebles/{inmuebleId}/{fileName} {
      // Público deliberado (R3): sólo el `get` del objeto; nunca el listado.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // TODO LO DEMÁS: denegado para credenciales de usuario (con o sin sesión).
    // Incluye cobros_justificantes/, gastos_facturas/, documentos_solicitados/,
    // inmuebles/{id}/inventario/, inmuebles/{id}/documentos_patrimoniales/,
    // profesionales/, recomercializacion_fotos/, incidencias_fotos/,
    // reformas_documentos/, reformas_fotos/, actas_fotos/, actas_pdfs/,
    // incidencias/, suministros/, contratos/, recibos/, morosidad_evidencias/,
    // y las rutas sin bloque (presupuestos/, trabajos/).
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
