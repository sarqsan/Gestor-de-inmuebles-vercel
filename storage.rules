rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // FASE 1.4 — SEGURIDAD DE FICHEROS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador principal por email verificado por Firebase.
    function isMasterAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'sarqsan2@gmail.com';
    }

    function internalUser() {
      return isMasterAdmin() || isSignedIn();
    }

    function isPdfOrImage() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/octet-stream')
        || request.resource.contentType.matches('image/.*');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // -------------------------------------------------------------------------
    // JUSTIFICANTES DE COBRO (datos económicos)
    // Ruta por propietario: cobros_justificantes/{propietarioId}/{cobroId}/{archivo}
    // Exige cuenta interna. Las URL de descarga con token que genera el SDK
    // funcionan como enlace de capacidad para el destinatario (quien lo recibe
    // puede abrirlo aunque no tenga sesión).
    // RESIDUAL: sin custom claims, Storage no puede leer Firestore para comparar
    // el segmento propietarioId con el usuario; se exige cuenta interna y el
    // aislamiento fino por propietario queda para cuando se emitan claims.
    // -------------------------------------------------------------------------
    match /cobros_justificantes/{propietarioId}/{cobroPeriodoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // Ruta heredada anterior (sin carpeta de propietario): sólo lectura interna;
    // ya no se permiten nuevas subidas a este esquema.
    match /cobros_justificantes/{cobroPeriodoId}/{fileName} {
      allow read: if internalUser();
      allow create, update: if false;
      allow delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // FACTURAS / JUSTIFICANTES DE GASTOS (FASE 2.2 — datos económicos)
    // Ruta por propietario: gastos_facturas/{propietarioId}/{gastoId}/{archivo}
    // Cuenta interna; PDF o imagen; máximo 12 MB. Mismo residual de aislamiento
    // fino que los justificantes de cobro (pendiente de custom claims).
    // -------------------------------------------------------------------------
    match /gastos_facturas/{propietarioId}/{gastoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // DOCUMENTOS APORTADOS POR LOS CANDIDATOS (portal público por token)
    // La SUBIDA (create) la realiza el candidato sin iniciar sesión (funnel de
    // captación), por lo que se permite anónimo con límite de tipo y tamaño;
    // lectura/modificación/borrado quedan reservados a usuarios internos.
    // -------------------------------------------------------------------------
    match /documentos_solicitados/{solicitudDocId}/{allFiles=**} {
      allow read: if internalUser();
      allow create: if request.resource.size < 15 * 1024 * 1024 && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // IMÁGENES DE INMUEBLES (catálogo / listado público)
    // Lectura pública (los listados son públicos); escritura interna.
    // -------------------------------------------------------------------------
    match /inmuebles/{inmuebleId}/{allFiles=**} {
      allow read: if true;
      allow create: if internalUser()
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // FOTOGRAFÍAS DE INSPECCIÓN DE RECOMERCIALIZACIÓN (FASE 3.2)
    // Ruta PRIVADA por propietario y expediente:
    //   recomercializacion_fotos/{propietarioId}/{expedienteId}/{archivo}
    // Son documentos internos de trabajo (estado aparente / desperfectos previos
    // a la nueva comercialización), por lo que NO son públicas como las del
    // catálogo. Sólo cuentas internas; imágenes; máximo 15 MB por archivo.
    // RESIDUAL: sin custom claims, el aislamiento fino por propietario queda
    // pendiente de emitir claims (igual que justificantes y facturas).
    // -------------------------------------------------------------------------
    match /recomercializacion_fotos/{propietarioId}/{expedienteId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // FOTOGRAFÍAS DE INCIDENCIAS (BLOQUE 4)
    // Ruta PRIVADA por propietario e incidencia:
    //   incidencias_fotos/{propietarioId}/{incidenciaId}/{archivo}
    // Documentos internos de trabajo (desperfectos/reparaciones); no públicos.
    // Sólo cuentas internas; imágenes; máximo 15 MB por archivo.
    // -------------------------------------------------------------------------
    match /incidencias_fotos/{propietarioId}/{incidenciaId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // DENEGACIÓN POR DEFECTO PARA CUALQUIER OTRA RUTA
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
