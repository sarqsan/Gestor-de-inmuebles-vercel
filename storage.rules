rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // FASE 1.4 — SEGURIDAD DE FICHEROS (revisión ORDEN 10)
    // =========================================================================
    // ALCANCE REAL DE ESTAS REGLAS (limitación técnica, no decisión de diseño):
    //  - Las Security Rules de Storage NO pueden leer Firestore ni comprobar el
    //    rol del usuario: sólo ven `request.auth` (uid/email) y la ruta. Sin
    //    CUSTOM CLAIMS emitidos por servidor no existe forma de comparar el
    //    segmento {propietarioId} de la ruta con el propietario del usuario, por
    //    lo que el aislamiento fino por propietario y la exclusión del rol
    //    profesional NO pueden expresarse aquí.
    //  - Consecuencia declarada: las carpetas con {propietarioId} exigen cuenta
    //    interna (`internalUser()`), de modo que el aislamiento efectivo de esos
    //    ficheros depende de (a) la autorización de la aplicación y (b) las
    //    reglas de Firestore, que sí identifican rol y titularidad. Queda
    //    PENDIENTE (fuera del alcance de este circuito, requiere emisión de
    //    claims desde servidor) cerrarlo a nivel de Storage.
    //  - Superficie sin sesión: exactamente dos rutas, las que sostienen los
    //    flujos públicos: lectura de imágenes de `inmuebles/**` (galería
    //    pública) y SUBIDA de documentación en `documentos_solicitados/**`
    //    (portal de documentación por token, limitada a PDF/imagen < 15 MB).
    //    Todo lo demás es interno o está denegado por la regla final catch-all.
    //  - Estas reglas NO se han desplegado ni ejecutado desde este entorno
    //    (sin emulador/credenciales): la verificación es estática sobre el
    //    texto de las reglas.
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador principal por email verificado por Firebase.
    function isMasterAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'sarqsan2@gmail.com';
    }

    function internalUser() {
      return isMasterAdmin() || isSignedIn();
    }

    function isPdfOrImage() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/octet-stream')
        || request.resource.contentType.matches('image/.*');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // -------------------------------------------------------------------------
    // JUSTIFICANTES DE COBRO (datos económicos)
    // Ruta por propietario: cobros_justificantes/{propietarioId}/{cobroId}/{archivo}
    // Exige cuenta interna. Las URL de descarga con token que genera el SDK
    // funcionan como enlace de capacidad para el destinatario (quien lo recibe
    // puede abrirlo aunque no tenga sesión).
    // RESIDUAL: sin custom claims, Storage no puede leer Firestore para comparar
    // el segmento propietarioId con el usuario; se exige cuenta interna y el
    // aislamiento fino por propietario queda para cuando se emitan claims.
    // -------------------------------------------------------------------------
    match /cobros_justificantes/{propietarioId}/{cobroPeriodoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // Ruta heredada anterior (sin carpeta de propietario): sólo lectura interna;
    // ya no se permiten nuevas subidas a este esquema.
    match /cobros_justificantes/{cobroPeriodoId}/{fileName} {
      allow read: if internalUser();
      allow create, update: if false;
      allow delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // FACTURAS / JUSTIFICANTES DE GASTOS (FASE 2.2 — datos económicos)
    // Ruta por propietario: gastos_facturas/{propietarioId}/{gastoId}/{archivo}
    // Cuenta interna; PDF o imagen; máximo 12 MB. Mismo residual de aislamiento
    // fino que los justificantes de cobro (pendiente de custom claims).
    // -------------------------------------------------------------------------
    match /gastos_facturas/{propietarioId}/{gastoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 12 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // DOCUMENTOS APORTADOS POR LOS CANDIDATOS (portal público por token)
    // La SUBIDA (create) la realiza el candidato sin iniciar sesión (funnel de
    // captación), por lo que se permite anónimo con límite de tipo y tamaño;
    // lectura/modificación/borrado quedan reservados a usuarios internos.
    // -------------------------------------------------------------------------
    match /documentos_solicitados/{solicitudDocId}/{allFiles=**} {
      // La lectura es interna: el candidato sube, no descarga. La subida está
      // abierta por el flujo público por token, acotada a PDF/imagen < 15 MB y
      // sin posibilidad de sobrescribir (update exige cuenta interna).
      allow read: if internalUser();
      allow create: if request.resource.size < 15 * 1024 * 1024
        && isPdfOrImage()
        && solicitudDocId.size() >= 8
        && solicitudDocId.size() <= 128;
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // IMÁGENES DE INMUEBLES (catálogo / listado público)
    // Lectura pública (los listados son públicos); escritura interna.
    // -------------------------------------------------------------------------
    match /inmuebles/{inmuebleId}/{allFiles=**} {
      allow read: if true;
      allow create: if internalUser()
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // FOTOGRAFÍAS DE INSPECCIÓN DE RECOMERCIALIZACIÓN (FASE 3.2)
    // Ruta PRIVADA por propietario y expediente:
    //   recomercializacion_fotos/{propietarioId}/{expedienteId}/{archivo}
    // Son documentos internos de trabajo (estado aparente / desperfectos previos
    // a la nueva comercialización), por lo que NO son públicas como las del
    // catálogo. Sólo cuentas internas; imágenes; máximo 15 MB por archivo.
    // RESIDUAL: sin custom claims, el aislamiento fino por propietario queda
    // pendiente de emitir claims (igual que justificantes y facturas).
    // -------------------------------------------------------------------------
    match /recomercializacion_fotos/{propietarioId}/{expedienteId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // BLOQUE 4/5 — MANTENIMIENTO, INCIDENCIAS, SEGUROS Y TRABAJOS PROFESIONALES
    // Todas las rutas son PRIVADAS (documentación de trabajo del inmueble):
    //   incidencias/{propietarioId}/{incidenciaId}/{archivo}
    //   trabajos/{propietarioId}/{trabajoId}/{archivo}
    //   presupuestos/{propietarioId}/{presupuestoId}/{archivo}
    //   profesionales/{profesionalId}/{archivo}
    //   polizas/{propietarioId}/{polizaId}/{archivo}
    //   siniestros/{propietarioId}/{siniestroId}/{archivo}
    // Exigen cuenta interna, tipo (PDF/imagen/octet-stream) y tamaño máximo.
    // RESIDUAL (idéntico al de justificantes, facturas y fotos de inspección):
    // sin custom claims, Storage no puede comparar el segmento propietarioId
    // con el usuario; el aislamiento fino por propietario/profesional lo imponen
    // las Security Rules de Firestore y queda reforzado por claim cuando se
    // emitan. Las URL de descarga con token funcionan como enlace de capacidad.
    // -------------------------------------------------------------------------
    match /incidencias/{propietarioId}/{incidenciaId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    match /trabajos/{propietarioId}/{trabajoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    match /presupuestos/{propietarioId}/{presupuestoId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    match /profesionales/{profesionalId}/{allFiles=**} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    match /polizas/{propietarioId}/{polizaId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    match /siniestros/{propietarioId}/{siniestroId}/{fileName} {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.size < 20 * 1024 * 1024
        && isPdfOrImage();
      allow update, delete: if internalUser();
    }

    // -------------------------------------------------------------------------
    // DENEGACIÓN POR DEFECTO PARA CUALQUIER OTRA RUTA
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
